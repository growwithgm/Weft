{%- comment -%}
  Cart drawer (brief §7.13, S4): header with count and, for wholesale, "Ordering for" with a
  Change link; lines; summary with note, terms, checkout (disabled while a line breaks its rule),
  accelerated buttons for retail; empty states (promoted products for retail, catalogue and quick
  order links for wholesale); optional media promotion. Refreshed through the Cart API `sections`.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign wholesale = false
  if customer and customer.b2b?
    assign wholesale = true
  endif
  capture invalid_count
    render 'cart-invalid-count'
  endcapture
  assign invalid_count = invalid_count | strip | plus: 0
  assign show_promoted = false
  if s.promoted_visibility == 'always' and s.promoted_products.count > 0
    assign show_promoted = true
  elsif s.promoted_visibility == 'empty' and cart.item_count == 0 and s.promoted_products.count > 0
    assign show_promoted = true
  endif
  if wholesale
    assign show_promoted = false
  endif
  assign show_promo = false
  if s.promo_show
    if s.promo_visibility == 'always' or cart.item_count == 0
      assign show_promo = true
    endif
  endif
  assign multi_location = false
  if wholesale and customer.company_available_locations.size > 1
    assign multi_location = true
  endif
-%}
{{ 'component-cart.css' | asset_url | stylesheet_tag }}
<dialog id="CartDrawer" class="drawer drawer--end color-{{ settings.drawer_color_scheme }}" aria-labelledby="CartDrawerTitle" data-light-dismiss data-animate data-cart-section="{{ section.id }}" data-module="{{ 'cart.js' | asset_url }}" data-load="idle">
  <div class="drawer__panel cart-drawer{% if s.summary_position == 'top' %} cart-drawer--summary-top{% endif %}{% if s.sticky_footer %} cart-drawer--sticky{% endif %}" data-dialog-body>
    <div class="drawer__header cart-drawer__header">
      <div class="cart-drawer__heading">
        <h2 class="drawer__title h3" id="CartDrawerTitle">{%- if cart.item_count > 0 -%}{{ 'cart.title_count' | t: count: cart.item_count }}{%- else -%}{{ 'cart.title' | t }}{%- endif -%}</h2>
        {%- if wholesale -%}
          <p class="cart-drawer__company">
            {{ 'wholesale.ordering_for_location' | t: company: customer.current_company.name, location: customer.current_location.name }}
            {%- if multi_location %} <button type="button" class="link" data-open-dialog="LocationSheet">{{ 'wholesale.change' | t }}</button>{%- endif -%}
          </p>
        {%- endif -%}
      </div>
      <button type="button" class="icon-button" data-close-dialog aria-label="{{ 'general.close' | t }}">{%- render 'icon', name: 'close' -%}</button>
    </div>

    <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm" class="cart-drawer__form" data-cart-form novalidate>
      <div class="drawer__body cart-drawer__body">
        {%- if settings.cart_free_shipping_bar and wholesale == false and cart.item_count > 0 -%}
          {%- render 'free-shipping-bar' -%}
        {%- endif -%}
        {%- if cart.item_count == 0 -%}
          <div class="cart-empty stack">
            {%- if wholesale -%}
              <p class="cart-empty__title">{{ 'wholesale.empty_cart' | t }}</p>
              <a class="button button--secondary button--full" href="{{ settings.cart_empty_link | default: routes.all_products_collection_url }}">{{ 'wholesale.browse_catalogue' | t }}</a>
              {%- if settings.wholesale_quick_order_page != blank -%}<a class="link cart-empty__link" href="{{ settings.wholesale_quick_order_page.url }}">{{ 'wholesale.quick_order' | t }}</a>{%- endif -%}
            {%- else -%}
              <p class="cart-empty__title">{{ 'cart.empty' | t }}</p>
              <a class="button button--secondary button--full" href="{{ settings.cart_empty_link | default: routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
            {%- endif -%}
          </div>
        {%- else -%}
          <ul class="cart-lines" role="list">
            {%- for item in cart.items -%}
              {%- render 'cart-line', item: item, index: forloop.index, wholesale: wholesale, context: 'drawer', show_vendor: s.show_vendor, show_backorder: s.show_backorder_note -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if show_promoted -%}
          <div class="cart-promoted">
            <p class="cart-promoted__heading">{% if s.promoted_heading != blank %}{{ s.promoted_heading }}{% else %}{{ 'cart.you_might_like' | t }}{% endif %}</p>
            <ul class="cart-promoted__list cart-promoted__list--{{ s.promoted_layout }}" role="list">
              {%- for product in s.promoted_products limit: 6 -%}
                <li>{%- render 'product-card-mini', product: product -%}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if show_promo -%}
          <a class="cart-promo" href="{{ s.promo_link | default: '#' }}" style="--promo-min-h: {{ s.promo_min_height }}px; --promo-fg: {{ s.promo_text_color }}; --promo-tint: {{ s.promo_tint_color }}; --promo-tint-opacity: {{ s.promo_tint_opacity | divided_by: 100.0 }}">
            {%- if s.promo_image != blank -%}{{ s.promo_image | image_url: width: 800 | image_tag: widths: '400,600,800', sizes: '400px', loading: 'lazy', class: 'cart-promo__image' }}{%- endif -%}
            {%- if s.promo_content != blank or s.promo_button_label != blank -%}
              <span class="cart-promo__content cart-promo__content--{{ s.promo_text_align }}">
                {%- if s.promo_content != blank -%}<span class="rte">{{ s.promo_content }}</span>{%- endif -%}
                {%- if s.promo_button_label != blank -%}<span class="button button--{{ s.promo_button_style }} button--small">{{ s.promo_button_label }}</span>{%- endif -%}
              </span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>

      {%- if cart.item_count > 0 -%}
        <div class="drawer__footer cart-drawer__footer">
          {%- render 'cart-summary', wholesale: wholesale, invalid_count: invalid_count, form_id: 'CartDrawerForm', show_note: s.show_order_note, show_tax_note: s.show_tax_note, show_accelerated: s.show_accelerated, show_checkout: s.show_checkout, terms_page: s.terms_page, context: 'drawer' -%}
          {%- if s.show_view_cart -%}<a class="cart-drawer__view link" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </form>
  </div>
</dialog>

{% schema %}
{
  "name": "t:labels.cart_drawer",
  "class": "section-cart-drawer",
  "enabled_on": {
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_view_cart",
      "label": "t:labels.show_view_cart_link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:labels.show_vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_backorder_note",
      "label": "t:labels.show_backorder_note_on_lines",
      "default": true
    },
    {
      "type": "select",
      "id": "summary_position",
      "label": "t:labels.summary_position",
      "options": [
        {
          "value": "bottom",
          "label": "t:labels.bottom"
        },
        {
          "value": "top",
          "label": "t:labels.top"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "checkbox",
      "id": "sticky_footer",
      "label": "t:labels.keep_the_checkout_area_in_view",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "t:labels.show_order_note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tax_note",
      "label": "t:labels.show_tax_and_shipping_note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_accelerated",
      "label": "t:labels.show_accelerated_checkout_buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_checkout",
      "label": "t:labels.show_checkout_button",
      "default": true
    },
    {
      "type": "url",
      "id": "terms_page",
      "label": "t:labels.terms_and_conditions_page",
      "info": "t:labels.adds_a_required_checkbox"
    },
    {
      "type": "header",
      "content": "t:labels.shipping_calculator"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_calculator",
      "label": "t:labels.show_shipping_calculator",
      "default": false
    },
    {
      "type": "text",
      "id": "shipping_calculator_default_country",
      "label": "t:labels.default_country",
      "info": "t:text.sections.cart_drawer.settings.shipping_calculator_default_country.info"
    },
    {
      "type": "header",
      "content": "t:labels.promoted_products"
    },
    {
      "type": "select",
      "id": "promoted_visibility",
      "label": "t:labels.show",
      "options": [
        {
          "value": "empty",
          "label": "t:labels.when_the_cart_is_empty"
        },
        {
          "value": "always",
          "label": "t:labels.always"
        },
        {
          "value": "never",
          "label": "t:labels.never"
        }
      ],
      "default": "empty"
    },
    {
      "type": "text",
      "id": "promoted_heading",
      "label": "t:labels.heading"
    },
    {
      "type": "product_list",
      "id": "promoted_products",
      "label": "t:labels.products",
      "limit": 6
    },
    {
      "type": "select",
      "id": "promoted_layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "list",
          "label": "t:labels.list"
        },
        {
          "value": "grid",
          "label": "t:labels.grid"
        }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "t:labels.media_promotion"
    },
    {
      "type": "checkbox",
      "id": "promo_show",
      "label": "t:labels.show_media_promotion",
      "default": false
    },
    {
      "type": "select",
      "id": "promo_visibility",
      "label": "t:labels.show",
      "options": [
        {
          "value": "empty",
          "label": "t:labels.when_the_cart_is_empty"
        },
        {
          "value": "always",
          "label": "t:labels.always"
        }
      ],
      "default": "empty"
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "t:labels.image"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "t:labels.link"
    },
    {
      "type": "range",
      "id": "promo_min_height",
      "label": "t:labels.minimum_height",
      "min": 100,
      "max": 500,
      "step": 10,
      "default": 220,
      "unit": "px"
    },
    {
      "type": "richtext",
      "id": "promo_content",
      "label": "t:labels.text"
    },
    {
      "type": "select",
      "id": "promo_text_align",
      "label": "t:labels.text_position",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        },
        {
          "value": "end",
          "label": "t:labels.end"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "promo_button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "select",
      "id": "promo_button_style",
      "label": "t:labels.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:labels.primary"
        },
        {
          "value": "secondary",
          "label": "t:labels.secondary"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "color",
      "id": "promo_text_color",
      "label": "t:labels.text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "promo_tint_color",
      "label": "t:labels.image_overlay",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "promo_tint_opacity",
      "label": "t:labels.image_overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 20,
      "unit": "%"
    }
  ]
}
{% endschema %}
