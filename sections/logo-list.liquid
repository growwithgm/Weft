{%- comment -%}
  Logo list: brand or press logos in a grid, a carousel or a scrolling row.
{%- endcomment -%}
{%- assign s = section.settings -%}
{{ 'section-library.css' | asset_url | stylesheet_tag }}
<div class="section logo-list color-{{ s.color_scheme }}{% if section.index > 2 %} below-fold{% endif %}" data-reveal>
  <div class="page-width{% if s.full_width %} page-width--full{% endif %}">
    {%- render 'section-heading', title: s.title, align: s.heading_align, button_label: s.button_label, button_link: s.button_link, button_style: s.button_style -%}
    <scroll-row class="scroll-row scroll-row--{{ s.layout | default: 'grid' }}" data-module="{{ 'carousel.js' | asset_url }}" data-load="visible">
      <ul class="logos-row logo-list__list{% if s.layout == 'carousel' %} is-carousel{% endif %}" role="list" data-scroll-list style="--logo-gap: {{ s.spacing }}px; justify-content: {% if s.logo_align == 'center' %}center{% else %}flex-start{% endif %};">
        {%- content_for 'blocks' -%}
      </ul>
      {%- if s.layout == 'carousel' -%}
        <div class="scroll-row__buttons js-only">
          <button type="button" class="icon-button" data-scroll-prev aria-label="{{ 'general.previous' | t }}">{%- render 'icon', name: 'chevron-left', size: 20 -%}</button>
          <button type="button" class="icon-button" data-scroll-next aria-label="{{ 'general.next' | t }}">{%- render 'icon', name: 'chevron-right', size: 20 -%}</button>
        </div>
      {%- endif -%}
    </scroll-row>
  </div>
</div>

{% schema %}
{
  "name": "t:labels.logo_list",
  "class": "section-logo-list",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "max_blocks": 50,
  "blocks": [
    {
      "type": "_logo"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.heading",
      "default": "As seen in"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:labels.heading_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:labels.primary"
        },
        {
          "value": "secondary",
          "label": "t:labels.secondary"
        },
        {
          "value": "link",
          "label": "t:labels.link"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:labels.grid"
        },
        {
          "value": "carousel",
          "label": "t:labels.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "t:labels.space_between_logos",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "logo_align",
      "label": "t:labels.logo_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:labels.full_width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.logo_list",
      "category": "t:labels.media",
      "blocks": [
        {
          "type": "_logo"
        },
        {
          "type": "_logo"
        },
        {
          "type": "_logo"
        },
        {
          "type": "_logo"
        }
      ]
    }
  ]
}
{% endschema %}
