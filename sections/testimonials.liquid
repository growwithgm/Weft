{%- comment -%}
  Testimonials: up to five quotes with stars and authors, shown one at a time in <slide-show>
  (swipe without JavaScript; arrows, dots and optional autoplay with a pause button).
{%- endcomment -%}
{%- assign s = section.settings -%}
{{ 'section-library.css' | asset_url | stylesheet_tag }}
<div class="section testimonials testimonials--{{ s.size }} testimonials--{{ s.text_align }}{% if s.show_quotes %} testimonials--quotes{% endif %} color-{{ s.color_scheme }}{% if section.index > 2 %} below-fold{% endif %}" data-reveal>
  <div class="page-width{% if s.full_width %} page-width--full{% endif %}">
    {%- render 'section-heading', title: s.heading, align: s.text_align -%}
    <slide-show
      class="slideshow slideshow--{{ s.transition }} testimonials__slider"
      role="region"
      aria-roledescription="{{ 'accessibility.carousel' | t }}"
      aria-label="{{ s.heading | escape }}"
      data-transition="{{ s.transition }}"
      data-autoplay="{{ s.autoplay }}"
      data-speed="{{ s.autoplay_speed }}"
      data-pause-hover="{{ s.slider_pause }}"
      data-module="{{ 'carousel.js' | asset_url }}"
      data-load="visible"
    >
      <div class="slideshow__track" data-track aria-live="polite">{%- content_for 'blocks' -%}</div>
      {%- render 'slideshow-controls', count: section.blocks.size, nav: s.nav_style, autoplay: s.autoplay -%}
    </slide-show>
  </div>
</div>

{% schema %}
{
  "name": "t:labels.testimonials",
  "class": "section-testimonials",
  "max_blocks": 5,
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "blocks": [
    {
      "type": "_testimonial"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What our customers say"
    },
    {
      "type": "checkbox",
      "id": "show_quotes",
      "label": "t:labels.show_quotation_marks",
      "default": true
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:labels.text_size",
      "options": [
        {
          "value": "medium",
          "label": "t:labels.medium"
        },
        {
          "value": "large",
          "label": "t:labels.large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:labels.text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "nav_style",
      "label": "t:labels.navigation",
      "options": [
        {
          "value": "dots",
          "label": "t:labels.dots"
        },
        {
          "value": "arrows",
          "label": "t:labels.arrows"
        },
        {
          "value": "both",
          "label": "t:labels.dots_and_arrows"
        }
      ],
      "default": "dots"
    },
    {
      "type": "select",
      "id": "transition",
      "label": "t:labels.transition",
      "options": [
        {
          "value": "slide",
          "label": "t:labels.slide"
        },
        {
          "value": "fade",
          "label": "t:labels.fade"
        }
      ],
      "default": "fade"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:labels.change_testimonials_automatically",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "slider_pause",
      "label": "t:labels.pause_on_hover",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:labels.change_every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:labels.full_width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.testimonials",
      "category": "t:labels.text",
      "blocks": [
        {
          "type": "_testimonial"
        },
        {
          "type": "_testimonial"
        },
        {
          "type": "_testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
