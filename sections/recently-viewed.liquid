{%- comment -%} Recently viewed products (handles in localStorage; cards rendered by the store, so wholesale buyers see their prices). {%- endcomment -%}
{%- assign s = section.settings -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-carousel.css' | asset_url | stylesheet_tag }}
<div class="section product-rows color-{{ s.color_scheme }} below-fold" data-recently-viewed data-limit="{{ s.limit }}" data-exclude="{{ product.handle }}" data-root="{{ routes.root_url }}" data-module="{{ 'recently-viewed.js' | asset_url }}" data-load="visible" hidden>
  <div class="page-width">
    <div class="section-heading section-heading--{{ s.heading_align }}">
      <h2 class="h2">{% if s.heading != blank %}{{ s.heading }}{% else %}{{ 'products.recommendations.recently_viewed' | t }}{% endif %}</h2>
    </div>
    <scroll-row class="scroll-row scroll-row--{{ s.layout }}" data-module="{{ 'carousel.js' | asset_url }}" data-load="visible">
      <ul class="product-grid product-grid--{{ s.layout }}" role="list" data-scroll-list style="--cols: {{ s.columns }}; --cols-mobile: {{ s.columns_mobile }}" data-recently-viewed-list></ul>
      {%- if s.layout == 'carousel' -%}
        <div class="scroll-row__buttons js-only">
          <button type="button" class="icon-button" data-scroll-prev aria-label="{{ 'general.previous' | t }}">{%- render 'icon', name: 'chevron-left', size: 20 -%}</button>
          <button type="button" class="icon-button" data-scroll-next aria-label="{{ 'general.next' | t }}">{%- render 'icon', name: 'chevron-right', size: 20 -%}</button>
        </div>
        {%- endif -%}
    </scroll-row>
  </div>
</div>

{% schema %}
{
  "name": "t:labels.recently_viewed",
  "class": "section-recently-viewed",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.leave_empty_for_recently_viewed"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:labels.heading_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "carousel",
          "label": "t:labels.carousel"
        },
        {
          "value": "grid",
          "label": "t:labels.grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:labels.maximum_products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.products_per_row_on_large_screens",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.products_per_row_on_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:labels.1"
        },
        {
          "value": "2",
          "label": "t:labels.2"
        }
      ],
      "default": "2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.recently_viewed",
      "category": "t:labels.products"
    }
  ]
}
{% endschema %}
