{%- liquid
  assign s = section.settings
-%}
<div class="section rich-text color-{{ s.color_scheme }}{% if s.color_scheme != 'scheme-1' %} rich-text--padded{% endif %}{% if section.index > 2 %} below-fold{% endif %}" data-reveal>
  <div class="page-width{% if s.full_width == false %} page-width--narrow{% endif %}">
    <div class="rich-text__content rich-text__content--{{ s.content_position }} text-{{ s.text_align }}{% if s.mobile_center %} rich-text__content--mobile-center{% endif %} stack">
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:labels.rich_text",
  "class": "section-rich-text",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "content_position",
      "label": "t:labels.content_position",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        },
        {
          "value": "end",
          "label": "t:labels.end"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:labels.text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        },
        {
          "value": "end",
          "label": "t:labels.end"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "mobile_center",
      "label": "t:labels.center_text_on_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:labels.wide_content",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.rich_text",
      "category": "t:labels.text",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "Talk about your brand",
            "size": "h1"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Share the story behind your products, how they are made and what makes them different.</p>"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Learn more",
            "style": "secondary"
          }
        }
      ]
    }
  ]
}
{% endschema %}
