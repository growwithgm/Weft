{%- comment -%}
  Collection products (brief §14.3, S6): toolbar with product count, sorting and grid/list
  toggle; Storefront filtering in a sticky side column on large screens and a drawer on small
  ones (same form, moved by facets.js, so there is one copy in the DOM); active filter chips;
  product grid with promotion tiles at chosen positions; pagination or "Load more".
  Wholesale buyers see wholesale cards; tag-fallback wholesale-only products render nothing for
  retail, so the grid never has empty cells.
  Without JavaScript the filter form submits normally and pagination links work.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign form_id = 'FacetsForm-' | append: section.id
  assign drawer_id = 'FacetsDrawer-' | append: section.id
  assign sort_value = collection.sort_by | default: collection.default_sort_by
  assign clear_url = collection.url | append: '?sort_by=' | append: sort_value
  assign filtering = false
  if s.enable_filtering and collection.filters.size > 0
    assign filtering = true
  endif
  assign any_active = false
  for filter in collection.filters
    if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
      assign any_active = true
      break
    endif
  endfor
  assign sidebar = false
  if filtering and s.filters_open_lg
    assign sidebar = true
  endif
-%}
<collection-results
  class="section collection color-{{ s.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-module="{{ 'facets.js' | asset_url }}"
  data-load="idle"
>
  <div class="page-width">
    {%- paginate collection.products by s.products_per_page -%}
      <div class="collection__toolbar">
        {%- if filtering -%}
          <button type="button" class="button button--secondary collection__filter-toggle{% if sidebar %} collection__filter-toggle--small{% endif %} js-only" data-open-dialog="{{ drawer_id }}" aria-haspopup="dialog">
            {%- render 'icon', name: 'filter', size: 18 -%}
            <span>{{ 'collections.filter_and_sort' | t }}</span>
          </button>
        {%- endif -%}
        <p class="collection__count muted" data-product-count>{{ 'collections.product_count' | t: count: collection.products_count }}</p>
        {%- if s.enable_sorting -%}
          <div class="collection__sort">
            <label class="collection__sort-label" for="SortBy-{{ section.id }}">{{ 'collections.sort_by' | t }}</label>
            <select class="select collection__sort-select" id="SortBy-{{ section.id }}" name="sort_by" form="{{ form_id }}" data-facets-sort>
              {%- for option in collection.sort_options -%}
                {%- liquid
                  assign show_option = true
                  case option.value
                    when 'manual'
                      assign show_option = s.sort_show_featured
                    when 'best-selling'
                      assign show_option = s.sort_show_best
                    when 'title-ascending', 'title-descending'
                      assign show_option = s.sort_show_alpha
                    when 'price-ascending', 'price-descending'
                      assign show_option = s.sort_show_price
                    when 'created-ascending', 'created-descending'
                      assign show_option = s.sort_show_date
                  endcase
                  if option.value == sort_value
                    assign show_option = true
                  endif
                -%}
                {%- if show_option -%}
                  <option value="{{ option.value | escape }}"{% if option.value == sort_value %} selected{% endif %}>{{ option.name | escape }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </div>
          {%- unless filtering -%}
            <form id="{{ form_id }}" action="{{ collection.url }}" method="get" data-facets-form hidden></form>
            <noscript><button type="submit" form="{{ form_id }}" class="button button--secondary">{{ 'collections.apply' | t }}</button></noscript>
          {%- endunless -%}
        {%- endif -%}
        {%- if s.show_layout_toggle -%}
          <div class="collection__layout-toggle js-only" role="group" aria-label="{{ 'collections.layout' | t }}">
            <button type="button" class="icon-button" data-layout-option="grid" aria-pressed="true" aria-label="{{ 'collections.layout_grid' | t }}">{%- render 'icon', name: 'grid', size: 20 -%}</button>
            <button type="button" class="icon-button" data-layout-option="list" aria-pressed="false" aria-label="{{ 'collections.layout_list' | t }}">{%- render 'icon', name: 'list', size: 20 -%}</button>
          </div>
        {%- endif -%}
      </div>

      <div class="collection__layout{% if sidebar %} collection__layout--sidebar{% endif %}{% if s.stick_on_scroll %} collection__layout--sticky{% endif %}">
        {%- if filtering -%}
          <aside class="collection__facets{% unless sidebar %} collection__facets--drawer-only{% endunless %}" aria-label="{{ 'collections.filters' | t }}" data-facets-home>
            {%- render 'facets', results: collection, form_id: form_id, clear_url: clear_url, show_counts: s.show_filter_counts, expand: s.expand_filters, max_options: s.max_filter_options -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'promo_filter' -%}{%- render 'collection-promo', block: block, sizes: '300px' -%}{%- endif -%}
            {%- endfor -%}
          </aside>
        {%- endif -%}

        <div class="collection__results" data-facets-results aria-live="polite">
          {%- render 'facets-active', results: collection, clear_url: clear_url -%}
          {%- if collection.products.size > 0 -%}
            {%- liquid
              assign card_sizes = '(min-width: 990px) calc(100vw / ' | append: s.columns | append: '), (min-width: 750px) 33vw, 50vw'
              if s.columns_mobile == '1'
                assign card_sizes = '(min-width: 990px) calc(100vw / ' | append: s.columns | append: '), (min-width: 750px) 33vw, 100vw'
              endif
            -%}
            <ul
              class="product-grid collection__grid"
              id="ProductGrid-{{ section.id }}"
              role="list"
              data-product-grid
              data-layout="grid"
              style="--cols: {{ s.columns }}; --cols-mobile: {{ s.columns_mobile }}"
            >
              {%- for product in collection.products -%}
                {%- assign product_index = forloop.index -%}
                {%- if paginate.current_page == 1 -%}
                  {%- for block in section.blocks -%}
                    {%- liquid
                      assign show_promo = false
                      if block.type != 'promo_filter' and block.settings.position == product_index
                        assign show_promo = true
                        if block.settings.hide_on_filter and any_active
                          assign show_promo = false
                        endif
                      endif
                    -%}
                    {%- if show_promo -%}
                      <li class="collection__promo collection__promo--{{ block.type | remove: 'promo_' }}{% if block.settings.span == '2' %} collection__promo--span{% endif %}">
                        {%- render 'collection-promo', block: block, sizes: card_sizes -%}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- liquid
                  assign eager = false
                  if paginate.current_page == 1 and product_index <= 2
                    assign eager = true
                  endif
                -%}
                {%- render 'product-card', product: product, wrapper: 'li', index: product_index, sizes: card_sizes, eager: eager, highlight: true, collection: collection -%}
              {%- endfor -%}
            </ul>
          {%- else -%}
            <div class="collection__empty stack">
              <p class="h4">{{ 'collections.empty' | t }}</p>
              {%- if any_active -%}<a class="link" href="{{ clear_url }}" data-facet-link>{{ 'collections.clear_all' | t }}</a>{%- endif -%}
            </div>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            {%- if s.pagination_type == 'load_more' -%}
              {%- assign shown = paginate.current_offset | plus: collection.products.size -%}
              <div class="collection__load-more" data-load-more-wrap>
                <p class="muted collection__shown">{{ 'collections.showing' | t: shown: shown, total: collection.products_count }}</p>
                {%- if paginate.next -%}
                  <a class="button button--secondary" href="{{ paginate.next.url }}" data-load-more>{{ 'general.pagination.load_more' | t }}</a>
                {%- endif -%}
              </div>
            {%- else -%}
              {%- render 'pagination', paginate: paginate -%}
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>

      {%- if filtering -%}
        <dialog id="{{ drawer_id }}" class="drawer drawer--start facets-drawer" aria-label="{{ 'collections.filter_and_sort' | t }}" data-light-dismiss data-animate>
          <div class="drawer__panel">
            <div class="drawer__header">
              <span class="drawer__title h3">{{ 'collections.filter_and_sort' | t }}</span>
              <button type="button" class="icon-button" data-close-dialog aria-label="{{ 'general.close' | t }}">{%- render 'icon', name: 'close' -%}</button>
            </div>
            <div class="drawer__body facets-drawer__body" data-facets-slot></div>
            <div class="drawer__footer facets-drawer__footer">
              <a class="link" href="{{ clear_url }}" data-facet-link>{{ 'collections.clear_all' | t }}</a>
              <button type="button" class="button" data-close-dialog data-facets-show>{{ 'collections.show_results' | t: count: collection.products_count }}</button>
            </div>
          </div>
        </dialog>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</collection-results>

