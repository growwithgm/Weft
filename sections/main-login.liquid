{%- comment -%} Classic customer accounts: sign in, password recovery (shown with #recover) and guest checkout. New customer accounts are the default; this template only serves stores that still use classic accounts. {%- endcomment -%}
{{ 'section-content.css' | asset_url | stylesheet_tag }}
<div class="section account color-{{ section.settings.color_scheme }}">
  <div class="page-width account__narrow stack">
    <div class="account__recover" id="recover" tabindex="-1">
      <h1 class="h2">{{ 'customer.recover.title' | t }}</h1>
      <p>{{ 'customer.recover.text' | t }}</p>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{%- render 'icon', name: 'check', size: 18 -%}{{ 'customer.recover.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>{%- render 'icon', name: 'alert', size: 18 -%}<span>{{ form.errors | default_errors }}</span></div>
      {%- endif -%}
        <div class="field">
          <label class="field__label" for="RecoverEmail">{{ 'contact.email' | t }}</label>
          <input class="input" type="email" id="RecoverEmail" name="email" autocomplete="email" autocapitalize="off" spellcheck="false" required>
        </div>
        <div class="cluster">
          <button type="submit" class="button">{{ 'customer.recover.submit' | t }}</button>
          <a class="link" href="#login">{{ 'customer.recover.cancel' | t }}</a>
        </div>
      {%- endform -%}
    </div>
    <div class="account__login" id="login">
      <h1 class="h2">{{ 'customer.login.title' | t }}</h1>
      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>{%- render 'icon', name: 'alert', size: 18 -%}<span>{{ form.errors | default_errors }}</span></div>
      {%- endif -%}
        <div class="field">
          <label class="field__label" for="LoginEmail">{{ 'contact.email' | t }}</label>
          <input class="input" type="email" id="LoginEmail" name="customer[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required>
        </div>
        {%- if form.password_needed -%}
          <div class="field">
            <label class="field__label" for="LoginPassword">{{ 'customer.password' | t }}</label>
            <input class="input" type="password" id="LoginPassword" name="customer[password]" autocomplete="current-password" required>
          </div>
          <a class="link account__forgot" href="#recover">{{ 'customer.login.forgot' | t }}</a>
        {%- endif -%}
        <button type="submit" class="button button--full">{{ 'customer.login.submit' | t }}</button>
        <p class="account__alt">{{ 'customer.login.new' | t }} <a class="link" href="{{ routes.account_register_url }}">{{ 'customer.register.title' | t }}</a></p>
      {%- endform -%}
      {%- if shop.checkout.guest_login -%}
        <div class="account__guest stack">
          <h2 class="h4">{{ 'customer.login.guest_title' | t }}</h2>
          {%- form 'guest_login' -%}<button type="submit" class="button button--secondary">{{ 'customer.login.guest_continue' | t }}</button>{%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:labels.customer_login",
  "class": "section-main-login",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
