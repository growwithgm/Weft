<div class="section main-page page-width page-width--narrow">
  {%- if section.settings.show_title -%}
    <h1 class="main-page__title text-{{ section.settings.heading_align }}">{{ page.title | escape }}</h1>
  {%- endif -%}
  <div class="rte main-page__content">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "t:labels.page",
  "class": "section-main-page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:labels.show_page_title",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:labels.title_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    }
  ]
}
{% endschema %}
