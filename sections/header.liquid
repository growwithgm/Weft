            },
            {
              "value": "buttons",
              "label": "t:labels.buttons"
            },
            {
              "value": "sidebar",
              "label": "t:labels.sidebar"
            }
          ],
          "default": "columns"
        },
        {
          "type": "header",
          "content": "t:labels.images"
        },
        {
          "type": "select",
          "id": "link_images",
          "label": "t:labels.images_next_to_links",
