{%- comment -%}
  Collections list page (/collections): heading, text, collection cards (all collections,
  paginated, or a chosen list), promotion tiles before a chosen card.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign card_sizes = '(min-width: 990px) calc(100vw / ' | append: s.columns | append: '), 50vw'
-%}
<div class="section list-collections color-{{ s.color_scheme }}">
  <div class="page-width">
    {%- if settings.breadcrumbs_list_collections -%}{%- render 'breadcrumbs' -%}{%- endif -%}
    {%- if s.title != blank or s.description != blank -%}
      <div class="list-collections__head stack list-collections__head--{{ s.text_align }}">
        {%- if s.title != blank -%}<h1 class="h1">{{ s.title | escape }}</h1>{%- endif -%}
        {%- if s.description != blank -%}<div class="rte muted">{{ s.description }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.display_type == 'selected' and s.selected_collections.count > 0 -%}
      <ul class="product-grid list-collections__grid" role="list" style="--cols: {{ s.columns }}; --cols-mobile: {{ s.columns_mobile }}">
        {%- for collection in s.selected_collections -%}
          {%- assign card_index = forloop.index -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.position == card_index -%}
              <li class="collection__promo collection__promo--{{ block.type | remove: 'promo_' }}">{%- render 'collection-promo', block: block, sizes: card_sizes -%}</li>
            {%- endif -%}
          {%- endfor -%}
          <li>{%- render 'collection-card', collection: collection, sizes: card_sizes, eager: forloop.first, use_product_image: s.use_product_image, show_count: s.show_count -%}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      {%- paginate collections by s.per_page -%}
        <ul class="product-grid list-collections__grid" role="list" style="--cols: {{ s.columns }}; --cols-mobile: {{ s.columns_mobile }}">
          {%- for collection in collections -%}
            {%- assign card_index = forloop.index -%}
            {%- if paginate.current_page == 1 -%}
              {%- for block in section.blocks -%}
                {%- if block.settings.position == card_index -%}
                  <li class="collection__promo collection__promo--{{ block.type | remove: 'promo_' }}">{%- render 'collection-promo', block: block, sizes: card_sizes -%}</li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- liquid
              assign eager = false
              if paginate.current_page == 1 and forloop.index <= 2
                assign eager = true
              endif
            -%}
            <li>{%- render 'collection-card', collection: collection, sizes: card_sizes, eager: eager, use_product_image: s.use_product_image, show_count: s.show_count -%}</li>
          {%- endfor -%}
        </ul>
        {%- render 'pagination', paginate: paginate -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

