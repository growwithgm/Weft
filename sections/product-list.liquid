{%- comment -%}
  Product list: hand-picked products as a grid or carousel, optional promotion tile and link.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign placeholder = false
  if s.product_list == blank or s.product_list.count == 0
    assign placeholder = true
  endif
  assign view_all = ''
  if s.view_all_url != blank
    assign view_all = 'collections.view_all' | t
  endif
-%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-library.css' | asset_url | stylesheet_tag }}
{{ 'component-carousel.css' | asset_url | stylesheet_tag }}
<div class="section product-row color-{{ s.color_scheme }}{% if section.index > 2 %} below-fold{% endif %}">
  <div class="page-width">
    {%- render 'section-heading', title: s.title, align: s.heading_align, button_label: view_all, button_link: s.view_all_url, button_style: 'link' -%}
    {%- render 'product-row', products: s.product_list, limit: 24, section: section, placeholder: placeholder -%}
  </div>
</div>

{% schema %}
{
  "name": "t:labels.product_list",
  "class": "section-product-list",
  "disabled_on": {
    "templates": [
      "password"
    ],
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.heading",
      "default": "Product list"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:labels.heading_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "t:labels.products",
      "limit": 24
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "t:labels.view_all_link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:labels.grid"
        },
        {
          "value": "carousel",
          "label": "t:labels.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_large_screens",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_on_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:labels.1"
        },
        {
          "value": "2",
          "label": "t:labels.2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_highlight_products",
      "label": "t:labels.highlight_products_with_the_highlight_tag",
      "default": false,
      "info": "t:labels.tag_set_in_theme_settings_product_cards"
    },
    {
      "type": "header",
      "content": "t:labels.promotion"
    },
    {
      "type": "checkbox",
      "id": "show_promo_info",
      "label": "t:labels.show_a_promotion_tile_first",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_aspect_ratio",
      "options": [
        {
          "value": "square",
          "label": "t:labels.square"
        },
        {
          "value": "portrait",
          "label": "t:labels.portrait"
        },
        {
          "value": "landscape",
          "label": "t:labels.landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "t:labels.heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:labels.text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:labels.primary"
        },
        {
          "value": "secondary",
          "label": "t:labels.secondary"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "color_scheme",
      "id": "promo_color_scheme",
      "label": "t:labels.promotion_color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:labels.section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.product_list",
      "category": "t:labels.products"
    }
  ]
}
{% endschema %}
