{%- comment -%}
  Shoppable image: hotspots on an image open small product cards (shop the look).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign hs_image = s.image
-%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-library.css' | asset_url | stylesheet_tag }}
<div class="section hotspots-section color-{{ s.color_scheme }}{% if section.index > 2 %} below-fold{% endif %}" data-reveal>
  <div class="page-width hotspots-section__inner hotspots-section--{{ s.layout }}">
    <hot-spots class="hotspots media" style="--hotspot-color: {{ s.hotspot_color }};{% if hs_image %} aspect-ratio: {{ hs_image.aspect_ratio }};{% endif %}" data-module="{{ 'hotspots.js' | asset_url }}" data-load="interaction">
      {%- if hs_image -%}
        {%- render 'image', image: hs_image, sizes: '(min-width: 990px) 60vw, 100vw', widths: '550,750,1100,1500,1920', class: 'hotspots__image' -%}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'hotspots__image placeholder-svg' }}
      {%- endif -%}
      {%- content_for 'blocks' -%}
    </hot-spots>
    {%- if s.layout != 'image-only' -%}
      <div class="hotspots-section__content stack hotspots-section__content--{{ s.text_align }}">
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
        {%- if s.button_label != blank -%}<a class="button button--{{ s.button_style }}"{% if s.button_link != blank %} href="{{ s.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>{{ s.button_label | escape }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:labels.shoppable_image",
  "class": "section-shoppable-image",
  "max_blocks": 8,
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "blocks": [
    {
      "type": "_hotspot"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "image-start",
          "label": "t:labels.image_first"
        },
        {
          "value": "image-end",
          "label": "t:labels.image_last"
        },
        {
          "value": "image-only",
          "label": "t:labels.image_only"
        }
      ],
      "default": "image-start"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shoppable image"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:labels.primary"
        },
        {
          "value": "secondary",
          "label": "t:labels.secondary"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:labels.text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "t:labels.hotspot_color",
      "default": "#FFFFFF"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.shoppable_image",
      "category": "t:labels.products",
      "blocks": [
        {
          "type": "_hotspot",
          "settings": {
            "hotspot_x": 35,
            "hotspot_y": 40
          }
        },
        {
          "type": "_hotspot",
          "settings": {
            "hotspot_x": 65,
            "hotspot_y": 60
          }
        }
      ]
    }
  ]
}
{% endschema %}
