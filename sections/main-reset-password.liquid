{%- comment -%} Classic customer accounts: choose a new password. {%- endcomment -%}
{{ 'section-content.css' | asset_url | stylesheet_tag }}
<div class="section account color-{{ section.settings.color_scheme }}">
  <div class="page-width account__narrow stack">
    <h1 class="h2">{{ 'customer.reset.title' | t }}</h1>
    <p>{{ 'customer.password_text' | t }}</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>{%- render 'icon', name: 'alert', size: 18 -%}<span>{{ form.errors | default_errors }}</span></div>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="NewPassword">{{ 'customer.password' | t }}</label>
        <input class="input" type="password" id="NewPassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="NewPasswordConfirm">{{ 'customer.password_confirm' | t }}</label>
        <input class="input" type="password" id="NewPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <div class="cluster">
        <button type="submit" class="button">{{ 'customer.reset.submit' | t }}</button>
        
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:labels.reset_password",
  "class": "section-main-reset-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
