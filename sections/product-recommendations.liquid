{%- comment -%} Related products from Shopify's recommendations ("You may also like"). {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading = s.heading
-%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
<div class="section product-rows color-{{ s.color_scheme }} below-fold">
  <div class="page-width">
    <recommendation-list
      data-recommendations="{{ section.id }}"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent=related"
      data-module="{{ 'recommendations.js' | asset_url }}"
      data-load="visible"
    >
      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
        <div class="section-heading section-heading--{{ s.heading_align }}">
          <h2 class="h2">{% if heading != blank %}{{ heading }}{% else %}{{ 'products.recommendations.also_like' | t }}{% endif %}</h2>
        </div>
        <ul class="product-grid product-grid--{{ s.layout }}" role="list" style="--cols: {{ s.columns }}; --cols-mobile: {{ s.columns_mobile }}">
          {%- assign card_prefix = section.id | append: '-' -%}
          {%- for rec in recommendations.products limit: s.limit -%}
            {%- render 'product-card', product: rec, wrapper: 'li', index: forloop.index, sizes: '(min-width: 990px) 22vw, 45vw', id_prefix: card_prefix -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </recommendation-list>
  </div>
</div>

{% schema %}
{
  "name": "t:labels.related_products",
  "class": "section-product-recommendations",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:text.sections.product_recommendations.settings.recommendations_are_based_on_sales_and_product_d.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:labels.leave_empty_for_you_may_also_like"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:labels.heading_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "carousel",
          "label": "t:labels.carousel"
        },
        {
          "value": "grid",
          "label": "t:labels.grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:labels.maximum_products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.products_per_row_on_large_screens",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.products_per_row_on_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:labels.1"
        },
        {
          "value": "2",
          "label": "t:labels.2"
        }
      ],
      "default": "2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.related_products",
      "category": "t:labels.products"
    }
  ]
}
{% endschema %}
