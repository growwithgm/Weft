{%- comment -%}
  Routine / steps (VERTICALS §2): numbered steps such as wash → condition → treat → style, each
  with an optional product (mini card).
{%- endcomment -%}
{%- assign s = section.settings -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-vertical.css' | asset_url | stylesheet_tag }}
<div class="section routine color-{{ s.color_scheme }}{% if section.index > 2 %} below-fold{% endif %}" data-reveal>
  <div class="page-width">
    {%- render 'section-heading', title: s.heading, align: s.heading_align -%}
    {%- if s.text != blank -%}<div class="rte routine__intro">{{ s.text }}</div>{%- endif -%}
    <ol class="routine__list routine__list--{{ s.layout }}" role="list" style="--cols: {{ section.blocks.size | at_most: 4 }}">{%- content_for 'blocks' -%}</ol>
  </div>
</div>
{% schema %}
{
  "name": "t:labels.routine_steps",
  "class": "section-routine-steps",
  "max_blocks": 6,
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "blocks": [
    {
      "type": "_routine-step"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Your routine"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:labels.heading_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "row",
          "label": "t:labels.row"
        },
        {
          "value": "list",
          "label": "t:labels.list"
        }
      ],
      "default": "row"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.routine_steps",
      "category": "t:labels.products",
      "blocks": [
        {
          "type": "_routine-step",
          "settings": {
            "label": "Step 1",
            "heading": "Wash"
          }
        },
        {
          "type": "_routine-step",
          "settings": {
            "label": "Step 2",
            "heading": "Condition"
          }
        },
        {
          "type": "_routine-step",
          "settings": {
            "label": "Step 3",
            "heading": "Treat"
          }
        },
        {
          "type": "_routine-step",
          "settings": {
            "label": "Step 4",
            "heading": "Style"
          }
        }
      ]
    }
  ]
}
{% endschema %}
