{%- comment -%} Classic customer accounts: create an account. {%- endcomment -%}
{{ 'section-content.css' | asset_url | stylesheet_tag }}
<div class="section account color-{{ section.settings.color_scheme }}">
  <div class="page-width account__narrow stack">
    <h1 class="h2">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>{%- render 'icon', name: 'alert', size: 18 -%}<span>{{ form.errors | default_errors }}</span></div>
      {%- endif -%}
      <div class="form-fields">
        <div class="form-field form-field--half">
          <label class="field__label" for="RegisterFirstName">{{ 'customer.first_name' | t }}</label>
          <input class="input" type="text" id="RegisterFirstName" name="customer[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
        </div>
        <div class="form-field form-field--half">
          <label class="field__label" for="RegisterLastName">{{ 'customer.last_name' | t }}</label>
          <input class="input" type="text" id="RegisterLastName" name="customer[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
        </div>
        <div class="form-field">
          <label class="field__label" for="RegisterEmail">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
          <input class="input" type="email" id="RegisterEmail" name="customer[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" spellcheck="false" required{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
        </div>
        <div class="form-field">
          <label class="field__label" for="RegisterPassword">{{ 'customer.password' | t }} <span aria-hidden="true">*</span></label>
          <input class="input" type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" required{% if form.errors contains 'password' %} aria-invalid="true"{% endif %}>
        </div>
      </div>
      <button type="submit" class="button button--full">{{ 'customer.register.submit' | t }}</button>
      <p class="account__alt">{{ 'customer.register.have_account' | t }} <a class="link" href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a></p>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:labels.create_account",
  "class": "section-main-register",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
