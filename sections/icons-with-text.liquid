{%- comment -%}
  Icons with text: short reassurance items (delivery, returns, payment) with theme icons or custom images.
{%- endcomment -%}
{%- assign s = section.settings -%}
{{ 'section-library.css' | asset_url | stylesheet_tag }}
<div class="section icons-text icons-text--{{ s.icon_position }} icons-text--{{ s.text_align }} icons-text--{{ s.density }}{% if s.dividers %} icons-text--dividers{% endif %} color-{{ s.color_scheme }}{% if section.index > 2 %} below-fold{% endif %}" data-reveal>
  <div class="page-width{% if s.full_width %} page-width--full{% endif %}">
    {%- render 'section-heading', title: s.title, align: s.heading_align, button_label: s.button_label, button_link: s.button_link, button_style: s.button_style -%}
    <div class="scroll-row scroll-row--grid">
      <ul class="icons-grid icons-text__list" role="list" data-scroll-list style="--cols: {{ s.columns | default: 3 }}; --cols-mobile: {{ s.columns_mobile | default: 1 }}">
        {%- content_for 'blocks' -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:labels.icons_with_text",
  "class": "section-icons-text",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "_icon-item"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.heading"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:labels.heading_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_large_screens",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:labels.columns_on_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:labels.1"
        },
        {
          "value": "2",
          "label": "t:labels.2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "t:labels.icon_size",
      "min": 20,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "t:labels.icon_position",
      "options": [
        {
          "value": "top",
          "label": "t:labels.above_the_text"
        },
        {
          "value": "start",
          "label": "t:labels.beside_the_text"
        }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:labels.text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "density",
      "label": "t:labels.section_height",
      "options": [
        {
          "value": "compact",
          "label": "t:labels.compact"
        },
        {
          "value": "normal",
          "label": "t:labels.normal"
        }
      ],
      "default": "normal"
    },
    {
      "type": "checkbox",
      "id": "dividers",
      "label": "t:labels.dividing_lines_between_items",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:labels.full_width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.icons_with_text",
      "category": "t:labels.text",
      "blocks": [
        {
          "type": "_icon-item",
          "settings": {
            "icon": "truck",
            "heading": "Free delivery"
          }
        },
        {
          "type": "_icon-item",
          "settings": {
            "icon": "return",
            "heading": "Easy returns",
            "text": "<p>Change your mind within 30 days.</p>"
          }
        },
        {
          "type": "_icon-item",
          "settings": {
            "icon": "lock",
            "heading": "Secure payment",
            "text": "<p>Pay safely with the methods you trust.</p>"
          }
        },
        {
          "type": "_icon-item",
          "settings": {
            "icon": "chat",
            "heading": "Here to help",
            "text": "<p>Message us any time.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
