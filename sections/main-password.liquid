{%- comment -%} Password page: logo, message, email signup, socials, password form. {%- endcomment -%}
<div class="password color-{{ section.settings.color_scheme }}">
  <header class="password__header page-width">
    <span class="password__logo">
      {%- if section.settings.logo != blank or settings.logo != blank -%}
        {%- assign logo_img = section.settings.logo | default: settings.logo -%}
        {%- assign logo_w2 = section.settings.logo_width | times: 2 -%}
        {{ logo_img | image_url: width: logo_w2 | image_tag: width: section.settings.logo_width, alt: shop.name, loading: 'eager' }}
      {%- else -%}
        <span class="h2">{{ shop.name }}</span>
      {%- endif -%}
    </span>
    <details class="password__owner">
      <summary class="link">{{ 'password.enter_with_password' | t }}</summary>
      <div class="password__owner-panel stack">
        {%- form 'storefront_password', class: 'password__form' -%}
          <label class="field__label" for="PasswordInput">{{ 'password.password' | t }}</label>
          <div class="cluster">
            <input class="input" type="password" name="password" id="PasswordInput" autocomplete="current-password" required {% if form.errors %}aria-invalid="true" aria-describedby="PasswordError"{% endif %}>
            <button type="submit" class="button">{{ 'password.enter' | t }}</button>
          </div>
          {%- if form.errors -%}<p class="form-message form-message--error" id="PasswordError">{{ 'password.wrong' | t }}</p>{%- endif -%}
        {%- endform -%}
        <small class="muted">{{ 'password.owner' | t }} <a href="/admin" rel="nofollow">{{ 'password.owner_link' | t }}</a></small>
      </div>
    </details>
  </header>
  <main class="password__main page-width page-width--narrow text-center stack">
    {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if shop.password_message != blank -%}<p class="password__message">{{ shop.password_message }}</p>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.show_signup -%}
      <div class="password__signup stack">
        {%- if section.settings.signup_heading != blank -%}<h2 class="h3">{{ section.settings.signup_heading }}</h2>{%- endif -%}
        {%- render 'newsletter-form', id: 'password' -%}
      </div>
    {%- endif -%}
    {%- if section.settings.show_social -%}{%- render 'social-links' -%}{%- endif -%}
    {%- if shop.features.follow_on_shop? -%}<div>{{ shop | login_button: action: 'follow' }}</div>{%- endif -%}
  </main>
  {%- if section.settings.show_powered_by -%}
    <footer class="password__footer page-width text-center"><small>{{ 'password.powered_by' | t }} {{ powered_by_link }}</small></footer>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:labels.password_page",
  "class": "section-main-password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo",
      "info": "t:labels.uses_the_theme_logo_when_empty"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:labels.logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 140,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Opening soon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "t:labels.show_email_signup",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "t:labels.signup_heading",
      "default": "Be the first to know"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:labels.show_social_media_links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:labels.show_powered_by_shopify",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
