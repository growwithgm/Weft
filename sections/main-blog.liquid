{%- comment -%}
  Blog page: title and description, tag filter (links to /blogs/<blog>/tagged/<tag>), optional
  featured first post, post cards, pagination.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign card_sizes = '(min-width: 990px) calc(100vw / ' | append: s.columns | append: '), (min-width: 750px) 50vw, 100vw'
-%}
{{ 'section-library.css' | asset_url | stylesheet_tag }}
{{ 'section-content.css' | asset_url | stylesheet_tag }}
<div class="section main-blog color-{{ s.color_scheme }}">
  <div class="page-width">
    <div class="main-blog__head stack main-blog__head--{{ s.text_align }}">
      {%- if s.show_title -%}<h1 class="h1">{{ blog.title | escape }}</h1>{%- endif -%}
      {%- if s.description != blank -%}<div class="rte main-blog__description">{{ s.description }}</div>{%- endif -%}
      {%- if s.show_tag_filter and blog.all_tags.size > 0 -%}
        <nav class="main-blog__tags" aria-label="{{ 'blogs.filter_by_tag' | t }}">
          <ul class="main-blog__tag-list" role="list">
            <li><a class="main-blog__tag" href="{{ blog.url }}"{% if current_tags == blank %} aria-current="page"{% endif %}>{{ 'blogs.all_posts' | t }}</a></li>
            {%- for tag in blog.all_tags -%}
              <li><a class="main-blog__tag" href="{{ blog.url }}/tagged/{{ tag | handleize }}"{% if current_tags contains tag %} aria-current="page"{% endif %}>{{ tag | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
    {%- paginate blog.articles by s.posts_per_page -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="columns-grid main-blog__grid" role="list" style="--cols: {{ s.columns }}; --cols-mobile: 1">
          {%- for article in blog.articles -%}
            {%- liquid
              assign featured = false
              if s.feature_first and forloop.first and paginate.current_page == 1
                assign featured = true
              endif
            -%}
            <li{% if featured %} class="main-blog__featured"{% endif %}>
              {%- render 'article-card', article: article, sizes: card_sizes, show_image: s.show_image, show_tags: s.show_tags, show_excerpt: s.show_excerpt, show_author: s.show_author, show_date: s.show_date, show_button: s.show_button, button_style: s.button_style, image_ratio: s.image_ratio, heading_tag: 'h2' -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="muted main-blog__empty">{{ 'blogs.empty' | t }}</p>
      {%- endif -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:labels.blog",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:labels.show_blog_title",
      "default": true
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:labels.description"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:labels.text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "checkbox",
      "id": "show_tag_filter",
      "label": "t:labels.show_tag_filter",
      "default": true
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "t:labels.posts_per_page",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_large_screens",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "feature_first",
      "label": "t:labels.show_the_latest_post_larger",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:labels.show_featured_image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_aspect_ratio",
      "options": [
        {
          "value": "square",
          "label": "t:labels.square"
        },
        {
          "value": "portrait",
          "label": "t:labels.portrait"
        },
        {
          "value": "landscape",
          "label": "t:labels.landscape"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:labels.show_tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:labels.show_excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:labels.show_author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:labels.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "t:labels.show_read_more",
      "default": false
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:labels.primary"
        },
        {
          "value": "secondary",
          "label": "t:labels.secondary"
        },
        {
          "value": "link",
          "label": "t:labels.link"
        }
      ],
      "default": "link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
