{%- comment -%}
  Blog posts: recent posts from one blog as cards, grid or carousel.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign b = s.blog
  assign view_all = ''
  if s.show_view_all and b != blank and b.articles_count > s.posts_to_show
    assign view_all = 'blogs.view_all' | t
  endif
  assign card_sizes = '(min-width: 990px) calc(100vw / ' | append: s.columns | append: '), (min-width: 750px) 50vw, 85vw'
-%}
{{ 'section-library.css' | asset_url | stylesheet_tag }}
<div class="section featured-blog color-{{ s.color_scheme }}{% if section.index > 2 %} below-fold{% endif %}" data-reveal>
  <div class="page-width">
    {%- render 'section-heading', title: s.title, align: s.heading_align, button_label: view_all, button_link: b.url, button_style: 'link' -%}
    <scroll-row class="scroll-row scroll-row--{{ s.layout }}" data-module="{{ 'carousel.js' | asset_url }}" data-load="visible">
      <ul class="columns-grid{% if s.layout == 'carousel' %} is-carousel{% endif %}" role="list" data-scroll-list style="--cols: {{ s.columns }}; --cols-mobile: 1">
        {%- if b != blank and b.articles_count > 0 -%}
          {%- for article in b.articles limit: s.posts_to_show -%}
            <li>{%- render 'article-card', article: article, sizes: card_sizes, show_image: s.show_image, show_tags: s.show_tags, show_excerpt: s.show_excerpt, show_author: s.show_author, show_date: s.show_date, show_button: s.show_button, button_style: s.button_style, image_ratio: s.image_ratio -%}</li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <li>
              <article class="article-card">
                <div class="article-card__media media media--{{ s.image_ratio }}">{{ 'blog-apparel-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
                <div class="article-card__body stack"><p class="h4 article-card__title">{{ 'blogs.placeholder_title' | t }}</p></div>
              </article>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- if s.layout == 'carousel' -%}
        <div class="scroll-row__buttons js-only">
          <button type="button" class="icon-button" data-scroll-prev aria-label="{{ 'general.previous' | t }}">{%- render 'icon', name: 'chevron-left', size: 20 -%}</button>
          <button type="button" class="icon-button" data-scroll-next aria-label="{{ 'general.next' | t }}">{%- render 'icon', name: 'chevron-right', size: 20 -%}</button>
        </div>
      {%- endif -%}
    </scroll-row>
  </div>
</div>

{% schema %}
{
  "name": "t:labels.blog_posts",
  "class": "section-featured-blog",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.heading",
      "default": "From the journal"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:labels.heading_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:labels.blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "t:labels.posts_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:labels.show_view_all_link",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:labels.grid"
        },
        {
          "value": "carousel",
          "label": "t:labels.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_on_large_screens",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:labels.show_featured_image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_aspect_ratio",
      "options": [
        {
          "value": "square",
          "label": "t:labels.square"
        },
        {
          "value": "portrait",
          "label": "t:labels.portrait"
        },
        {
          "value": "landscape",
          "label": "t:labels.landscape"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:labels.show_tags",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:labels.show_excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:labels.show_author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:labels.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "t:labels.show_read_more",
      "default": false
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:labels.primary"
        },
        {
          "value": "secondary",
          "label": "t:labels.secondary"
        },
        {
          "value": "link",
          "label": "t:labels.link"
        }
      ],
      "default": "link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.blog_posts",
      "category": "t:labels.blog"
    }
  ]
}
{% endschema %}
