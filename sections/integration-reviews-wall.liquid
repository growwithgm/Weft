{%- comment -%}
  Integration (store builds only): a reviews page from Judge.me's synced data, reviews with
  photos first. Every product review names its product. Needs Theme settings > Integrations >
  "Show reviews from Judge.me data".
{%- endcomment -%}
{%- comment -%} Hidden from wholesale buyers when "Hide for wholesale buyers" is on. {%- endcomment -%}
{%- capture retail_view -%}{% render 'audience-check', audience: 'retail' %}{%- endcapture -%}
{%- if section.settings.hide_for_wholesale == false or retail_view == '1' -%}
{%- liquid
  assign s = section.settings
  assign data = shop.metafields.judgeme.reviews_grid.value
  assign average = data.average_rating | default: shop.metafields.judgeme.all_reviews_rating | plus: 0
  assign total = data.number_of_reviews | default: shop.metafields.judgeme.all_reviews_count | plus: 0
-%}
{%- if settings.integration_reviews_enable and data != blank -%}
  {{ 'integration-reviews.css' | asset_url | stylesheet_tag }}
  <div class="section reviews-integration reviews-integration--wall color-{{ s.color_scheme }}">
    <div class="page-width stack">
      <div class="reviews-integration__head stack">
        <h2 class="h1">{{ s.heading | escape }}</h2>
        {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
        {%- render 'integration-reviews-summary', average: average, total: total -%}
      </div>
      {%- render 'integration-reviews-list', data: data, min_rating: s.min_rating, min_length: s.min_length, max_reviews: s.max_reviews, first_batch: s.first_batch, others: true, show_photos: s.show_photos, media_first: s.media_first -%}
      {%- if s.all_reviews_link != blank -%}<p class="reviews-integration__all"><a class="button button--secondary" href="{{ s.all_reviews_link }}">{{ s.all_reviews_label | escape }}</a></p>{%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="section page-width"><p class="muted">{{ 'integrations.reviews.editor_note' | t }}</p></div>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:labels.reviews_wall",
  "class": "section-integration-reviews",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_for_wholesale",
      "label": "t:labels.hide_for_wholesale_buyers",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:text.sections.integration_reviews_grid.settings.store_integration_shows_reviews_from_judge_me_s_.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What our customers say"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "range",
      "id": "min_rating",
      "label": "t:labels.lowest_rating_shown",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "min_length",
      "label": "t:labels.shortest_review_shown",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 0,
      "info": "t:labels.in_characters"
    },
    {
      "type": "range",
      "id": "max_reviews",
      "label": "t:labels.maximum_reviews",
      "min": 3,
      "max": 60,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "first_batch",
      "label": "t:labels.reviews_before_show_more",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "media_first",
      "label": "t:labels.show_reviews_with_photos_first",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_photos",
      "label": "t:labels.show_review_photos",
      "default": true
    },
    {
      "type": "url",
      "id": "all_reviews_link",
      "label": "t:labels.all_reviews_link"
    },
    {
      "type": "text",
      "id": "all_reviews_label",
      "label": "t:labels.all_reviews_label",
      "default": "See all reviews"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.reviews_wall",
      "category": "t:labels.store_integrations"
    }
  ]
}
{% endschema %}
