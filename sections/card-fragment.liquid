{%- comment -%} Renders one product card for the current product; used by recently viewed (/products/<handle>?section_id=card-fragment). {%- endcomment -%}
{%- if product -%}
  <div data-card-fragment>{%- render 'product-card', product: product, wrapper: 'div', index: 1, sizes: '(min-width: 990px) 20vw, 45vw', id_prefix: 'recent-' -%}</div>
{%- endif -%}
