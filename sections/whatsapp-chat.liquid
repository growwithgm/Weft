{%- comment -%}
  Floating WhatsApp chat: a round button, and an optional chat window with a greeting and one or
  more contacts (Contact blocks). Merchants add it in the theme editor (Overlays > Add section).
  Shows only where the page-address rules allow it and to the chosen audience. It never covers an
  add-to-cart or checkout button: whatsapp.js hides it while one sits underneath it, and core.js
  hides it while a drawer, dialog or the mobile sticky bar is open.
  Works without JavaScript: the window is a <details> element and every contact is a plain link.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign show = true
  capture audience_ok
    render 'audience-check', audience: s.audience
  endcapture
  if audience_ok != '1'
    assign show = false
  endif

  # Page-address rules: one address per line; a trailing * matches everything that starts with it.
  assign path = request.path | downcase
  assign locale_root = routes.root_url | downcase
  if locale_root != '/'
    assign locale_len = locale_root | size
    assign path_start = path | slice: 0, locale_len
    if path_start == locale_root
      assign path = path | remove_first: locale_root
      if path == blank
        assign path = '/'
      endif
    endif
  endif
  assign matched = false
  if s.urls != blank
    assign rules = s.urls | newline_to_br | split: '<br />'
    for line in rules limit: 50
      assign rule = line | strip | downcase | split: '?' | first | split: '#' | first
      if rule == blank
        continue
      endif
      if rule contains '://'
        assign after_scheme = rule | split: '://' | last
        assign host = after_scheme | split: '/' | first
        assign rule = after_scheme | remove_first: host
        if rule == blank
          assign rule = '/'
        endif
      endif
      assign rule_size = rule | size
      assign last_char = rule | slice: -1, 1
      if last_char == '*'
        assign prefix_len = rule_size | minus: 1
        assign prefix = rule | slice: 0, prefix_len
        assign path_prefix = path | slice: 0, prefix_len
        if path_prefix == prefix
          assign matched = true
          break
        endif
      else
        if rule_size > 1 and last_char == '/'
          assign trimmed = rule_size | minus: 1
          assign rule = rule | slice: 0, trimmed
        endif
        if rule == path
          assign matched = true
          break
        endif
      endif
    endfor
  endif
  if s.url_mode == 'only' and matched == false
    assign show = false
  elsif s.url_mode == 'hide' and matched
    assign show = false
  endif

  assign wa_message = s.message
  if wa_message == blank
    assign wa_message = 'general.chat.message' | t
  endif
  capture main_link
    render 'whatsapp-link', phone: s.phone, message: wa_message, page_link: s.add_page_link
  endcapture
  assign main_link = main_link | strip
  assign has_contacts = false
  for block in section.blocks
    if block.type == 'contact'
      assign has_contacts = true
      break
    endif
  endfor
  if main_link == blank and has_contacts == false
    assign show = false
  endif
  if request.design_mode and main_link == blank and has_contacts == false
    assign show = true
  endif
-%}
{%- if show -%}
  {{ 'component-whatsapp.css' | asset_url | stylesheet_tag }}
  <wa-chat
    class="wa wa--{{ s.position }} wa--show-{{ s.show_on }}{% if s.button_style == 'icon_label' %} wa--labelled{% endif %}"
    style="--wa-bg: {{ s.button_bg }}; --wa-fg: {{ s.button_icon }}; --wa-size: {{ s.size }}px; --wa-offset: {{ s.offset_desktop }}px; --wa-offset-mobile: {{ s.offset_mobile }}px; --wa-side: {{ s.side_offset }}px;"
    data-chat-button
    data-delay="{{ s.open_delay }}"
    data-section-id="{{ section.id }}"
    data-module="{{ 'whatsapp.js' | asset_url }}"
    data-load="idle"
    {{ section.shopify_attributes }}
  >
    {%- capture button_inner -%}
      <span class="wa__icon" aria-hidden="true">{%- render 'icon', name: 'whatsapp', size: 28 -%}</span>
      {%- if s.button_style == 'icon_label' and s.button_label != blank -%}<span class="wa__label">{{ s.button_label | escape }}</span>{%- endif -%}
    {%- endcapture -%}
    {%- if s.show_window -%}
      <details class="wa__details" data-wa-details>
        <summary class="wa__button" aria-label="{{ 'general.chat.label' | t }}">{{ button_inner }}</summary>
        <div class="wa__window color-{{ s.color_scheme }}" role="group" aria-label="{{ s.agent_name | default: 'general.chat.label' | t | escape }}">
          <div class="wa__head" style="--wa-head: {{ s.button_bg }};">
            {%- if s.avatar -%}
              <span class="wa__avatar">{{ s.avatar | image_url: width: 96 | image_tag: width: 48, height: 48, alt: '', loading: 'lazy' }}</span>
            {%- else -%}
              <span class="wa__avatar wa__avatar--icon" aria-hidden="true">{%- render 'icon', name: 'whatsapp', size: 24 -%}</span>
            {%- endif -%}
            <span class="wa__who">
              {%- if s.agent_name != blank -%}<span class="wa__name">{{ s.agent_name | escape }}</span>{%- endif -%}
              {%- if s.agent_status != blank -%}<span class="wa__status">{{ s.agent_status | escape }}</span>{%- endif -%}
            </span>
            <button type="button" class="wa__close js-only" data-wa-close aria-label="{{ 'general.close' | t }}">{%- render 'icon', name: 'close', size: 18 -%}</button>
          </div>
          <div class="wa__body">
            {%- if s.greeting != blank -%}<p class="wa__greeting">{{ s.greeting | escape | newline_to_br }}</p>{%- endif -%}
            {%- if has_contacts -%}
              <ul class="wa__contacts" role="list">
                {%- for block in section.blocks -%}
                  {%- if block.type != 'contact' -%}{%- continue -%}{%- endif -%}
                  {%- assign contact_phone = block.settings.phone | default: s.phone -%}
                  {%- capture contact_link -%}{%- render 'whatsapp-link', phone: contact_phone, message: wa_message, page_link: s.add_page_link -%}{%- endcapture -%}
                  {%- assign contact_link = contact_link | strip -%}
                  {%- if contact_link == blank -%}{%- continue -%}{%- endif -%}
                  <li {{ block.shopify_attributes }}>
                    <a class="wa__contact" href="{{ contact_link }}" target="_blank" rel="noopener">
                      <span class="wa__avatar wa__avatar--small">
                        {%- if block.settings.avatar -%}{{ block.settings.avatar | image_url: width: 80 | image_tag: width: 40, height: 40, alt: '', loading: 'lazy' }}{%- else -%}<span aria-hidden="true">{{ block.settings.name | slice: 0 | upcase | escape }}</span>{%- endif -%}
                      </span>
                      <span class="wa__who">
                        <span class="wa__name">{{ block.settings.name | escape }}</span>
                        {%- if block.settings.role != blank -%}<span class="wa__status">{{ block.settings.role | escape }}</span>{%- endif -%}
                      </span>
                      <span class="visually-hidden">({{ 'general.opens_new_window' | t }})</span>
                      <span class="wa__go" aria-hidden="true">{%- render 'icon', name: 'whatsapp', size: 20 -%}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- elsif main_link != blank -%}
              <a class="button button--full wa__start" href="{{ main_link }}" target="_blank" rel="noopener" style="--wa-start: {{ s.button_bg }}; --wa-start-fg: {{ s.button_icon }};">
                {%- render 'icon', name: 'whatsapp', size: 20 -%}
                <span>{{ s.start_label | escape }}</span>
                <span class="visually-hidden">({{ 'general.opens_new_window' | t }})</span>
              </a>
            {%- elsif request.design_mode -%}
              <p class="wa__note">{{ 'general.chat.editor_no_number' | t }}</p>
            {%- endif -%}
          </div>
        </div>
      </details>
    {%- elsif main_link != blank -%}
      <a class="wa__button" href="{{ main_link }}" target="_blank" rel="noopener" aria-label="{{ 'general.chat.label' | t }} ({{ 'general.opens_new_window' | t }})">{{ button_inner }}</a>
    {%- else -%}
      <span class="wa__button" role="img" aria-label="{{ 'general.chat.editor_no_number' | t }}">{{ button_inner }}</span>
    {%- endif -%}
  </wa-chat>
{%- endif -%}

{% schema %}
{
  "name": "t:labels.whatsapp_chat",
  "class": "section-whatsapp",
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:text.sections.whatsapp_chat.settings.a_floating_whatsapp_button_it_never_covers_add_t.content"
    },
    {
      "type": "header",
      "content": "t:labels.contact"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:labels.whatsapp_number",
      "info": "t:text.sections.whatsapp_chat.settings.phone.info"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "t:labels.pre_filled_message",
      "info": "t:text.sections.whatsapp_chat.settings.message.info"
    },
    {
      "type": "checkbox",
      "id": "add_page_link",
      "label": "t:labels.add_the_page_address_to_the_message",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.button"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.style",
      "options": [
        {
          "value": "icon",
          "label": "t:labels.icon"
        },
        {
          "value": "icon_label",
          "label": "t:labels.icon_and_text"
        }
      ],
      "default": "icon"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_text",
      "default": "Chat with us",
      "visible_if": "{{ section.settings.button_style == 'icon_label' }}"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:labels.position",
      "options": [
        {
          "value": "end",
          "label": "t:labels.bottom_right"
        },
        {
          "value": "start",
          "label": "t:labels.bottom_left"
        }
      ],
      "default": "end"
    },
    {
      "type": "range",
      "id": "size",
      "label": "t:labels.button_size",
      "min": 44,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "side_offset",
      "label": "t:labels.distance_from_the_side",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "offset_desktop",
      "label": "t:labels.distance_from_the_bottom_on_large_screens",
      "min": 8,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "offset_mobile",
      "label": "t:labels.distance_from_the_bottom_on_phones",
      "min": 8,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "t:labels.button_color",
      "default": "#0F7D6F",
      "info": "t:text.sections.whatsapp_chat.settings.button_bg.info"
    },
    {
      "type": "color",
      "id": "button_icon",
      "label": "t:labels.icon_and_text_color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:labels.chat_window"
    },
    {
      "type": "checkbox",
      "id": "show_window",
      "label": "t:labels.open_a_chat_window_first",
      "info": "t:labels.off_the_button_opens_whatsapp_straight_away",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.show_window }}"
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "t:labels.photo_or_logo",
      "visible_if": "{{ section.settings.show_window }}"
    },
    {
      "type": "text",
      "id": "agent_name",
      "label": "t:labels.name",
      "default": "Customer care",
      "visible_if": "{{ section.settings.show_window }}"
    },
    {
      "type": "text",
      "id": "agent_status",
      "label": "t:labels.status_line",
      "default": "Typically replies within a few hours",
      "visible_if": "{{ section.settings.show_window }}"
    },
    {
      "type": "textarea",
      "id": "greeting",
      "label": "t:labels.greeting",
      "default": "Hi! How can we help you today?",
      "visible_if": "{{ section.settings.show_window }}"
    },
    {
      "type": "text",
      "id": "start_label",
      "label": "t:labels.start_chat_button",
      "default": "Start chat",
      "visible_if": "{{ section.settings.show_window }}"
    },
    {
      "type": "range",
      "id": "open_delay",
      "label": "t:labels.open_the_window_automatically_after",
      "info": "t:text.sections.whatsapp_chat.settings.open_delay.info",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 0,
      "visible_if": "{{ section.settings.show_window }}"
    },
    {
      "type": "header",
      "content": "t:labels.where_it_shows"
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "t:labels.devices",
      "options": [
        {
          "value": "all",
          "label": "t:labels.all_devices"
        },
        {
          "value": "desktop",
          "label": "t:labels.large_screens_only"
        },
        {
          "value": "mobile",
          "label": "t:labels.phones_and_tablets_only"
        }
      ],
      "default": "all"
    },
    {
      "type": "select",
      "id": "audience",
      "label": "t:labels.show_to",
      "options": [
        {
          "value": "all",
          "label": "t:labels.everyone"
        },
        {
          "value": "retail",
          "label": "t:labels.retail_shoppers"
        },
        {
          "value": "wholesale",
          "label": "t:labels.wholesale_buyers"
        }
      ],
      "default": "all"
    },
    {
      "type": "select",
      "id": "url_mode",
      "label": "t:labels.page_addresses",
      "options": [
        {
          "value": "hide",
          "label": "t:labels.hide_on_these_pages"
        },
        {
          "value": "only",
          "label": "t:labels.show_only_on_these_pages"
        }
      ],
      "default": "hide"
    },
    {
      "type": "textarea",
      "id": "urls",
      "label": "t:labels.pages",
      "info": "t:text.sections.whatsapp_chat.settings.urls.info"
    }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "t:labels.contact",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "t:labels.name",
          "default": "Sales"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:labels.role",
          "default": "Orders and sizing"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "t:labels.whatsapp_number",
          "info": "t:text.sections.whatsapp_chat.blocks.contact.settings.phone.info"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "t:labels.photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:labels.whatsapp_chat"
    }
  ],
  "enabled_on": {
    "groups": [
      "aside"
    ]
  }
}
{% endschema %}
