{%- comment -%}
  Media with text: an image or a video beside text blocks. Media side, width and fit are
  settings; on mobile the media sits above the text.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign eager = false
  if section.index == 1
    assign eager = true
  endif
  assign media_sizes = '(min-width: 990px) ' | append: s.media_width | append: 'vw, 100vw'
-%}
{{ 'section-library.css' | asset_url | stylesheet_tag }}
<div class="section media-text{% if s.only_content_color_scheme == false %} color-{{ s.color_scheme }} media-text--filled{% endif %}{% if section.index > 2 %} below-fold{% endif %}" data-reveal>
  <div class="page-width media-text__inner media-text--{{ s.layout }}" style="--media-width: {{ s.media_width }}%;">
    <div class="media-text__media media{% if s.image_fit == 'contain' %} media--contain{% endif %}">
      {%- if s.video != blank or s.video_url != blank -%}
        {%- render 'deferred-video', video: s.video, video_url: s.video_url, poster: s.image, description: s.video_description, background: s.video_autoplay, sizes: media_sizes, eager: eager -%}
      {%- elsif s.image -%}
        {%- render 'image', image: s.image, sizes: media_sizes, eager: eager, widths: '375,550,750,1100,1500,1920' -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="media-text__content stack media-text__content--{{ s.text_align }}{% if s.only_content_color_scheme %} color-{{ s.color_scheme }} media-text__content--boxed{% endif %}">
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:labels.media_with_text",
  "class": "section-media-with-text",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:labels.also_the_cover_image_when_a_video_is_set"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:labels.or_a_youtube_vimeo_url",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "text",
      "id": "video_description",
      "label": "t:labels.video_description"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "t:labels.play_the_video_automatically_muted",
      "default": false,
      "info": "t:labels.uploaded_videos_only"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.media_position",
      "options": [
        {
          "value": "media-start",
          "label": "t:labels.start"
        },
        {
          "value": "media-end",
          "label": "t:labels.end"
        }
      ],
      "default": "media-start"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:labels.image_fit",
      "options": [
        {
          "value": "cover",
          "label": "t:labels.fill"
        },
        {
          "value": "contain",
          "label": "t:labels.fit"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "t:labels.media_width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:labels.text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "only_content_color_scheme",
      "label": "t:labels.apply_the_color_scheme_to_the_text_box_only",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:labels.media_with_text",
      "category": "t:labels.media",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "<p>Our story</p>",
            "style": "subheading"
          }
        },
        {
          "type": "heading",
          "settings": {
            "heading": "Media with text",
            "size": "h2"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Pair text with an image or a video to focus on your chosen product, collection or story.</p>"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Learn more",
            "style": "secondary"
          }
        }
      ]
    }
  ]
}
{% endschema %}
