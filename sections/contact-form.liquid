{%- comment -%}
  Contact form (Theme Store contact template): fields as blocks, optional image beside the form,
  Shopify's success and error messages. An email field is always included because Shopify's
  contact form needs one.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign form_id = 'ContactForm-' | append: section.id
  assign has_email = false
  for block in section.blocks
    if block.type == '_form-field' and block.settings.type == 'email'
      assign has_email = true
    endif
  endfor
-%}
{{ 'section-content.css' | asset_url | stylesheet_tag }}
<div class="section contact-form color-{{ s.color_scheme }}{% if section.index > 2 %} below-fold{% endif %}" data-reveal>
  <div class="page-width{% unless s.full_width %} page-width--narrow{% endunless %}{% if s.image %} contact-form--with-image contact-form--image-{{ s.image_position }}{% endif %}">
    {%- if s.image -%}
      <div class="contact-form__media media">{%- render 'image', image: s.image, sizes: '(min-width: 990px) 45vw, 100vw', widths: '550,750,1100,1500' -%}</div>
    {%- endif -%}
    <div class="contact-form__body">
      {%- render 'section-heading', title: s.heading, align: s.heading_align -%}
      {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{%- render 'icon', name: 'check', size: 18 -%}{{ 'contact.success' | t }}</p>
        {%- elsif form.errors -%}
          <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>{%- render 'icon', name: 'alert', size: 18 -%}<span>{{ form.errors | default_errors }}</span></div>
        {%- endif -%}
        <div class="form-fields">
          {%- unless has_email -%}
            <div class="form-field form-field--full">
              <label class="field__label" for="{{ form_id }}-email">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
              <input class="input" type="email" id="{{ form_id }}-email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required>
            </div>
          {%- endunless -%}
          {%- content_for 'blocks' -%}
        </div>
        <p class="form-fields__note muted">{{ 'contact.required_note' | t }}</p>
        <button type="submit" class="button button--{{ s.button_style }}">{{ 'contact.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:labels.contact_form",
  "class": "section-contact-form",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "blocks": [
    {
      "type": "_form-field"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Contact us"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:labels.heading_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "end",
          "label": "t:labels.end"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:labels.primary"
        },
        {
          "value": "secondary",
          "label": "t:labels.secondary"
        }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:labels.full_width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.contact_form",
      "category": "t:labels.forms",
      "blocks": [
        {
          "type": "_form-field",
          "settings": {
            "type": "name",
            "half_width": true
          }
        },
        {
          "type": "_form-field",
          "settings": {
            "type": "email",
            "half_width": true
          }
        },
        {
          "type": "_form-field",
          "settings": {
            "type": "phone"
          }
        },
        {
          "type": "_form-field",
          "settings": {
            "type": "message",
            "required": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
