{%- comment -%}
  Before/after comparison slider (VERTICALS §2): the divider is a native range input over the
  two images, so it works with keyboard (arrows, Home, End), touch and screen readers.
  compare-slider.js updates the split; without JavaScript both images show side by side.
{%- endcomment -%}
{%- assign s = section.settings -%}
{{ 'section-vertical.css' | asset_url | stylesheet_tag }}
<div class="section before-after color-{{ s.color_scheme }}{% if section.index > 2 %} below-fold{% endif %}" data-reveal>
  <div class="page-width before-after__inner before-after--{{ s.layout }}">
    {%- if s.heading != blank or s.text != blank -%}
      <div class="before-after__content stack">
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
        {%- if s.disclaimer != blank -%}<p class="muted before-after__note">{{ s.disclaimer | escape }}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <compare-slider class="compare-slider" style="--pos: {{ s.start }}%;{% if s.image_before %} aspect-ratio: {{ s.image_before.aspect_ratio }};{% endif %}" data-module="{{ 'compare-slider.js' | asset_url }}" data-load="visible">
      <figure class="compare-slider__before media">
        {%- if s.image_before -%}{%- render 'image', image: s.image_before, sizes: '(min-width: 990px) 50vw, 100vw', widths: '550,750,1100,1500' -%}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        <figcaption class="compare-slider__tag compare-slider__tag--before">{{ s.label_before | escape }}</figcaption>
      </figure>
      <figure class="compare-slider__after media">
        {%- if s.image_after -%}{%- render 'image', image: s.image_after, sizes: '(min-width: 990px) 50vw, 100vw', widths: '550,750,1100,1500' -%}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        <figcaption class="compare-slider__tag compare-slider__tag--after">{{ s.label_after | escape }}</figcaption>
      </figure>
      <span class="compare-slider__handle js-only" aria-hidden="true"></span>
      <label class="visually-hidden" for="Compare-{{ section.id }}">{{ 'finder.compare_label' | t: before: s.label_before, after: s.label_after }}</label>
      <input class="compare-slider__range js-only" type="range" id="Compare-{{ section.id }}" min="0" max="100" step="1" value="{{ s.start }}" data-compare-range>
    </compare-slider>
  </div>
</div>
{% schema %}
{
  "name": "t:labels.before_and_after",
  "class": "section-before-after",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "t:labels.before_image"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "t:labels.after_image",
      "info": "t:labels.use_images_of_the_same_size"
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "t:labels.before_label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "t:labels.after_label",
      "default": "After"
    },
    {
      "type": "range",
      "id": "start",
      "label": "t:labels.starting_position",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "See the difference"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "t:labels.note",
      "info": "t:text.sections.before_after.settings.disclaimer.info"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "text-start",
          "label": "t:labels.text_first"
        },
        {
          "value": "text-end",
          "label": "t:labels.text_last"
        },
        {
          "value": "stacked",
          "label": "t:labels.text_above"
        }
      ],
      "default": "text-start"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:labels.before_and_after",
      "category": "t:labels.media"
    }
  ]
}
{% endschema %}
