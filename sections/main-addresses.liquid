{%- comment -%} Classic customer accounts: addresses with add, edit and delete. Forms open in <details>, so they work without JavaScript; addresses.js fills the province list for the chosen country. {%- endcomment -%}
{{ 'section-content.css' | asset_url | stylesheet_tag }}
<div class="section account color-{{ section.settings.color_scheme }}">
  <div class="page-width stack" data-module="{{ 'addresses.js' | asset_url }}" data-load="idle">
    <a class="link" href="{{ routes.account_url }}">{{ 'customer.account.back' | t }}</a>
    <h1 class="h2">{{ 'customer.addresses.title' | t }}</h1>
    <details class="account__add"{% if customer.addresses_count == 0 %} open{% endif %}>
      <summary class="button button--secondary">{{ 'customer.addresses.add' | t }}</summary>
      {%- form 'customer_address', customer.new_address -%}
        {%- render 'address-form', form: form, prefix: 'new' -%}
      {%- endform -%}
    </details>
    {%- paginate customer.addresses by 10 -%}
      <ul class="address-list" role="list">
        {%- for address in customer.addresses -%}
          <li class="address-card stack">
            {%- if address == customer.default_address -%}<p class="chip">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
            {{ address | format_address }}
            <details>
              <summary class="link">{{ 'customer.addresses.edit' | t }}</summary>
              {%- form 'customer_address', address -%}
                {%- render 'address-form', form: form, prefix: address.id -%}
              {%- endform -%}
            </details>
            <form method="post" action="{{ address.url }}" class="address-card__delete">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="link">{{ 'customer.addresses.delete' | t }}</button>
            </form>
          </li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:labels.addresses",
  "class": "section-main-addresses",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
