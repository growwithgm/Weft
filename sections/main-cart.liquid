{%- comment -%}
  Cart page (brief §7.13): title, wholesale "Ordering for" line, the same cart lines and summary
  as the drawer (snippets cart-line / cart-summary), continue shopping, shipping calculator and
  app blocks. Re-rendered through the Cart API `sections` parameter (data-cart-section), so the
  page, the drawer and the header count stay in step. Without JavaScript the form posts
  updates[] to /cart (Update button) and checkout submits normally.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign wholesale = false
  if customer and customer.b2b?
    assign wholesale = true
  endif
  capture invalid_count
    render 'cart-invalid-count'
  endcapture
  assign invalid_count = invalid_count | strip | plus: 0
  assign continue_url = s.continue_shopping_page | default: settings.cart_empty_link | default: routes.all_products_collection_url
  assign multi_location = false
  if wholesale and customer.company_available_locations.size > 1
    assign multi_location = true
  endif
-%}
{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{%- if settings.cart_recommendations and cart.item_count > 0 -%}{{ 'component-card.css' | asset_url | stylesheet_tag }}{%- endif -%}
<div class="section cart-page color-{{ s.color_scheme }}" data-cart-section="{{ section.id }}" data-module="{{ 'cart.js' | asset_url }}" data-load="idle">
  <div class="page-width">
    <div class="cart-page__head cart-page__head--{{ s.heading_align }}">
      {%- if s.show_page_title -%}
        <h1 class="h2 cart-page__title">{%- if cart.item_count > 0 -%}{{ 'cart.title_count' | t: count: cart.item_count }}{%- else -%}{{ 'cart.title' | t }}{%- endif -%}</h1>
      {%- endif -%}
      {%- if wholesale -%}
        <p class="cart-page__company">
          {{ 'wholesale.ordering_for_location' | t: company: customer.current_company.name, location: customer.current_location.name }}
          {%- if multi_location %} <button type="button" class="link" data-open-dialog="LocationSheet">{{ 'wholesale.change' | t }}</button>{%- endif -%}
        </p>
      {%- endif -%}
      {%- if cart.item_count > 0 -%}<a class="link cart-page__continue" href="{{ continue_url }}">{{ 'general.continue_shopping' | t }}</a>{%- endif -%}
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="cart-empty cart-page__empty stack">
        {%- if wholesale -%}
          <p class="cart-empty__title h4">{{ 'wholesale.empty_cart' | t }}</p>
          <a class="button" href="{{ continue_url }}">{{ 'wholesale.browse_catalogue' | t }}</a>
          {%- if settings.wholesale_quick_order_page != blank -%}<a class="link" href="{{ settings.wholesale_quick_order_page.url }}">{{ 'wholesale.quick_order' | t }}</a>{%- endif -%}
        {%- else -%}
          <p class="cart-empty__title h4">{{ 'cart.empty' | t }}</p>
          <a class="button" href="{{ continue_url }}">{{ 'general.continue_shopping' | t }}</a>
        {%- endif -%}
        {%- if shop.customer_accounts_enabled and customer == nil -%}
          <p class="muted">{{ 'cart.have_account' | t }} <a class="link" href="{{ routes.account_login_url }}">{{ 'header.sign_in' | t }}</a></p>
        {%- endif -%}
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" class="cart-page__layout" data-cart-page novalidate>
        <div class="cart-page__lines">
          <div class="cart-page__labels" aria-hidden="true">
            <span>{{ 'cart.product' | t }}</span>
            <span>{{ 'cart.quantity' | t }}</span>
            <span>{{ 'cart.total' | t }}</span>
          </div>
          <ul class="cart-lines cart-lines--page" role="list">
            {%- for item in cart.items -%}
              {%- render 'cart-line', item: item, index: forloop.index, wholesale: wholesale, context: 'page', show_vendor: s.show_vendor, show_backorder: s.show_backorder_note -%}
            {%- endfor -%}
          </ul>
          <noscript><button type="submit" name="update" class="button button--secondary cart-page__update">{{ 'cart.update' | t }}</button></noscript>
          {%- if section.blocks.size > 0 -%}<div class="cart-page__app">{%- content_for 'blocks' -%}</div>{%- endif -%}
        </div>
        <div class="cart-page__aside">
          <div class="cart-page__summary">
            {%- if settings.cart_free_shipping_bar and wholesale == false -%}{%- render 'free-shipping-bar' -%}{%- endif -%}
            {%- render 'cart-summary', wholesale: wholesale, invalid_count: invalid_count, form_id: 'CartPageForm', show_note: s.show_order_note, show_tax_note: s.show_tax_note, show_accelerated: s.show_accelerated, show_checkout: true, terms_page: s.terms_page, context: 'page' -%}
          </div>
          {%- if s.show_shipping_calculator and cart.requires_shipping -%}
            {%- render 'shipping-calculator', default_country: s.shipping_default_country -%}
          {%- endif -%}
        </div>
      </form>
      {%- if settings.cart_recommendations and wholesale == false -%}
        {%- comment -%} Theme settings > Cart > Show related products: Shopify renders sections/cart-recommendations for the first line. {%- endcomment -%}
        <recommendation-list
          class="cart-recommendations cart-recommendations--{{ settings.cart_recommendations_layout }}"
          data-recommendations="cart"
          data-url="{{ routes.product_recommendations_url }}?section_id=cart-recommendations&product_id={{ cart.items.first.product_id }}&limit={{ settings.cart_recommendations_limit }}&intent=related"
          data-module="{{ 'recommendations.js' | asset_url }}"
          data-load="visible"
        ></recommendation-list>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:labels.cart",
  "class": "section-main-cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_page_title",
      "label": "t:labels.show_page_title",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "t:labels.heading_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:labels.show_vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_backorder_note",
      "label": "t:labels.show_backorder_note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "t:labels.show_order_note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tax_note",
      "label": "t:labels.show_tax_and_shipping_note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_accelerated",
      "label": "t:labels.show_accelerated_checkout_buttons",
      "default": true,
      "info": "t:labels.retail_shoppers_only"
    },
    {
      "type": "url",
      "id": "terms_page",
      "label": "t:labels.terms_and_conditions_link",
      "info": "t:text.sections.main_cart.settings.terms_page.info"
    },
    {
      "type": "url",
      "id": "continue_shopping_page",
      "label": "t:labels.continue_shopping_link"
    },
    {
      "type": "header",
      "content": "t:labels.shipping_calculator"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_calculator",
      "label": "t:labels.show_shipping_calculator",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_default_country",
      "label": "t:labels.default_country",
      "info": "t:text.sections.main_cart.settings.shipping_default_country.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "custom-liquid"
    }
  ]
}
{% endschema %}
