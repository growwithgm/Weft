{%- comment -%}
  Specifications (live "Main features"): label/value rows whose values accept dynamic sources
  (metafields such as fabric, materials, hair type or volume). Rows without a value are hidden.
  Optionally shown as an accordion.
{%- endcomment -%}
{%- capture rows -%}{%- content_for 'blocks' -%}{%- endcapture -%}
{%- capture visible -%}{% render 'audience-check', audience: block.settings.audience %}{%- endcapture -%}
{%- if visible == '1' -%}
  {%- if block.settings.accordion -%}
    <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
      <summary class="accordion__summary">
        <span>{{ block.settings.heading }}</span>{%- render 'accordion-icon' -%}
      </summary>
      <div class="accordion__content"><dl class="spec-list">{{ rows }}</dl></div>
    </details>
  {%- else -%}
    <div class="specifications" {{ block.shopify_attributes }}>
      {%- if block.settings.heading != blank -%}<h2 class="specifications__heading h4">{{ block.settings.heading }}</h2>{%- endif -%}
      <dl class="spec-list">{{ rows }}</dl>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:labels.specifications",
  "tag": null,
  "blocks": [
    {
      "type": "_spec-row"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Main features"
    },
    {
      "type": "checkbox",
      "id": "accordion",
      "label": "t:labels.show_as_accordion",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open",
      "label": "t:labels.open_by_default",
      "default": false,
      "visible_if": "{{ block.settings.accordion }}"
    },
    {
      "type": "select",
      "id": "audience",
      "label": "t:labels.show_to",
      "options": [
        {
          "value": "all",
          "label": "t:labels.everyone"
        },
        {
          "value": "retail",
          "label": "t:labels.retail_shoppers"
        },
        {
          "value": "wholesale",
          "label": "t:labels.wholesale_buyers"
        }
      ],
      "default": "all"
    }
  ],
  "presets": [
    {
      "name": "t:labels.specifications",
      "category": "t:labels.product",
      "blocks": [
        {
          "type": "_spec-row",
          "settings": {
            "label": "Material"
          }
        },
        {
          "type": "_spec-row",
          "settings": {
            "label": "Care"
          }
        }
      ]
    }
  ]
}
{% endschema %}
