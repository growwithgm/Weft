{%- comment -%}
  Ingredients (VERTICALS §3–4): key ingredients with a short explanation each, then the full
  list (INCI for cosmetics, materials for clothing) in a collapsible row. The full list accepts
  dynamic sources.
{%- endcomment -%}
{%- assign b = block.settings -%}
<div class="ingredients stack" {{ block.shopify_attributes }}>
  {%- if b.heading != blank -%}<p class="h5 ingredients__heading">{{ b.heading | escape }}</p>{%- endif -%}
  <ul class="ingredients__list" role="list">{%- content_for 'blocks' -%}</ul>
  {%- if b.full_list != blank -%}
    <details class="accordion ingredients__full"{% if b.open_full_list %} open{% endif %}>
      <summary class="accordion__summary"><span>{{ b.full_list_label | escape }}</span>{%- render 'accordion-icon' -%}</summary>
      <div class="accordion__content rte ingredients__inci">{{ b.full_list }}</div>
    </details>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "t:labels.ingredients",
  "tag": null,
  "blocks": [
    {
      "type": "_ingredient"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Key ingredients"
    },
    {
      "type": "text",
      "id": "full_list_label",
      "label": "t:labels.full_list_label",
      "default": "Full ingredient list (INCI)"
    },
    {
      "type": "richtext",
      "id": "full_list",
      "label": "t:labels.full_list",
      "info": "t:text.blocks.ingredients.settings.full_list.info"
    },
    {
      "type": "checkbox",
      "id": "open_full_list",
      "label": "t:labels.open_the_full_list",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:labels.ingredients",
      "category": "t:labels.product",
      "blocks": [
        {
          "type": "_ingredient"
        },
        {
          "type": "_ingredient",
          "settings": {
            "name": "Aloe vera",
            "text": "Soothes and hydrates."
          }
        }
      ]
    }
  ]
}
{% endschema %}
