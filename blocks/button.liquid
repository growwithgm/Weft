{%- liquid
  assign label = block.settings.label
  assign url = block.settings.link
-%}
{%- if label != blank -%}
  <a
    class="button button--{{ block.settings.style }}{% if block.settings.full_width %} button--full{% endif %} block-button"
    {% if url != blank %}href="{{ url }}"{% else %}role="link" aria-disabled="true"{% endif %}
    {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %}
    {{ block.shopify_attributes }}
  >
    {{- label -}}
    {%- if block.settings.new_tab -%}<span class="visually-hidden"> ({{ 'general.opens_new_window' | t }})</span>{%- endif -%}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "t:labels.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "checkbox",
      "id": "new_tab",
      "label": "t:labels.open_in_a_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:labels.style",
      "options": [
        {
          "value": "primary",
          "label": "t:labels.primary"
        },
        {
          "value": "secondary",
          "label": "t:labels.secondary"
        },
        {
          "value": "tertiary",
          "label": "t:labels.link"
        }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:labels.full_width",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:labels.button"
    },
    {
      "name": "t:labels.view_more",
      "settings": {
        "label": "View more",
        "style": "tertiary"
      }
    }
  ]
}
{% endschema %}
