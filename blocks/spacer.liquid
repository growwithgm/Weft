<div class="block-spacer" style="--spacer-mobile: {{ block.settings.height_mobile }}px; --spacer: {{ block.settings.height }}px" aria-hidden="true" {{ block.shopify_attributes }}></div>

{% schema %}
{
  "name": "t:labels.spacer",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "height",
      "label": "t:labels.height_on_large_screens",
      "min": 4,
      "max": 200,
      "step": 4,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "t:labels.height_on_mobile",
      "min": 4,
      "max": 200,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:labels.spacer"
    }
  ]
}
{% endschema %}
