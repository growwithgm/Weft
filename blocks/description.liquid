{%- comment -%}
  Product description, optionally in an accordion, clamped to about N characters with See more /
  See less (brief §5). The full text stays in the DOM; the clamp is visual and keyboard friendly.
{%- endcomment -%}
{%- liquid
  assign p = closest.product
  assign text = p.description
  assign plain = text | strip_html | strip
  assign clamp = false
  if block.settings.clamp_chars > 0 and plain.size > block.settings.clamp_chars
    assign clamp = true
  endif
  assign lines = block.settings.clamp_chars | divided_by: 60 | at_least: 2
-%}
{%- if plain != blank -%}
  {%- capture body -%}
    <div class="description{% if clamp %} description--clamped{% endif %}" {% if clamp %}style="--clamp-lines: {{ lines }}" data-clamp{% endif %}>
      <div class="description__text rte" {% if clamp %}id="Description-{{ block.id }}"{% endif %}>{{ text }}</div>
      {%- if clamp -%}
        <button type="button" class="link description__more js-only" aria-expanded="false" aria-controls="Description-{{ block.id }}" data-more="{{ 'general.see_more' | t | escape }}" data-less="{{ 'general.see_less' | t | escape }}" onclick="const d=this.closest('[data-clamp]');const o=d.classList.toggle('is-open');this.setAttribute('aria-expanded',o);this.textContent=o?this.dataset.less:this.dataset.more;">{{ 'general.see_more' | t }}</button>
      {%- endif -%}
    </div>
  {%- endcapture -%}
  {%- if block.settings.accordion -%}
    <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
      <summary class="accordion__summary">
        <span>{% if block.settings.heading != blank %}{{ block.settings.heading }}{% else %}{{ 'products.description' | t }}{% endif %}</span>
        {%- render 'accordion-icon' -%}
      </summary>
      <div class="accordion__content">{{ body }}</div>
    </details>
  {%- else -%}
    <div class="product-description" {{ block.shopify_attributes }}>{{ body }}</div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:labels.description",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "accordion",
      "label": "t:labels.show_as_accordion",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:text.blocks.description.settings.heading.info",
      "visible_if": "{{ block.settings.accordion }}"
    },
    {
      "type": "checkbox",
      "id": "open",
      "label": "t:labels.open_by_default",
      "default": true,
      "visible_if": "{{ block.settings.accordion }}"
    },
    {
      "type": "range",
      "id": "clamp_chars",
      "label": "t:labels.shorten_to_about",
      "min": 0,
      "max": 600,
      "step": 50,
      "default": 200,
      "unit": "ch",
      "info": "t:text.blocks.description.settings.clamp_chars.info"
    }
  ],
  "presets": [
    {
      "name": "t:labels.description",
      "category": "t:labels.product"
    }
  ]
}
{% endschema %}
