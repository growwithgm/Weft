{%- comment -%} Multi-column item: optional image or video, heading, text, link. {%- endcomment -%}
{%- liquid
  assign b = block.settings
  assign ss = section.settings
  assign cols = ss.columns | default: 3
  assign col_sizes = '(min-width: 990px) calc(100vw / ' | append: cols | append: '), (min-width: 750px) 50vw, 85vw'
-%}
<li class="column column--{{ ss.column_align }}" {{ block.shopify_attributes }}>
  {%- if b.enable_media -%}
    <div class="column__media media media--{{ ss.image_ratio }} column__media--{{ ss.media_align }}" style="--media-scale: {{ b.media_scale | divided_by: 100.0 }}">
      {%- if b.video != blank -%}
        {%- render 'deferred-video', video: b.video, poster: b.image, description: b.heading, sizes: col_sizes -%}
      {%- elsif b.image -%}
        {%- render 'image', image: b.image, sizes: col_sizes, widths: '240,360,480,640,800,960' -%}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="column__body stack">
    {%- if b.heading != blank -%}<h3 class="h4 column__heading">{{ b.heading | escape }}</h3>{%- endif -%}
    {%- if b.text != blank -%}<div class="rte column__text">{{ b.text }}</div>{%- endif -%}
    {%- if b.button_label != blank -%}<a class="link column__link"{% if b.button_link != blank %} href="{{ b.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>{{ b.button_label | escape }}</a>{%- endif -%}
  </div>
</li>

{% schema %}
{
  "name": "t:labels.column",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_media",
      "label": "t:labels.show_media",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video"
    },
    {
      "type": "range",
      "id": "media_scale",
      "label": "t:labels.media_size",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Column"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Pair text with an image to focus on your product, collection or story.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.link_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.link"
    }
  ]
}
{% endschema %}
