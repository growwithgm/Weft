{%- comment -%} Product feature hotspot: a numbered dot that opens a card with image, heading and text. {%- endcomment -%}
{%- assign b = block.settings -%}
<details class="hotspot hotspot--feature" data-hotspot style="--x: {{ b.hotspot_x }}%; --y: {{ b.hotspot_y }}%;" {{ block.shopify_attributes }}>
  <summary class="hotspot__dot" aria-label="{{ b.heading | escape }}"><span aria-hidden="true"></span></summary>
  <div class="hotspot__card hotspot__card--{{ b.content_align }} stack">
    {%- if b.image -%}{{ b.image | image_url: width: 480 | image_tag: widths: '240,360,480', sizes: '240px', alt: '', loading: 'lazy', class: 'hotspot__image' }}{%- endif -%}
    {%- if b.heading != blank -%}<p class="hotspot__heading">{{ b.heading | escape }}</p>{%- endif -%}
    {%- if b.text != blank -%}<div class="rte hotspot__text">{{ b.text }}</div>{%- endif -%}
  </div>
</details>

{% schema %}
{
  "name": "t:labels.feature",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Feature"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Describe a detail of the product.</p>"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "t:labels.text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "hotspot_x",
      "label": "t:labels.horizontal_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "hotspot_y",
      "label": "t:labels.vertical_position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    }
  ]
}
{% endschema %}
