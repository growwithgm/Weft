{%- comment -%} Media grid tile: media with subheading, heading and a button. {%- endcomment -%}
{%- liquid
  assign b = block.settings
  assign tile_sizes = '(min-width: 990px) 50vw, 100vw'
-%}
<li class="mosaic__tile banner banner--{{ b.overlay_position }} banner--text-{{ b.text_align }}" style="--col: {{ b.columns }}; --row: {{ b.rows }}; --banner-text: {{ b.text_color }}; --banner-tint: {{ b.tint_color }}; --banner-tint-opacity: {{ b.tint_opacity | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
  <div class="banner__media">
    {%- if b.video != blank -%}
      {%- render 'deferred-video', video: b.video, poster: b.image, background: true, sizes: tile_sizes -%}
    {%- elsif b.image -%}
      {%- render 'image', image: b.image, sizes: tile_sizes, widths: '375,550,750,1100,1500', class: 'banner__image' -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'banner__image placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="banner__content">
    <div class="banner__box stack mosaic__text">
      {%- if b.subheading != blank -%}<p class="mosaic__subheading">{{ b.subheading | escape }}</p>{%- endif -%}
      {%- if b.title != blank -%}<div class="mosaic__line mosaic__line--{{ b.heading_size }} mosaic__title">{{ b.title }}</div>{%- endif -%}
      {%- if b.button_label != blank -%}
        <a class="{% if b.button_style == 'link' %}link{% else %}button button--{{ b.button_style }}{% endif %} mosaic__button"{% if b.link != blank %} href="{{ b.link }}"{% else %} role="link" aria-disabled="true"{% endif %}>{{ b.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
  {%- if b.link != blank and b.button_label == blank -%}<a class="banner__link mosaic__link" href="{{ b.link }}"><span class="visually-hidden">{{ b.title | strip_html | default: b.subheading | escape }}</span></a>{%- endif -%}
</li>

{% schema %}
{
  "name": "t:labels.media",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video",
      "info": "t:labels.plays_muted_in_a_loop_instead_of_the_image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_to_span",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "rows",
      "label": "t:labels.rows_to_span",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "t:labels.heading",
      "default": "<p>Media tile</p>"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:labels.heading_size",
      "options": [
        {
          "value": "small",
          "label": "t:labels.small"
        },
        {
          "value": "medium",
          "label": "t:labels.medium"
        },
        {
          "value": "large",
          "label": "t:labels.large"
        },
        {
          "value": "xlarge",
          "label": "t:labels.extra_large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:labels.button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:labels.primary"
        },
        {
          "value": "secondary",
          "label": "t:labels.secondary"
        },
        {
          "value": "link",
          "label": "t:labels.link"
        }
      ],
      "default": "secondary"
    },
    {
      "type": "select",
      "id": "overlay_position",
      "label": "t:labels.text_position",
      "options": [
        {
          "value": "top-start",
          "label": "t:labels.top_start"
        },
        {
          "value": "top-center",
          "label": "t:labels.top_center"
        },
        {
          "value": "top-end",
          "label": "t:labels.top_end"
        },
        {
          "value": "middle-start",
          "label": "t:labels.middle_start"
        },
        {
          "value": "middle-center",
          "label": "t:labels.middle_center"
        },
        {
          "value": "middle-end",
          "label": "t:labels.middle_end"
        },
        {
          "value": "bottom-start",
          "label": "t:labels.bottom_start"
        },
        {
          "value": "bottom-center",
          "label": "t:labels.bottom_center"
        },
        {
          "value": "bottom-end",
          "label": "t:labels.bottom_end"
        }
      ],
      "default": "bottom-start"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:labels.text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        },
        {
          "value": "end",
          "label": "t:labels.end"
        }
      ],
      "default": "start"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "tint_color",
      "label": "t:labels.image_tint",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "tint_opacity",
      "label": "t:labels.image_tint_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 20
    }
  ]
}
{% endschema %}
