{%- comment -%} Promo grid tile: media with up to three lines of text, optional circle badge and link. {%- endcomment -%}
{%- liquid
  assign b = block.settings
  assign tile_sizes = '(min-width: 990px) 50vw, 100vw'
-%}
<li class="mosaic__tile banner banner--{{ b.overlay_position }} banner--text-{{ b.text_align }}" style="--col: {{ b.columns }}; --row: {{ b.rows }}; --banner-text: {{ b.text_color }}; --banner-tint: {{ b.tint_color }}; --banner-tint-opacity: {{ b.tint_opacity | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
  <div class="banner__media">
    {%- if b.video != blank -%}
      {%- render 'deferred-video', video: b.video, poster: b.image, background: true, sizes: tile_sizes -%}
    {%- elsif b.image -%}
      {%- render 'image', image: b.image, sizes: tile_sizes, widths: '375,550,750,1100,1500', class: 'banner__image' -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'banner__image placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="banner__content">
    <div class="banner__box mosaic__text{% if b.promo_circle %} mosaic__circle{% endif %}"{% if b.promo_circle %} style="--circle-bg: {{ b.circle_bg }}; --circle-fg: {{ b.circle_text }};"{% endif %}>
      {%- if b.subheading != blank -%}<p class="mosaic__subheading">{{ b.subheading | escape }}</p>{%- endif -%}
      {%- if b.line1 != blank -%}<p class="mosaic__line mosaic__line--{{ b.line1_size }}">{{ b.line1 | escape }}</p>{%- endif -%}
      {%- if b.line2 != blank -%}<p class="mosaic__line mosaic__line--{{ b.line2_size }}">{{ b.line2 | escape }}</p>{%- endif -%}
      {%- if b.line3 != blank -%}<p class="mosaic__line mosaic__line--{{ b.line3_size }}">{{ b.line3 | escape }}</p>{%- endif -%}
      {%- if b.link_text != blank -%}<span class="mosaic__link-text">{{ b.link_text | escape }}</span>{%- endif -%}
    </div>
  </div>
  {%- if b.link != blank -%}<a class="banner__link mosaic__link" href="{{ b.link }}"><span class="visually-hidden">{{ b.line1 | default: b.link_text | default: b.subheading | escape }}</span></a>{%- endif -%}
</li>

{% schema %}
{
  "name": "t:labels.media",
  "tag": null,
