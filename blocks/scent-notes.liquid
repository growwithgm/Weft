{%- comment -%}
  Scent notes (VERTICALS §4): top, heart and base notes in three columns. Each setting takes a
  comma-separated list and accepts dynamic sources (for example a text metafield).
{%- endcomment -%}
{%- assign b = block.settings -%}
{%- if b.top != blank or b.heart != blank or b.base != blank -%}
  <div class="scent-notes" {{ block.shopify_attributes }}>
    {%- if b.heading != blank -%}<p class="h5 scent-notes__heading">{{ b.heading | escape }}</p>{%- endif -%}
    <dl class="scent-notes__list">
      {%- for group in (1..3) -%}
        {%- case group -%}
          {%- when 1 -%}{%- assign value = b.top -%}{%- assign label = 'products.scent.top' | t -%}
          {%- when 2 -%}{%- assign value = b.heart -%}{%- assign label = 'products.scent.heart' | t -%}
          {%- else -%}{%- assign value = b.base -%}{%- assign label = 'products.scent.base' | t -%}
        {%- endcase -%}
        {%- if value != blank -%}
          {%- assign notes = value | split: ',' -%}
          <div class="scent-notes__group">
            <dt class="scent-notes__label">{{ label }}</dt>
            {%- for n in notes -%}{%- assign note = n | strip -%}{%- if note != blank -%}<dd class="scent-notes__note">{{ note | escape }}</dd>{%- endif -%}{%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>
  </div>
{%- elsif request.design_mode -%}
  <p class="muted" {{ block.shopify_attributes }}>{{ b.heading }}</p>
{%- endif -%}
{% schema %}
{
  "name": "t:labels.scent_notes",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Scent notes"
    },
    {
      "type": "text",
      "id": "top",
      "label": "t:labels.top_notes",
      "default": "Bergamot, Pink pepper",
      "info": "t:labels.separate_notes_with_commas"
    },
    {
      "type": "text",
      "id": "heart",
      "label": "t:labels.heart_notes",
      "default": "Orange blossom, Jasmine",
      "info": "t:labels.separate_notes_with_commas"
    },
    {
      "type": "text",
      "id": "base",
      "label": "t:labels.base_notes",
      "default": "Vanilla, Sandalwood",
      "info": "t:labels.separate_notes_with_commas"
    }
  ],
  "presets": [
    {
      "name": "t:labels.scent_notes",
      "category": "t:labels.product"
    }
  ]
}
{% endschema %}
