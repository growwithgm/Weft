{%- comment -%} Icons with text item: theme icon or custom image, heading, text, optional link. {%- endcomment -%}
{%- liquid
  assign b = block.settings
  assign size = section.settings.icon_size | default: 32
-%}
<li class="icon-item" {{ block.shopify_attributes }}>
  <span class="icon-item__icon" style="--icon-size: {{ size }}px" aria-hidden="true">
    {%- if b.custom_icon -%}
      {{ b.custom_icon | image_url: width: 160 | image_tag: width: size, height: size, alt: '', loading: 'lazy' }}
    {%- else -%}
      {%- render 'icon', name: b.icon, size: size -%}
    {%- endif -%}
  </span>
  <div class="icon-item__body">
    {%- if b.heading != blank -%}
      <p class="icon-item__heading">{%- if b.link != blank -%}<a href="{{ b.link }}">{{ b.heading | escape }}</a>{%- else -%}{{ b.heading | escape }}{%- endif -%}</p>
    {%- endif -%}
    {%- if b.text != blank -%}<div class="rte icon-item__text">{{ b.text }}</div>{%- endif -%}
  </div>
</li>

{% schema %}
{
  "name": "t:labels.item",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:labels.icon",
      "options": [
        {
          "value": "truck",
          "label": "t:labels.delivery"
        },
        {
          "value": "return",
          "label": "t:labels.returns"
        },
        {
          "value": "lock",
          "label": "t:labels.secure_payment"
        },
        {
          "value": "chat",
          "label": "t:labels.chat"
        },
        {
          "value": "store",
          "label": "t:labels.store"
        },
        {
          "value": "globe",
          "label": "t:labels.worldwide"
        },
        {
          "value": "tag",
          "label": "t:labels.price_tag"
        },
        {
          "value": "percent",
          "label": "t:labels.discount"
        },
        {
          "value": "clock",
          "label": "t:labels.clock"
        },
        {
          "value": "star",
          "label": "t:labels.star"
        },
        {
          "value": "check",
          "label": "t:labels.check_mark"
        },
        {
          "value": "sparkle",
          "label": "t:labels.sparkle"
        },
        {
          "value": "leaf",
          "label": "t:labels.leaf"
        },
        {
          "value": "drop",
          "label": "t:labels.drop"
        },
        {
          "value": "jar",
          "label": "t:labels.jar"
        },
        {
          "value": "ruler",
          "label": "t:labels.ruler"
        },
        {
          "value": "pin",
          "label": "t:labels.location"
        },
        {
          "value": "bell",
          "label": "t:labels.bell"
        },
        {
          "value": "info",
          "label": "t:labels.information"
        }
      ],
      "default": "truck"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "t:labels.custom_icon",
      "info": "t:labels.replaces_the_icon_above"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Free delivery"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>On orders over a set amount.</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ]
}
{% endschema %}
