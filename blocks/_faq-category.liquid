{%- comment -%} FAQ category heading between questions. {%- endcomment -%}
<h3 class="h4 faq__category" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h3>

{% schema %}
{
  "name": "t:labels.category",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.heading",
      "default": "Orders and delivery"
    }
  ]
}
{% endschema %}
