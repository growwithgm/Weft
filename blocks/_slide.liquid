{%- comment -%}
  One slide of the slideshow section: desktop and mobile images, optional link, text box with
  heading / text / buttons / countdown blocks, placed with overlay position and alignment.
  The first slide of the first section loads eagerly (LCP).
{%- endcomment -%}
{%- liquid
  assign b = block.settings
  assign img = b.image_desktop
  assign first_slide = section.blocks | first
  assign eager = false
  if section.index == 1 and first_slide.id == block.id
    assign eager = true
  endif
-%}
<div class="slideshow__slide slide banner banner--{{ section.settings.height }}{% if section.settings.mobile_stacked %} banner--stack-mobile{% endif %} banner--{{ b.overlay_position }} banner--text-{{ b.text_align }}{% if b.mobile_center %} banner--mobile-center{% endif %}" data-slide role="group" aria-roledescription="{{ 'accessibility.slide' | t }}" {{ block.shopify_attributes }}>
  <div class="banner__media">
    {%- if img -%}
      {%- if b.image_mobile != blank -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ b.image_mobile | image_url: width: 750 }} 750w, {{ b.image_mobile | image_url: width: 1100 }} 1100w, {{ b.image_mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
          {%- render 'image', image: img, sizes: '100vw', eager: eager, class: 'banner__image' -%}
        </picture>
      {%- else -%}
        {%- render 'image', image: img, sizes: '100vw', eager: eager, class: 'banner__image' -%}
      {%- endif -%}
    {%- else -%}
      {{ 'hero-apparel-2' | placeholder_svg_tag: 'banner__image placeholder-svg' }}
    {%- endif -%}
  </div>
  {%- if block.blocks.size > 0 -%}
    <div class="banner__content">
      <div class="banner__box stack">{%- content_for 'blocks' -%}</div>
    </div>
  {%- endif -%}
  {%- if b.link != blank -%}
    <a class="banner__link" href="{{ b.link }}" tabindex="-1" aria-hidden="true"></a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:labels.slide",
  "tag": null,
  "blocks": [
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "product-countdown"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:labels.mobile_image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.slide_link",
      "info": "t:text.blocks.slide.settings.link.info"
    },
    {
      "type": "select",
      "id": "overlay_position",
      "label": "t:labels.content_position",
      "options": [
        {
          "value": "top-start",
          "label": "t:labels.top_start"
        },
        {
          "value": "top-center",
          "label": "t:labels.top_center"
        },
        {
          "value": "top-end",
          "label": "t:labels.top_end"
        },
        {
          "value": "middle-start",
          "label": "t:labels.middle_start"
        },
        {
          "value": "middle-center",
          "label": "t:labels.middle_center"
        },
        {
          "value": "middle-end",
          "label": "t:labels.middle_end"
        },
        {
          "value": "bottom-start",
          "label": "t:labels.bottom_start"
        },
        {
          "value": "bottom-center",
          "label": "t:labels.bottom_center"
        },
        {
          "value": "bottom-end",
          "label": "t:labels.bottom_end"
        }
      ],
      "default": "middle-center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:labels.text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:labels.start"
        },
        {
          "value": "center",
          "label": "t:labels.center"
        },
        {
          "value": "end",
          "label": "t:labels.end"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "mobile_center",
      "label": "t:labels.center_text_on_mobile",
      "default": true
    }
  ]
}
{% endschema %}
