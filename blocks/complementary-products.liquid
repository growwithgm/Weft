{%- comment -%}
  Complementary products from Shopify's product recommendations (intent: complementary).
  Loaded after first paint through the recommendations endpoint rendering this section.
  Heading per preset: "Complete the look / routine / ritual".
{%- endcomment -%}
{%- liquid
  assign p = closest.product
-%}
<recommendation-list
  class="complementary"
  data-complementary="{{ block.id }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ p.id }}&limit={{ block.settings.limit }}&intent=complementary"
  data-module="{{ 'recommendations.js' | asset_url }}"
  data-load="visible"
  {{ block.shopify_attributes }}
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <h2 class="complementary__heading h4">{% if block.settings.heading != blank %}{{ block.settings.heading }}{% else %}{{ 'products.recommendations.complementary' | t }}{% endif %}</h2>
    <ul class="complementary__list complementary__list--{{ block.settings.layout }}" role="list">
      {%- for rec in recommendations.products limit: block.settings.limit -%}
        <li>{%- render 'product-card-mini', product: rec, index: forloop.index, step_label: block.settings.step_labels -%}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</recommendation-list>

{% schema %}
{
  "name": "t:labels.complementary_products",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:text.blocks.complementary_products.settings.pick_complementary_products_in_the_search_and_di.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:text.blocks.complementary_products.settings.heading.info"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:labels.maximum_products",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        {
          "value": "list",
          "label": "t:labels.list"
        },
        {
          "value": "row",
          "label": "t:labels.row"
        }
      ],
      "default": "list"
    },
    {
      "type": "checkbox",
      "id": "step_labels",
      "label": "t:labels.number_the_products_as_steps",
      "default": false,
      "info": "t:labels.useful_for_routines_step_1_step_2"
    }
  ],
  "presets": [
    {
      "name": "t:labels.complementary_products",
      "category": "t:labels.product"
    }
  ]
}
{% endschema %}
