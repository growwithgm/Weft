{%- comment -%} One routine step: label, heading, text and an optional product with quick add. {%- endcomment -%}
{%- assign b = block.settings -%}
<li class="routine__step" {{ block.shopify_attributes }}>
  <p class="routine__label">{{ b.label | escape }}</p>
  {%- if b.heading != blank -%}<p class="h4 routine__heading">{{ b.heading | escape }}</p>{%- endif -%}
  {%- if b.text != blank -%}<div class="rte routine__text">{{ b.text }}</div>{%- endif -%}
  {%- if b.product != blank -%}
    <div class="routine__product">{%- render 'product-card-mini', product: b.product -%}</div>
  {%- endif -%}
</li>
{% schema %}
{
  "name": "t:labels.step",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.step_label",
      "default": "Step 1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Cleanse"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:labels.product"
    }
  ]
}
{% endschema %}
