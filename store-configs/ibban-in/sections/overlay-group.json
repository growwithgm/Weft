        "text": {
          "type": "text",
          "disabled": true,
          "settings": {
            "text": "<p>Hurry! Offers end soon.</p>",
            "style": "large"
          }
        },
        "countdown": {
          "type": "product-countdown",
          "disabled": true,
          "settings": {
            "end_date": "",
            "end_time": "",
            "end_text": "",
            "hide_on_end": true,
            "size": "small"
          }
        },
        "button": {
          "type": "button",
          "disabled": true,
          "settings": {
            "label": "Shop Flash Sale",
            "link": "",
            "style": "primary"
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "countdown",
        "button"
      ],
      "settings": {
        "trigger": "delay",
        "delay": 5,
        "guests_only": false,
        "show_on_mobile": true,
        "dismiss_days": 2,
        "position": "center",
        "text_align": "center",
        "width": "wide",
        "tint_opacity": 60,
        "color_scheme": "scheme-5"
      }
