{
  "type": "aside",
  "name": "Overlay group",
  "sections": {
    "cart-drawer": {
      "type": "cart-drawer",
      "settings": {
        "show_view_cart": true,
        "show_backorder_note": true,
        "show_vendor": false,
        "summary_position": "top",
        "sticky_footer": true,
        "show_order_note": true,
        "show_tax_note": false,
        "show_accelerated": true,
        "show_checkout": true,
        "terms_page": "",
