    "custom_code_head": "<style>\n  /* Newsletter phone field (added by the script below) */\n  .newsletter-form .phone-input-wrapper {\n    margin-top: 12px;\n  }\n\n  .newsletter-form .phone-input-wrapper input {\n    width: 100%;\n    box-sizing: border-box;\n  }\n</style>\n\n<script>\n  (function() {\n    function addPhoneFields() {\n      // Newsletter signups only: Shopify customer forms tagged \"newsletter\".\n      document.querySelectorAll('form').forEach(function(form) {\n        var tags = form.querySelector('input[name=\"contact[tags]\"]');\n        if (!tags || !/newsletter/i.test(tags.value)) return;\n        if (form.querySelector('input[type=\"tel\"]')) return;\n\n        var emailInput = form.querySelector('input[type=\"email\"]');\n        if (!emailInput) return;\n\n        var phoneWrapper = document.createElement('div');\n        phoneWrapper.className = 'phone-input-wrapper';\n\n        var phoneInput = document.createElement('input');\n        phoneInput.type = 'tel';\n        phoneInput.name = 'contact[phone]';\n        phoneInput.autocomplete = 'tel';\n        phoneInput.className = emailInput.className; // same look as the email field\n        phoneInput.placeholder = 'Phone number (optional)';\n        phoneInput.setAttribute('aria-label', 'Phone number (optional)');\n        phoneWrapper.appendChild(phoneInput);\n\n        // Below the email row (the email field shares its row with the Subscribe button).\n        var row = emailInput.closest('.newsletter-form__row') || emailInput;\n        row.after(phoneWrapper);\n      });\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', addPhoneFields);\n    } else {\n      addPhoneFields();\n    }\n  })();\n</script>",
