{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "product-labels": {
          "type": "product-labels",
          "settings": {}
        },
        "title": {
          "type": "product-title",
          "settings": {}
        },
        "rating": {
          "type": "product-rating",
          "settings": {}
        },
        "price": {
          "type": "product-price",
          "settings": {
            "show_tax_note": false
          }
        },
        "message": {
          "type": "flash-message",
          "settings": {
            "icon": "info",
            "text": "Coming Soon!<br>We're so excited about our upcoming releases that we just couldn't keep them under wraps anymore! Drop us your email in the box below, and we'll let you know when it's good to go :)",
            "close": "none",
            "over_media": false,
            "duration": 7,
            "bg_color": "#f5f5f5",
            "text_color": "#000000"
          }
        },
        "variant-picker": {
          "type": "variant-picker",
          "settings": {}
        },
        "divider-1": {
          "type": "divider",
          "settings": {
            "show_line": true,
            "spacing": "medium"
          }
        },
        "product-signup": {
          "type": "product-signup",
          "settings": {
            "heading": "",
            "text": "<p>Sign up to be the first to know when it's here</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {}
        }
      },
      "block_order": [
        "product-labels",
        "title",
        "rating",
        "price",
        "message",
        "variant-picker",
        "divider-1",
        "product-signup",
        "share"
      ],
      "settings": {
        "thumbnails": "both",
        "sticky_bar_mobile": true
      }
    },
    "video": {
      "type": "video",
      "blocks": {
        "video-heading": {
          "type": "heading",
          "settings": {
            "size": "h2",
            "tag": "auto"
          }
        },
        "video-text": {
          "type": "text",
          "settings": {
            "style": "large"
          }
        }
      },
      "block_order": [
        "video-heading",
        "video-text"
      ],
      "settings": {
        "layout": "background",
        "text_align": "center",
        "color_scheme": "scheme-1"
      }
    },
    "details": {
      "type": "product-details",
      "blocks": {
        "tabs": {
          "type": "product-tabs",
          "settings": {
            "style": "accordion",
            "show_description": true,
            "show_reviews": true,
            "show_specification": true,
            "spec_right_align": true,
            "spec_show_empty": false
          }
        }
      },
      "block_order": [
        "tabs"
      ],
      "settings": {}
    },
    "scrolling-banner": {
      "type": "scrolling-banner",
      "blocks": {
        "scrolling-banner-text-1": {
          "type": "_marquee-item",
          "settings": {
            "text": "Coming Soon!",
            "link": "",
            "font": "heading",
            "size": "large",
            "type": "text"
          }
        },
        "scrolling-banner-text-2": {
          "type": "_marquee-item",
          "settings": {
            "text": "Coming Soon!",
            "link": "",
            "font": "body",
            "size": "large",
            "type": "text"
          }
        }
      },
      "block_order": [
        "scrolling-banner-text-1",
        "scrolling-banner-text-2"
      ],
      "settings": {
        "height": "normal",
        "spacing": 60,
        "speed": 10,
        "direction": "left",
        "pausable": true,
        "color_scheme": "scheme-5",
        "dividers": false
      }
    },
    "newsletter": {
      "type": "newsletter",
      "blocks": {
        "newsletter-heading-1": {
          "type": "heading",
          "settings": {
            "heading": "Be the first to know!",
            "size": "h3"
          }
        },
        "newsletter-text-2": {
          "type": "text",
          "settings": {
            "text": "<p>Sign up for updates, and we'll let you know when it's arrived.</p>",
            "style": "body"
          }
        },
        "newsletter-form-3": {
          "type": "email-signup",
          "settings": {}
        }
      },
      "block_order": [
        "newsletter-heading-1",
        "newsletter-text-2",
        "newsletter-form-3"
      ],
      "settings": {}
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You may also like",
        "heading_align": "start",
        "layout": "carousel",
        "columns": 5,
        "limit": 8
      }
    }
  },
  "order": [
    "main",
    "video",
    "details",
    "scrolling-banner",
    "newsletter",
    "recommendations"
  ]
}
