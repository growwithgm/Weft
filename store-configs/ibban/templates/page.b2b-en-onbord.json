    "custom_liquid_JJY3bL": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<!-- ============================================================\n     ibBan — B2B / Wholesale · PART 1  (HYBRID: our design + Klaviyo embed form)\n     Fonts: Cormorant (headings) + Jost (body). B&W, matches theme.\n     FORM = Klaviyo embedded form (klaviyo-form-SvwukM) — submit/list/flow handled by Klaviyo.\n     PASTE into a Shopify \"Custom Liquid\" section (so the payment-icons Liquid renders).\n     Klaviyo's onsite script is already live on your site (your spin-wheel popup proves it),\n     so the form below will render. If it ever doesn't, uncomment the loader at the very bottom.\n     ============================================================ -->\n\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n\n/* Hide the theme's announcement + header/nav on THIS page only */\n[id^=\"shopify-section\"][id*=\"header\"],\n[id^=\"shopify-section\"][id*=\"announcement\"],\n.header-wrapper,\n.site-header,\nheader.header,\n.shopify-section-header,\n.announcement-bar {\n  display: none !important;\n}\n\n/* Hide any site-wide WhatsApp / floating chat widget on THIS page only */\n[id*=\"whatsapp\" i], [class*=\"whatsapp\" i],\n[class*=\"chaty\" i], [id*=\"chaty\" i],\n[class*=\"joinchat\" i], [id*=\"joinchat\" i],\n#tidio-chat, #tidio-chat-iframe,\n.floating-whatsapp, #floating-whatsapp, .floating-wa,\n.wa-chat-widget, #wa-widget, .whatsapp-chat-widget, #whatsapp-chat-widget,\n[class*=\"whatsapp-button\" i], [id*=\"whatsapp-button\" i],\niframe[src*=\"whatsapp\" i], iframe[title*=\"whatsapp\" i] {\n  display: none !important;\n}\n\n/* Remove the empty space the section/template adds above this page */\n.shopify-section:has(.ibo){padding-top:0!important;margin-top:0!important}\n.shopify-section:has(.ibo) > *{margin-top:0!important}\n\n.ibo,.ibo *{margin:0;padding:0;box-sizing:border-box}\n.ibo{\n  --bg:#FBFAF7; --paper:#FFFFFF; --ink:#141414; --muted:#6B6B6B; --line:rgba(0,0,0,.13);\n  --black:#111111; --soft:#F2F0EA; --cream:#F6F4EE;\n  --serif:'Cormorant',Georgia,serif; --sans:'Jost',-apple-system,sans-serif;\n  font-family:var(--sans); color:var(--ink); background:var(--bg);\n  font-size:16px; line-height:1.6; -webkit-font-smoothing:antialiased; overflow-x:hidden;\n}\n.ibo img{display:block;max-width:100%}\n.ibo a{color:inherit;text-decoration:none}\n.ibo .wrap{max-width:1140px;margin:0 auto;padding:0 22px}\n.ibo .eyebrow{font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:var(--muted);font-weight:500}\n\n/* LOGO HEADER (this page only) */\n.ibo .ibhead{display:flex;align-items:center;justify-content:center;gap:12px;padding:14px 22px;border-bottom:1px solid var(--line);background:var(--paper)}\n.ibo .ibhead img{height:40px;width:auto;display:block}\n.ibo .ibhead .hwa{display:none;align-items:center;justify-content:center;width:42px;height:42px;border-radius:50%;background:#25D366;flex:none}\n.ibo .ibhead .hwa svg{width:23px;height:23px;fill:#fff}\n@media(max-width:859px){\n  .ibo .ibhead{justify-content:space-between;padding:12px 16px}\n  .ibo .ibhead img{height:32px}\n  .ibo .ibhead .hwa{display:inline-flex}\n}\n\n/* HERO */\n.ibo .hero{padding:42px 0 14px}\n.ibo .hero .grid{display:grid;grid-template-columns:1fr;gap:26px;align-items:start}\n.ibo h1{font-family:var(--serif);font-weight:500;font-size:clamp(34px,8vw,54px);line-height:1.03;margin:16px 0 0;letter-spacing:.005em}\n.ibo h1 em{font-style:italic}\n.ibo .lede{font-size:17px;color:var(--muted);font-weight:300;max-width:42ch;margin-top:15px}\n.ibo .ticks{list-style:none;margin-top:24px;display:grid;gap:14px}\n.ibo .ticks li{display:flex;gap:12px;align-items:flex-start;font-size:15.5px;line-height:1.55}\n.ibo .ticks .ck{flex:none;width:20px;height:20px;margin-top:2px}\n.ibo .ticks .ck svg{width:100%;height:100%;stroke:var(--black);fill:none;stroke-width:2}\n.ibo .ticks b{font-weight:500}\n.ibo .seen{margin-top:24px;padding-top:18px;border-top:1px solid var(--line);font-size:13px;color:var(--muted);letter-spacing:.02em}\n.ibo .seen b{font-family:var(--serif);font-size:17px;color:var(--ink);font-weight:600}\n\n/* FORM CARD */\n.ibo .form-wrap{position:relative}\n.ibo .card{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:clamp(22px,5vw,32px);box-shadow:0 30px 60px -42px rgba(20,18,12,.5)}\n.ibo .card h2{font-family:var(--serif);font-weight:600;font-size:27px;line-height:1.1}\n.ibo .card .sub{font-size:13.5px;color:var(--muted);font-weight:300;margin-top:6px}\n.ibo .get{list-style:none;margin:16px 0 4px;padding:15px 17px;background:var(--cream);border-radius:10px;display:grid;gap:9px}\n.ibo .get .gt{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:2px}\n.ibo .get li{display:flex;gap:10px;align-items:flex-start;font-size:14px}\n.ibo .get .ck{flex:none;width:17px;height:17px;margin-top:2px}\n.ibo .get .ck svg{width:100%;height:100%;stroke:var(--black);fill:none;stroke-width:2.2}\n/* spacing around the embedded Klaviyo form */\n.ibo .kl-embed{margin-top:18px}\n.ibo .or{text-align:center;font-size:12px;color:var(--muted);margin:16px 0 4px}\n.ibo .wa{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;min-height:50px;border:1px solid var(--line);border-radius:10px;font-weight:500;font-size:13.5px;background:#fff;transition:border-color .18s}\n.ibo .wa:hover{border-color:var(--black)}\n.ibo .wa svg{width:17px;height:17px;fill:#121212}\n.ibo .wa .ins{color:var(--muted);font-weight:300}\n.ibo .paystrip{margin-top:16px;text-align:center}\n.ibo .paystrip .pl{display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:9px;font-weight:500}\n.ibo .paystrip .pic{display:flex;flex-wrap:wrap;gap:7px;justify-content:center;align-items:center}\n.ibo .paystrip .pic svg,.ibo .paystrip .pic img{height:26px;width:auto;border:1px solid var(--line);border-radius:5px;display:block}\n\n/* PROOF BAR */\n.ibo .proof{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper)}\n.ibo .proof .wrap{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;justify-content:center;padding-top:17px;padding-bottom:17px;font-size:13.5px;color:var(--muted);text-align:center}\n.ibo .proof .pf{display:inline-flex;align-items:center;gap:8px}\n.ibo .proof .pf svg{width:16px;height:16px;flex:none;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}\n\n/* CATEGORIES */\n.ibo .cats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}\n.ibo .cat{position:relative;overflow:hidden;border-radius:6px;aspect-ratio:3/4;background:#eee}\n.ibo .cat img{width:100%;height:100%;object-fit:cover;transition:transform .55s ease}\n.ibo .cat:hover img{transform:scale(1.05)}\n.ibo .cat .cap{position:absolute;left:0;right:0;bottom:0;padding:26px 14px 12px;\n  background:linear-gradient(to top,rgba(0,0,0,.62),rgba(0,0,0,0));\n  color:#fff;font-family:var(--serif);font-size:17px;font-weight:600;letter-spacing:.01em;text-align:center}\n\n/* WHY */\n.ibo section{padding:54px 0}\n.ibo .head h2{font-family:var(--serif);font-weight:500;font-size:clamp(26px,6vw,40px);line-height:1.1;margin-top:12px}\n.ibo .head p{color:var(--muted);font-weight:300;margin-top:10px;max-width:52ch}\n.ibo .items{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0;margin-top:30px;border-top:1px solid var(--line)}\n.ibo .it{padding:24px 0;border-bottom:1px solid var(--line)}\n.ibo .it h3{font-family:var(--serif);font-weight:600;font-size:22px}\n.ibo .it p{font-size:15px;color:var(--muted);font-weight:300;margin-top:7px;line-height:1.55}\n\n/* ATELIER VIDEO */\n.ibo .atelier{background:var(--cream)}\n.ibo .atelier .ag{display:grid;grid-template-columns:1fr;gap:30px;align-items:center}\n.ibo .atelier .video{position:relative;overflow:hidden;border-radius:14px;background:#000;aspect-ratio:9/16;width:100%;max-width:330px;margin:0 auto;box-shadow:0 34px 64px -42px rgba(20,18,12,.6)}\n.ibo .atelier .video video{width:100%;height:100%;object-fit:cover;display:block}\n.ibo .atelier .acopy h2{font-family:var(--serif);font-weight:500;font-size:clamp(26px,6vw,40px);line-height:1.08;margin-top:12px}\n.ibo .atelier .acopy p{color:var(--muted);font-weight:300;margin-top:14px;max-width:46ch;font-size:15.5px}\n.ibo .atelier .mk{list-style:none;margin-top:22px;display:grid;gap:13px}\n.ibo .atelier .mk li{display:flex;gap:11px;align-items:flex-start;font-size:15px}\n.ibo .atelier .mk .ck{flex:none;width:19px;height:19px;margin-top:2px}\n.ibo .atelier .mk .ck svg{width:100%;height:100%;stroke:var(--black);fill:none;stroke-width:2}\n.ibo .atelier .mk b{font-weight:500}\n\n/* STICKY MOBILE */\n.ibo .sticky{position:fixed;left:0;right:0;bottom:0;z-index:40;display:flex;gap:10px;padding:11px 14px;background:rgba(251,250,247,.97);backdrop-filter:blur(6px);border-top:1px solid var(--line)}\n.ibo .sticky .btn{flex:1;display:inline-flex;align-items:center;justify-content:center;font-family:var(--sans);font-weight:600;font-size:14px;letter-spacing:.03em;border:1px solid var(--black);border-radius:10px;background:var(--black);color:#fff;min-height:48px;padding:13px}\n.ibo .sticky .wa-ic{flex:0 0 50px;width:50px;background:#fff;border:1px solid var(--line)}\n.ibo .sticky .wa-ic svg{width:19px;height:19px;fill:#121212}\n.ibo .pad{height:74px}\n\n/* MOBILE — form appears early via order */\n@media(max-width:859px){\n  .ibo .hero-copy{order:2}\n  .ibo .form-wrap{order:1}\n}\n@media(max-width:520px){\n  .ibo .wrap{padding:0 18px}\n  .ibo .hero{padding:8px 0 4px}\n  .ibo .hero .grid{gap:18px}\n  .ibo section{padding:30px 0}\n  .ibo h1{font-size:clamp(27px,8vw,38px)}\n  .ibo .lede{font-size:16px;margin-top:11px;line-height:1.55}\n  .ibo .ticks{margin-top:16px;gap:11px}\n  .ibo .seen{margin-top:16px;padding-top:14px}\n  .ibo .card{padding:18px}\n  .ibo .get{margin:13px 0 2px;padding:13px 15px}\n  .ibo .cats{gap:10px}\n  .ibo .cat .cap{font-size:15px;padding:22px 12px 10px}\n  .ibo .head h2{font-size:clamp(24px,7vw,32px)}\n  .ibo .head p{margin-top:8px}\n  .ibo .items{margin-top:18px}\n  .ibo .it{padding:18px 0}\n  .ibo .proof .wrap{padding-top:12px;padding-bottom:12px;font-size:13px}\n  .ibo .atelier .ag{gap:22px}\n}\n@media(min-width:860px){\n  .ibo .wrap{padding:0 36px}\n  .ibo .hero{padding:62px 0 24px}\n  .ibo .hero .grid{grid-template-columns:1.04fr .96fr;gap:56px;align-items:start}\n  .ibo .items{grid-template-columns:repeat(4,1fr);gap:28px}\n  .ibo .cats{grid-template-columns:repeat(5,1fr)}\n  .ibo .it{border-bottom:none}\n  .ibo .atelier .ag{grid-template-columns:.85fr 1.15fr;gap:54px}\n  .ibo .sticky,.ibo .pad{display:none}\n}\n</style>\n\n<div class=\"ibo\">\n\n  <!-- LOGO HEADER -->\n  <header class=\"ibhead\">\n    <a href=\"https://ibban.com\" aria-label=\"ibBan home\">\n      <img src=\"https://ibban.com/cdn/shop/files/ibban_logo.png?v=1763981154&width=320\" alt=\"ibBan\">\n    </a>\n    <a class=\"hwa\" target=\"_blank\" rel=\"noopener\" aria-label=\"Chat on WhatsApp\"\n       href=\"https://api.whatsapp.com/send/?phone=34689948641&text=Hi%2C%20I%27m%20interested%20in%20B2B%20%2F%20Wholesale%20pricing.\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z\"/></svg>\n    </a>\n  </header>\n\n  <!-- HERO + FORM -->\n  <header class=\"hero\"><div class=\"wrap\"><div class=\"grid\">\n\n    <div class=\"hero-copy\">\n      <span class=\"eyebrow\">Trade &amp; Wholesale · Est. 1982</span>\n      <h1>We're the <em>maker</em>. Stock hand&#8209;embroidered boho fashion at true trade prices.</h1>\n      <p class=\"lede\">Designed and embroidered in our own atelier — so your boutique gets maker pricing on dresses, kaftans, jackets, bags &amp; swimwear, not a middleman's markup.</p>\n      <ul class=\"ticks\">\n        <li><span class=\"ck\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></svg></span><span><b>Low minimums to start</b> — test the range before you commit to bulk.</span></li>\n        <li><span class=\"ck\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></svg></span><span><b>Wholesale pricing direct from the maker</b> — healthy boutique margins built in.</span></li>\n        <li><span class=\"ck\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></svg></span><span><b>Klarna for trade</b> — protect cashflow, plus worldwide dispatch in 1–3 days.</span></li>\n      </ul>\n      <div class=\"seen\">Supplying boutiques &amp; concept stores across the <b>UK, Spain, USA &amp; the Gulf</b>.</div>\n    </div>\n\n    <div class=\"form-wrap\" id=\"apply\">\n      <div class=\"card\">\n        <h2>Open your wholesale account</h2>\n        <p class=\"sub\">Get your catalogue, price list &amp; trade login.</p>\n        <ul class=\"get\">\n          <li class=\"gt\" style=\"grid-column:1/-1\">After you apply, our team will:</li>\n          <li><span class=\"ck\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></svg></span><span>Review your business details</span></li>\n          <li><span class=\"ck\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></svg></span><span>Send your catalogue &amp; trade price list</span></li>\n          <li><span class=\"ck\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 13l4 4L19 7\"/></svg></span><span>Reply personally within 1 business day</span></li>\n        </ul>\n\n        <!-- ===== KLAVIYO EMBEDDED FORM ===== -->\n        <div class=\"kl-embed\">\n          <div class=\"klaviyo-form-SvwukM\"></div>\n        </div>\n\n        <div class=\"or\">— or message us on WhatsApp —</div>\n        <a class=\"wa\" target=\"_blank\" rel=\"noopener\"\n           href=\"https://api.whatsapp.com/send/?phone=34689948641&text=Hi%2C%20I%27m%20interested%20in%20B2B%20%2F%20Wholesale%20pricing.%20Can%20you%20help%20me%20set%20up%20a%20Wholesale%20account%3F\">\n           <svg viewBox=\"0 0 24 24\"><path d=\"M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24z\"/></svg>\n           Chat on WhatsApp <span class=\"ins\">· instant reply</span></a>\n      </div>\n\n      <!-- PAYMENT TRUST — Shopify renders icons for whatever you've enabled (needs Custom Liquid section) -->\n      <div class=\"paystrip\">\n        <span class=\"pl\">Secure payment — pay your way</span>\n        <div class=\"pic\">\n          {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'ibpay' }}{%- endfor -%}\n        </div>\n      </div>\n    </div>\n\n  </div></div></header>\n\n  <!-- PROOF BAR -->\n  <div class=\"proof\"><div class=\"wrap\">\n    <span class=\"pf\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"9\" r=\"5\"/><path d=\"M8.5 13L7 22l5-3 5 3-1.5-9\"/></svg>Hand-crafted since 1982</span>\n    <span class=\"pf\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 9h16l-1 11H5L4 9z\"/><path d=\"M9 9V6a3 3 0 0 1 6 0v3\"/></svg>In-house atelier — true maker pricing</span>\n    <span class=\"pf\"><svg viewBox=\"0 0 24 24\"><rect x=\"2.5\" y=\"5.5\" width=\"19\" height=\"13\" rx=\"2\"/><path d=\"M2.5 10h19\"/></svg>Klarna — buy now, pay later</span>\n    <span class=\"pf\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18\"/></svg>Worldwide shipping 1–3 days</span>\n  </div></div>\n\n  <!-- CATEGORIES -->\n  <section style=\"padding-bottom:0\"><div class=\"wrap\">\n    <div class=\"head\" style=\"margin-bottom:26px\">\n      <span class=\"eyebrow\">What we make</span>\n      <h2>Every category we supply.</h2>\n      <p>From everyday dresses to handbags — all hand-embroidered and wholesale-ready, with new styles each season.</p>\n    </div>\n    <div class=\"cats\">\n      <div class=\"cat\"><img loading=\"lazy\" src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/denim_5_ee703c8c-5c1d-4075-b626-1e7699eec14d.png?v=1774603152&width=500\" alt=\"Long dresses wholesale\"><div class=\"cap\">Long Dresses</div></div>\n      <div class=\"cat\"><img loading=\"lazy\" src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/1_77627d02-1941-420a-af6b-1ef4fe271e7f.webp?v=1778299641&width=500\" alt=\"Short dresses wholesale\"><div class=\"cap\">Short Dresses</div></div>\n      <div class=\"cat\"><img loading=\"lazy\" src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/7_acd0d7c7-7b51-4bde-b941-4547381ac856.webp?v=1778303516&width=500\" alt=\"Tunics wholesale\"><div class=\"cap\">Tunics</div></div>\n      <div class=\"cat\"><img loading=\"lazy\" src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/BLACK1_2257bcfc-0f58-419f-89b1-06498c40cc15.jpg?v=1777356127&width=500\" alt=\"Kaftans wholesale\"><div class=\"cap\">Kaftans</div></div>\n      <div class=\"cat\"><img loading=\"lazy\" src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/GREEN_2_ff8be895-aefb-4775-b58a-5a5f06ae4d9d.jpg?v=1777899163&width=500\" alt=\"Kimonos wholesale\"><div class=\"cap\">Kimonos</div></div>\n      <div class=\"cat\"><img loading=\"lazy\" src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/pink_2_f821e732-3367-4cf8-a6bc-939c24b6c006.webp?v=1777984475&width=500\" alt=\"Jackets and vests wholesale\"><div class=\"cap\">Jackets &amp; Vests</div></div>\n      <div class=\"cat\"><img loading=\"lazy\" src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/183A7666.jpg?v=1775199715&width=500\" alt=\"Coats wholesale\"><div class=\"cap\">Coats</div></div>\n      <div class=\"cat\"><img loading=\"lazy\" src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/02_859ae0a5-e051-44a3-83e8-195a0d6e3ff0.webp?v=1778061858&width=500\" alt=\"Swimwear wholesale\"><div class=\"cap\">Swimwear</div></div>\n      <div class=\"cat\"><img loading=\"lazy\" src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/1_3_764a28b1-5620-4633-bc76-8f934ac80a7a.jpg?v=1777789979&width=500\" alt=\"Hand bags wholesale\"><div class=\"cap\">Hand Bags</div></div>\n      <div class=\"cat\"><img loading=\"lazy\" src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/1_1266751a-5cbd-4071-a53f-a471ebfb16f2.jpg?v=1777978998&width=500\" alt=\"Kids wholesale\"><div class=\"cap\">Kids</div></div>\n    </div>\n  </div></section>\n\n  <!-- WHY -->\n  <section><div class=\"wrap\">\n    <div class=\"head\">\n      <span class=\"eyebrow\">Why retailers choose ibBan</span>\n      <h2>A line your customers already buy — at trade margins.</h2>\n      <p>We are the maker, not a middleman. Better pricing, real stock, and pieces designed to sell through season after season.</p>\n    </div>\n  