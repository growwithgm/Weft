        "custom_liquid": "<style>\n/* OWNED PRODUCTION — MAPS */\n.ibo .locs{background:var(--paper)}\n.ibo .locs .wrap{max-width:1080px;margin:0 auto;padding:64px 22px}\n.ibo .locs .lhead{text-align:center;max-width:660px;margin:0 auto 36px}\n.ibo .locs .eyebrow{display:inline-block;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);font-weight:600}\n.ibo .locs .lhead h2{font-family:var(--serif);font-weight:500;font-size:clamp(26px,5.4vw,40px);line-height:1.1;margin-top:12px}\n.ibo .locs .lhead p{color:var(--muted);font-weight:300;margin-top:14px;font-size:15.5px;line-height:1.55}\n.ibo .locs .lgrid{display:grid;grid-template-columns:1fr;gap:26px}\n.ibo .locs .lcard{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--paper)}\n.ibo .locs .lmap{position:relative;width:100%;aspect-ratio:16/10;background:#eee}\n.ibo .locs .lmap iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block;filter:grayscale(1) contrast(1.05)}\n.ibo .locs .lcap{padding:18px 20px}\n.ibo .locs .lcap .tag{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);font-weight:600}\n.ibo .locs .lcap h3{font-family:var(--serif);font-weight:600;font-size:21px;margin-top:6px}\n.ibo .locs .lcap p{color:var(--muted);font-weight:300;font-size:14px;margin-top:5px;line-height:1.5}\n.ibo .locs .lfoot{text-align:center;margin-top:30px;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:500}\n@media(min-width:860px){.ibo .locs .lgrid{grid-template-columns:1fr 1fr;gap:30px}}\n</style>\n\n<section class=\"locs\"><div class=\"wrap\">\n  <div class=\"lhead\">\n    <span class=\"eyebrow\">Owned production · shipped worldwide</span>\n    <h2>From our own atelier to your boutique</h2>\n    <p>We own our production end-to-end — our craft &amp; embroidery atelier in India, and our headquarters &amp; outlet in Spain. No licensing, no middleman. We ship worldwide.</p>\n  </div>\n  <div class=\"lgrid\">\n    <div class=\"lcard\">\n      <div class=\"lmap\">\n        <iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1790452.7456009446!2d78.68899926025061!3d28.77991520975748!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390afdb42d0ec3d5%3A0x2af3438fc03db4c7!2sIBBAN%20INDUSTRIES%20PVT%20LTD!5e0!3m2!1sen!2s!4v1780561271410!5m2!1sen!2s\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" allowfullscreen title=\"ibBan production atelier — India\"></iframe>\n      </div>\n      <div class=\"lcap\">\n        <span class=\"tag\">Production atelier · India</span>\n        <h3>Where it's made</h3>\n        <p>Our own embroidery &amp; manufacturing unit — every piece designed, hand-embroidered and finished in-house.</p>\n      </div>\n    </div>\n    <div class=\"lcard\">\n      <div class=\"lmap\">\n        <iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3044.478713676851!2d-3.7523339048851767!3d40.26511499128261!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd418aa16af807b5%3A0x1322f389ead17fdf!2sIb%20Ban!5e0!3m2!1sen!2s!4v1780561349499!5m2!1sen!2s\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" allowfullscreen title=\"ibBan headquarters & outlet — Spain\"></iframe>\n      </div>\n      <div class=\"lcap\">\n        <span class=\"tag\">Headquarters &amp; outlet · Spain</span>\n        <h3>Where we ship from</h3>\n        <p>Calle Manuel Cobo Calleja 19, Fuenlabrada, Madrid — our European HQ, outlet &amp; dispatch hub.</p>\n      </div>\n    </div>\n  </div>\n  <div class=\"lfoot\">Worldwide shipping · flat rate · since 1982</div>\n</div></section>",
