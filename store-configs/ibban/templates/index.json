    "craft_story": {
      "type": "media-with-text",
      "blocks": {
        "cs_sub": {
          "type": "text",
          "settings": {
            "text": "<p>The making</p>"
          }
        },
        "cs_head": {
          "type": "heading",
          "settings": {
            "heading": "Every stitch by hand",
            "size": "h1",
            "tag": "auto"
          }
        },
        "cs_text": {
          "type": "text",
          "settings": {
            "text": "<p>Each ibBan piece begins as plain cloth and a drawing. Our artisans work the embroidery by hand &mdash; mirror work, beadwork, thread &mdash; and a single dress can take days to finish.</p><p>Nothing is machine-stamped. No two pieces are ever quite identical. We have worked this way since 1982.</p>",
            "style": "body"
          }
        }
      },
      "block_order": [
        "cs_sub",
        "cs_head",
        "cs_text"
      ],
