        "b2bs_text": {
          "type": "text",
          "settings": {
            "text": "<p><strong>ibBan</strong> is a <strong>boho chic</strong> design brand that blends <strong>natural materials</strong> and <strong>artisan details</strong> to create a style that is <strong>elegant and versatile</strong>. Each piece is made to accompany everyday life with <strong>ease</strong> and a <strong>unique touch</strong>. <strong>ibBan</strong> dresses the woman who lives with <strong>freedom and authenticity</strong>.</p>",
            "style": "large"
          }
        }
