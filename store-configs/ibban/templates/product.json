        "collapsible_content_j98RbT": {
          "type": "collapsible",
          "disabled": true,
          "settings": {
            "heading": "14-Day Easy Returns",
            "icon": "return",
            "text": "<p>Shop with confidence. If you are not fully satisfied with your purchase, you can request a return within 14 days of receiving your order.</p><p>Items must be unused, unworn, unwashed, and returned in their original condition with all tags and packaging.</p><p>Once your return is received and approved, we will process your refund according to our return policy.<a href=\"/pages/return-and-refund-policy\" title=\"Return and refund policy\">Return Policy</a></p>",
            "open": false
          }
        },
        "collapsible-content-1": {
          "type": "collapsible",
          "settings": {
            "heading": "Main Features",
            "icon": "check",
            "text": "<p><strong>Fabric </strong>({{ product.metafields.shopify.fabric | metafield_text: field: 'label' }})</p><p><strong>Embroidery</strong>({{ product.metafields.custom.embroidery.value }})<br/><strong>Color</strong> ({{ product.metafields.shopify[\"color-pattern\"] | metafield_text: field: 'label' }})<br/><strong>Sizes</strong> ({{ product.metafields.shopify.size | metafield_text: field: 'label' }})<br/></p>",
