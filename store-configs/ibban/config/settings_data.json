    "custom_code_head": "<style>\n  /* Newsletter phone field styling */\n  .newsletter-form-wrapper .phone-input-wrapper {\n    margin-top: 12px;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .newsletter-form-wrapper input[type=\"tel\"] {\n    border-radius: 26px;\n    border: 2px solid #141414;\n    background-color: #141414;\n    color: #ffffff;\n    padding: 12px 20px;\n    font-size: 16px;\n    font-family: inherit;\n    width: 100%;\n    box-sizing: border-box;\n    transition: all 0.3s ease;\n  }\n\n  .newsletter-form-wrapper input[type=\"tel\"]::placeholder {\n    color: rgba(255, 255, 255, 0.6);\n  }\n\n  .newsletter-form-wrapper input[type=\"tel\"]:focus {\n    outline: none;\n    border-color: #ffffff;\n    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);\n  }\n\n  .newsletter-form-wrapper input[type=\"tel\"]:hover {\n    border-color: #ffffff;\n  }\n\n  /* Ensure responsive behavior */\n  @media (max-width: 768px) {\n    .newsletter-form-wrapper input[type=\"tel\"] {\n      padding: 10px 16px;\n      font-size: 16px;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    // Find all newsletter forms in the footer\n    const newsletterForms = document.querySelectorAll('form[action*=\"/contact\"], form[action*=\"/newsletter\"], .newsletter-form, [data-newsletter-form]');\n    \n    newsletterForms.forEach(function(form) {\n      // Check if phone field already exists\n      if (form.querySelector('input[type=\"tel\"]')) {\n        return;\n      }\n      \n      // Find the email input field\n      const emailInput = form.querySelector('input[type=\"email\"]');\n      \n      if (emailInput) {\n        // Create wrapper for phone field\n        const phoneWrapper = document.createElement('div');\n        phoneWrapper.className = 'phone-input-wrapper';\n        \n        // Create phone input field\n        const phoneInput = document.createElement('input');\n        phoneInput.type = 'tel';\n        phoneInput.name = 'phone';\n        phoneInput.placeholder = 'Phone number (optional)';\n        phoneInput.setAttribute('aria-label', 'Phone number');\n        \n        // Add phone field after email input\n        phoneWrapper.appendChild(phoneInput);\n        emailInput.parentNode.insertAfter(phoneWrapper, emailInput);\n        \n        // Wrap the form to apply custom styling\n        if (!form.classList.contains('newsletter-form-wrapper')) {\n          form.classList.add('newsletter-form-wrapper');\n        }\n        \n        // Handle form submission to include phone data\n        form.addEventListener('submit', function(e) {\n          const phoneValue = phoneInput.value.trim();\n          \n          // If phone is provided, add it to form data\n          if (phoneValue) {\n            // Create hidden input for phone if it doesn't exist\n            let hiddenPhone = form.querySelector('input[name=\"phone\"][type=\"hidden\"]');\n            if (!hiddenPhone) {\n              hiddenPhone = document.createElement('input');\n              hiddenPhone.type = 'hidden';\n              hiddenPhone.name = 'phone';\n              form.appendChild(hiddenPhone);\n            }\n            hiddenPhone.value = phoneValue;\n          }\n        });\n      }\n    });\n  });\n</script>",
