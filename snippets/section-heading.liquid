{%- comment -%}
  Heading row for library sections: title, optional "View all" style button.
  Params: title, align ('start' | 'center'), button_label, button_link, button_style, tag (default h2)
{%- endcomment -%}
{%- if title != blank or button_label != blank -%}
  {%- assign heading_tag = tag | default: 'h2' -%}
  <div class="section-heading section-heading--{{ align | default: 'start' }}">
    {%- if title != blank -%}<{{ heading_tag }} class="h2 section-heading__title">{{ title | escape }}</{{ heading_tag }}>{%- endif -%}
    {%- if button_label != blank -%}
      <a class="{% if button_style == 'link' %}link{% else %}button button--{{ button_style | default: 'secondary' }}{% endif %} section-heading__button"{% if button_link != blank %} href="{{ button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>{{ button_label | escape }}</a>
    {%- endif -%}
  </div>
{%- endif -%}
