{%- comment -%}
  Inline SVG icons. Usage: {% render 'icon', name: 'search' %}, optional size: 20.
  Line icons use currentColor strokes; social icons are simplified filled glyphs.
  Always decorative: the control that holds the icon carries the accessible name.
{%- endcomment -%}
{%- liquid
  assign s = size | default: 24
  assign filled_icons = 'star,play,pause,instagram,facebook,tiktok,pinterest,youtube,twitter,threads,linkedin,snapchat,whatsapp,wechat,vimeo,tumblr,twitch,spotify,discord,mastodon' | split: ','
-%}
<svg class="icon icon--{{ name }}" aria-hidden="true" focusable="false" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24"
  {%- if filled_icons contains name %} fill="currentColor"{% else %} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"{% endif -%}
>
