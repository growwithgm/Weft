{%- comment -%}
  Blog post card for featured-blog and the blog page: image, tags, title, excerpt, author and
  date, "Read more". The title link covers the card.
  Params: article (required), sizes, show_image, show_tags, show_excerpt, show_author, show_date,
          show_button, button_style, image_ratio, heading_tag (default h3)
{%- endcomment -%}
{%- assign tag = heading_tag | default: 'h3' -%}
<article class="article-card">
  {%- if show_image != false -%}
    <div class="article-card__media media media--{{ image_ratio | default: 'landscape' }}">
      {%- if article.image -%}
        {%- render 'image', image: article.image, sizes: sizes, widths: '360,540,720,960,1200' -%}
      {%- else -%}
        {{ 'blog-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="article-card__body stack">
    {%- if show_tags and article.tags.size > 0 -%}
      <p class="article-card__tags muted">{{ article.tags | join: ' · ' }}</p>
    {%- endif -%}
    <{{ tag }} class="h4 article-card__title"><a class="article-card__link" href="{{ article.url }}">{{ article.title | escape }}</a></{{ tag }}>
    {%- if show_excerpt -%}
      <p class="article-card__excerpt">{%- if article.excerpt != blank -%}{{ article.excerpt | strip_html | truncatewords: 30 }}{%- else -%}{{ article.content | strip_html | truncatewords: 30 }}{%- endif -%}</p>
    {%- endif -%}
    {%- if show_author or show_date -%}
      <p class="article-card__meta muted">
        {%- if show_author -%}<span>{{ article.author }}</span>{%- endif -%}
        {%- if show_author and show_date %} · {% endif -%}
        {%- if show_date -%}{{ article.published_at | time_tag: format: 'date' }}{%- endif -%}
      </p>
    {%- endif -%}
    {%- if show_button -%}<span class="{% if button_style == 'link' %}link{% else %}button button--{{ button_style | default: 'secondary' }}{% endif %} article-card__more" aria-hidden="true">{{ 'blogs.read_more' | t }}</span>{%- endif -%}
  </div>
</article>
