{%- comment -%}
  Floating chat button (brief §4.1, §5): one number for the whole site from the WhatsApp social
  setting, pre-filled with the page link. Hidden on the pages listed in the setting, and while the
  mobile sticky bar or an overlay is up (core.js toggles [data-chat-hidden]).
{%- endcomment -%}
{%- liquid
  assign show_chat = true
  if settings.chat_button_enable == false or settings.social_whatsapp_url == blank
    assign show_chat = false
  endif
  if show_chat and request.page_type == 'page' and settings.chat_button_hide_on != blank
    assign hidden_handles = settings.chat_button_hide_on | remove: ' ' | split: ','
    if hidden_handles contains page.handle
      assign show_chat = false
    endif
  endif
-%}
{%- if show_chat -%}
  {%- liquid
    assign base_url = settings.social_whatsapp_url | split: '?' | first
    assign message = settings.chat_button_message | append: ' ' | append: canonical_url
  -%}
  <a
    class="chat-button"
    href="{{ base_url }}?text={{ message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ 'general.chat.label' | t }} ({{ 'general.opens_new_window' | t }})"
    data-chat-button
  >
    {%- render 'icon', name: 'chat' -%}
  </a>
{%- endif -%}
