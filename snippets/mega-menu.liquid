{%- comment -%}
  Mega menu panel for one top-level link.
  Params: link (top-level link with children), block (header "mega_menu" block).
  Links render as plain HTML (no-JS friendly); images and promotions sit in a <template>
  that header.js clones on first open, keeping the initial DOM small.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign has_promo = false
  if s.promo1_image != blank or s.promo1_content != blank or s.promo2_image != blank or s.promo2_content != blank or s.promo3_image != blank or s.promo3_content != blank
    assign has_promo = true
  endif
  assign badge1 = s.badge1_link | strip | downcase
  assign badge2 = s.badge2_link | strip | downcase
  assign badge3 = s.badge3_link | strip | downcase
-%}
<div class="mega__inner page-width{% if has_promo %} mega__inner--promo-{{ s.promo_position }}{% endif %}">
  <ul class="mega__columns mega__columns--{{ s.style }}{% if s.show_underline %} mega__columns--underline{% endif %}" role="list">
    {%- for child in link.links -%}
      {%- liquid
        assign child_title = child.title | strip | downcase
        assign badge_text = nil
        assign badge_color = nil
        if badge1 != blank and child_title == badge1
          assign badge_text = s.badge1_text
          assign badge_color = s.badge1_color
        elsif badge2 != blank and child_title == badge2
          assign badge_text = s.badge2_text
          assign badge_color = s.badge2_color
        elsif badge3 != blank and child_title == badge3
          assign badge_text = s.badge3_text
          assign badge_color = s.badge3_color
        endif
      -%}
      <li class="mega__column">
        <a class="mega__heading" href="{{ child.url }}" {% if child.current %}aria-current="page"{% endif %}>
          {%- if s.link_images != 'none' -%}
            <span class="mega__thumb mega__thumb--{{ s.link_images }}{% if s.circle_images %} mega__thumb--circle{% endif %} mega__thumb--{{ s.image_ratio }}" data-thumb="{{ forloop.index0 }}"></span>
          {%- endif -%}
          <span>{{ child.title }}</span>
          {%- if badge_text != blank -%}<span class="badge" style="--badge-bg: {{ badge_color }}; --badge-fg: #fff">{{ badge_text }}</span>{%- endif -%}
        </a>
        {%- if child.links != blank -%}
          <ul class="mega__links" role="list">
            {%- for grandchild in child.links -%}
              <li><a class="mega__link" href="{{ grandchild.url }}" {% if grandchild.current %}aria-current="page"{% endif %}>{{ grandchild.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>

  {%- if has_promo or s.link_images != 'none' -%}
    <template data-mega-extras>
      {%- if s.link_images != 'none' -%}
        {%- for child in link.links -%}
          {%- liquid
            assign thumb = nil
            if child.type == 'collection_link'
              if s.use_product_image
                assign thumb = child.object.products.first.featured_media.preview_image
              else
                assign thumb = child.object.featured_image | default: child.object.products.first.featured_media.preview_image
              endif
            elsif child.type == 'product_link'
              assign thumb = child.object.featured_media.preview_image
            endif
          -%}
          {%- if thumb -%}
            <span data-thumb-for="{{ forloop.index0 }}">{{ thumb | image_url: width: 160 | image_tag: widths: '80,160', sizes: '80px', alt: '', loading: 'lazy' }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if has_promo -%}
        <div class="mega__promos" data-mega-promos style="--promo-min-h: {{ s.promo_min_height }}px; --promo-fg: {{ s.promo_text_color }}; --promo-tint: {{ s.promo_tint_color }}; --promo-tint-opacity: {{ s.promo_tint_opacity | divided_by: 100.0 }}">
          {%- for i in (1..3) -%}
            {%- liquid
              assign img_key = 'promo' | append: i | append: '_image'
              assign txt_key = 'promo' | append: i | append: '_content'
              assign url_key = 'promo' | append: i | append: '_link'
              assign align_key = 'promo' | append: i | append: '_align'
              assign p_img = s[img_key]
              assign p_txt = s[txt_key]
              assign p_url = s[url_key]
            -%}
            {%- if p_img != blank or p_txt != blank -%}
              <a class="mega__promo mega__promo--{{ s[align_key] }}" href="{{ p_url | default: link.url }}">
                {%- if p_img != blank -%}{{ p_img | image_url: width: 800 | image_tag: widths: '400,600,800', sizes: '(min-width: 990px) 25vw, 90vw', loading: 'lazy', class: 'mega__promo-image' }}{%- endif -%}
                {%- if p_txt != blank -%}<span class="mega__promo-text rte">{{ p_txt }}</span>{%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </template>
  {%- endif -%}
</div>
