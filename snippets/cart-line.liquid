{%- comment -%}
  One cart line for the drawer and the cart page (brief §7.13).
  Retail: image, title, options, properties, selling plan, discounts, unit price, stepper, total.
  Wholesale: pack image, assorted-pack values, price per piece with Shopify's tier label, stepper
  following the variant's quantity rule with a hint, and an inline error when the line breaks it.
  Params: item, index (1-based line), wholesale (bool), context ('drawer' | 'page'),
          show_vendor, show_backorder
{%- endcomment -%}
{%- liquid
  assign v = item.variant
  assign rule_min = v.quantity_rule.min | default: 1
  assign rule_inc = v.quantity_rule.increment | default: 1
  assign rule_max = v.quantity_rule.max
  assign q = item.quantity

  assign line_error = nil
  if wholesale
    assign remainder = q | modulo: rule_inc
    if remainder != 0
      assign lower = q | divided_by: rule_inc | times: rule_inc
      assign upper = lower | plus: rule_inc
      if lower < rule_min
        assign line_error = 'wholesale.not_multiple_one' | t: quantity: q, increment: rule_inc, suggestion: upper
      else
        assign line_error = 'wholesale.not_multiple' | t: quantity: q, increment: rule_inc, lower: lower, upper: upper
      endif
    elsif q < rule_min
      assign line_error = 'wholesale.below_min' | t: count: rule_min
    elsif rule_max and q > rule_max
      assign line_error = 'wholesale.above_max' | t: count: rule_max
    endif
  endif

  assign image = item.image
  if wholesale and settings.wholesale_pack_image_metafield != blank
    assign pack_parts = settings.wholesale_pack_image_metafield | split: '.'
    assign pack_ns = pack_parts | first
    assign pack_key = pack_parts | last
    assign pack_image = item.product.metafields[pack_ns][pack_key].value
    if pack_image
      assign image = pack_image
    endif
  endif

  assign assorted = false
  if wholesale and settings.wholesale_assorted_packs and item.product.has_only_default_variant == false
    assign excluded = settings.wholesale_assorted_exclude_types | downcase | split: ','
    assign ptype = item.product.type | downcase | strip
    assign skip = false
    for t in excluded
      assign t_clean = t | strip
      if t_clean != blank and t_clean == ptype
        assign skip = true
      endif
    endfor
    assign matrix_tag = settings.wholesale_matrix_tag | strip | downcase
    for tag in item.product.tags
      assign tag_d = tag | downcase
      if tag_d == matrix_tag
        assign skip = true
      endif
    endfor
    if skip == false
      assign last_option = item.product.options_with_values | last
      if item.product.options_with_values.size == 1 or last_option.values.size == 1
        assign assorted = true
      endif
    endif
  endif

  assign tier_min = nil
  if wholesale and v.quantity_price_breaks.size > 0
    for b in v.quantity_price_breaks
      if q >= b.minimum_quantity and item.final_price == b.price
        assign tier_min = b.minimum_quantity
      endif
    endfor
  endif

  assign backorder = false
  if show_backorder and v.inventory_management != blank and v.inventory_policy == 'continue' and v.inventory_quantity < 0
    assign backorder = true
  endif

  assign input_id = 'CartQty-' | append: context | append: '-' | append: index
  assign cap = nil
  if v.inventory_management != blank and v.inventory_policy == 'deny'
    assign cap = v.inventory_quantity
  endif
  if rule_max
    if cap == nil or rule_max < cap
      assign cap = rule_max
    endif
  endif
-%}
<li class="cart-line{% if line_error %} cart-line--error{% endif %}" data-line="{{ index }}" data-line-key="{{ item.key }}" data-variant-id="{{ item.variant_id }}">
  <a class="cart-line__media media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if image -%}
      {{ image | image_url: width: 240 | image_tag: widths: '120,180,240', sizes: '96px', alt: '', loading: 'lazy' }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="cart-line__body">
    <div class="cart-line__head">
      <div class="cart-line__info">
        {%- if show_vendor and item.vendor != blank -%}<p class="cart-line__vendor muted">{{ item.vendor }}</p>{%- endif -%}
        <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
        {%- if assorted -%}
          {%- assign first_option = item.product.options_with_values | first -%}
          {%- assign assorted_values = first_option.values | join: ', ' -%}
          <p class="cart-line__options">{{ 'wholesale.assorted' | t: option: first_option.name, values: assorted_values }}</p>
        {%- elsif item.product.has_only_default_variant == false -%}
          <p class="cart-line__options">{%- for o in item.options_with_values -%}{{ o.name }}: {{ o.value }}{%- unless forloop.last %} · {% endunless -%}{%- endfor -%}</p>
        {%- endif -%}
        {%- if wholesale and settings.wholesale_show_sku and v.sku != blank -%}<p class="cart-line__options tabular">{{ 'products.sku' | t: sku: v.sku }}</p>{%- endif -%}
        {%- for p in item.properties -%}
          {%- assign first_char = p.first | slice: 0 -%}
          {%- if p.last != blank and first_char != '_' -%}
            <p class="cart-line__options">{{ p.first }}: {% if p.last contains '/uploads/' %}<a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>{% else %}{{ p.last }}{% endif %}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}<p class="cart-line__options">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
        {%- if item.item_components.size > 0 -%}
          <p class="cart-line__options">{{ 'cart.bundle_includes' | t }}</p>
          <ul class="cart-line__components" role="list">
            {%- for component in item.item_components -%}
              <li>{{ component.quantity }} × {{ component.product.title | escape }}{%- unless component.product.has_only_default_variant %} ({{ component.variant.title | escape }}){%- endunless -%}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <p class="cart-line__price tabular">
          {%- if wholesale -%}
            {{ item.final_price | money }} {{ 'price.per_piece' | t }}{%- if tier_min %}, {{ 'wholesale.tier_label' | t: count: tier_min }}{%- endif -%}
          {%- else -%}
            {{ item.final_price | money }}
            {%- if item.original_price > item.final_price %} <s class="price__compare">{{ item.original_price | money }}</s>{%- elsif v.compare_at_price > item.final_price %} <s class="price__compare">{{ v.compare_at_price | money }}</s>{%- endif -%}
          {%- endif -%}
        </p>
        {%- if item.unit_price_measurement -%}
          <p class="cart-line__unit price__unit">{{ item.unit_price | money | unit_price_with_measurement: item.unit_price_measurement }}</p>
        {%- endif -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-line__discount">{%- render 'icon', name: 'tag', size: 14 -%}{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
        {%- endfor -%}
        {%- if backorder -%}<p class="cart-line__options">{{ 'products.stock.backorder' | t }}</p>{%- endif -%}
        {%- if settings.cart_show_weight and v.weight > 0 -%}<p class="cart-line__options">{{ v.weight | weight_with_unit: v.weight_unit }}</p>{%- endif -%}
      </div>
      <a class="icon-button cart-line__remove" href="{{ item.url_to_remove }}" data-line-remove aria-label="{{ 'cart.remove' | t: product: item.product.title | escape }}">{%- render 'icon', name: 'close', size: 18 -%}</a>
    </div>
    <div class="cart-line__foot">
      {%- if wholesale -%}
        {%- render 'quantity-input', id: input_id, name: 'updates[]', value: q, min: rule_min, max: cap, step: rule_inc, product_title: item.product.title, allow_zero: true, size: 'small' -%}
        {%- if rule_min > 1 or rule_inc > 1 -%}
          <span class="cart-line__hint">
            {%- if rule_min > 1 and rule_inc > 1 -%}{{ 'products.quantity_rules' | t: min: rule_min, increment: rule_inc }}
            {%- elsif rule_min > 1 -%}{{ 'wholesale.min' | t: count: rule_min }}
            {%- else -%}{{ 'wholesale.packs' | t: count: rule_inc }}{%- endif -%}
          </span>
        {%- endif -%}
      {%- else -%}
        {%- render 'quantity-input', id: input_id, name: 'updates[]', value: q, min: 1, max: cap, step: 1, product_title: item.product.title, allow_zero: true, size: 'small' -%}
      {%- endif -%}
      <span class="cart-line__total tabular">
        {%- if item.original_line_price > item.final_line_price and wholesale == false -%}<s class="price__compare">{{ item.original_line_price | money }}</s> {% endif -%}
        {{ item.final_line_price | money }}
      </span>
    </div>
    <p class="form-message form-message--error cart-line__error" role="alert" data-line-error {% unless line_error %}hidden{% endunless %}>{{ line_error }}</p>
  </div>
</li>
