{%- comment -%}
  Outputs "1" when a block with this audience setting should render for the current visitor.
  Params: audience ('all' | 'retail' | 'wholesale'). In the theme editor everything renders while
  Theme settings > Wholesale > Preview wholesale blocks in the editor is on.
  Usage: {%- capture visible -%}{% render 'audience-check', audience: block.settings.audience %}{%- endcapture -%}
{%- endcomment -%}
{%- liquid
  assign is_wholesale = false
  if customer and customer.b2b?
    assign is_wholesale = true
  endif
  if request.design_mode and settings.wholesale_editor_preview
    echo '1'
  elsif audience == 'retail' and is_wholesale == false
    echo '1'
  elsif audience == 'wholesale' and is_wholesale
    echo '1'
  elsif audience == 'all' or audience == blank
    echo '1'
  endif
-%}
