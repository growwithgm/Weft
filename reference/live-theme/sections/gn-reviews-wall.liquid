{%- comment -%}
  GN REVIEWS WALL - ibBan

  A self-contained reviews page section. It does NOT use a Judge.me widget:
  it reads the JSON that Judge.me already syncs into
      shop.metafields.judgeme.reviews_grid
  and renders the reviews itself, so we control the filtering and the look.

  WHAT IS IN THAT METAFIELD (checked 16 Sep 2026):
    average_rating, number_of_reviews  - the true store aggregate (4.74 / 1081)
    all_reviews.reviews                - newest page, 25 reviews
    product_reviews.reviews            - newest page, 25 reviews
    store_reviews.reviews              - all 17 store reviews
    *.media_only.reviews               - the reviews that carry photos/video
  Judge.me only writes the FIRST page into the metafield, so after merging and
  de-duplicating we have roughly 40 unique reviews to draw on, not all 1081.
  Judge.me refreshes it periodically, so the wall rotates on its own.

  FILTERING
  min_rating drops anything below it (default 4, so only 4 and 5 star show).
  min_length drops one-word and emoji-only reviews.
  The header still prints the REAL store aggregate, so the page never claims
  the filtered list is the whole picture - keep the heading worded as a
  selection, and keep the unfiltered Judge.me widget on the product pages.

  Palette is kept in step with snippets/gn-rating.liquid on purpose.
{%- endcomment -%}

{%- liquid
  assign jm = shop.metafields.judgeme.reviews_grid.value
  assign empty_arr = '' | split: ','

  assign min_rating = section.settings.min_rating | plus: 0
  assign min_length = section.settings.min_length | plus: 0
  assign max_reviews = section.settings.max_reviews | plus: 0
  assign first_batch = section.settings.first_batch | plus: 0

  assign base = routes.root_url | remove_last: '/'

  assign src_a = jm.all_reviews.media_only.reviews | default: empty_arr
  assign src_b = jm.product_reviews.media_only.reviews | default: empty_arr
  assign src_c = jm.all_reviews.reviews | default: empty_arr
  assign src_d = jm.product_reviews.reviews | default: empty_arr
  assign src_e = jm.store_reviews.reviews | default: empty_arr
  assign pool = src_a | concat: src_b | concat: src_c | concat: src_d | concat: src_e

  assign avg_raw = jm.average_rating | default: shop.metafields.judgeme.all_reviews_rating
  assign total_raw = jm.number_of_reviews | default: shop.metafields.judgeme.all_reviews_count
  assign avg_num = avg_raw | plus: 0.0
  assign avg_pct = avg_num | times: 20.0
-%}

{%- if pool.size > 0 -%}
  <section
    id="gnrw-{{ section.id }}"
    class="gnrw"
    style="--gnrw-cols:{{ section.settings.columns }};--gnrw-pt:{{ section.settings.padding_top }}px;--gnrw-pb:{{ section.settings.padding_bottom }}px;"
  >
    <div class="gnrw__inner">
      <header class="gnrw__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="gnrw__title">{{ section.settings.heading }}</h2>
        {%- endif -%}

        <div class="gnrw__score">
          <span class="gnrw__avg">{{ avg_raw }}</span>
          <span class="gnrw__stars" style="--gnrw-pct:{{ avg_pct }}%" aria-hidden="true">
            <span class="gnrw__bg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <span class="gnrw__fg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          </span>
          <span class="gnrw__total" data-gnrw-total="{{ total_raw }}">{{ total_raw }} {{ section.settings.total_label }}</span>
        </div>

        {%- if section.settings.subheading != blank -%}
          <p class="gnrw__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>

      <div class="gnrw__grid">
        {%- assign seen = '|' -%}
        {%- assign shown = 0 -%}
        {%- for r in pool -%}
          {%- if shown >= max_reviews -%}{%- break -%}{%- endif -%}
          {%- assign key = '|' | append: r.uuid | append: '|' -%}
          {%- unless seen contains key -%}
            {%- assign rt = r.rating | plus: 0 -%}
            {%- assign bodytxt = r.body | strip -%}
            {%- assign blen = bodytxt | size -%}
            {%- if rt >= min_rating and blen >= min_length -%}
              {%- assign seen = seen | append: r.uuid | append: '|' -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- assign pct = rt | times: 20 -%}
              <article class="gnrw__card{% if shown > first_batch %} is-hidden{% endif %}">
                <div class="gnrw__row">
                  <span class="gnrw__ava" aria-hidden="true">{{ r.reviewer_initial | default: 'i' }}</span>
                  <span class="gnrw__who">
                    <span class="gnrw__name">{{ r.reviewer_name | default: 'Anonymous' | escape }}</span>
                    {%- if r.verified_buyer -%}
                      <span class="gnrw__vb">{{ section.settings.verified_label }}</span>
                    {%- endif -%}
                  </span>
                  <time class="gnrw__date" datetime="{{ r.created_at }}">{{ r.created_at | date: '%b %Y' }}</time>
                </div>

                <span class="gnrw__stars gnrw__stars--sm" style="--gnrw-pct:{{ pct }}%" aria-label="{{ rt }}/5" role="img">
                  <span class="gnrw__bg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                  <span class="gnrw__fg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                </span>

                <p class="gnrw__body">{{ bodytxt | escape | newline_to_br }}</p>

                {%- if section.settings.show_photos and r.pictures_urls.size > 0 -%}
                  <div class="gnrw__pics">
                    {%- for pic in r.pictures_urls limit: 3 -%}
                      <button type="button" class="gnrw__pic" data-gnrw-full="{{ pic.huge | default: pic.original }}" aria-label="{{ section.settings.photo_label }}">
                        <img src="{{ pic.compact | default: pic.small }}" alt="" loading="lazy" width="76" height="76">
                      </button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if section.settings.show_product and r.is_shop_review != true and r.product_url != blank and r.product_url != '/' -%}
                  <a class="gnrw__prod" href="{{ base }}{{ r.product_url }}">
                    {%- if r.product_pictures_url != blank -%}
                      <img src="{{ r.product_pictures_url }}&width=140" alt="" loading="lazy" width="42" height="54">
                    {%- endif -%}
                    <span>{{ r.product_title }}</span>
                  </a>
                {%- endif -%}
              </article>
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>

      {%- if shown > first_batch -%}
        <div class="gnrw__more">
          <button type="button" class="gnrw__btn" data-gnrw-more>{{ section.settings.more_label }}</button>
        </div>
      {%- endif -%}

      {%- if section.settings.all_reviews_url != blank -%}
        <p class="gnrw__foot">
          <a href="{{ section.settings.all_reviews_url }}">{{ section.settings.all_reviews_label }}</a>
        </p>
      {%- endif -%}
    </div>

    <div class="gnrw__lb" data-gnrw-lb hidden>
      <button type="button" class="gnrw__lbx" data-gnrw-lbclose aria-label="Close">&times;</button>
      <img src="" alt="" data-gnrw-lbimg>
    </div>
  </section>

  <style>
    #gnrw-{{ section.id }}{
      --gnrw-star:#F5A623; --gnrw-empty:#D9D4CC;
      --gnrw-ink:#2E2A26; --gnrw-mute:#6E6862;
      --gnrw-line:#E7E2DA; --gnrw-card:#FFFFFF; --gnrw-soft:#FAF8F5;
      padding:var(--gnrw-pt,56px) 20px var(--gnrw-pb,56px);
      color:var(--gnrw-ink);
      font-variant-numeric:tabular-nums lining-nums;
    }
    #gnrw-{{ section.id }} .gnrw__inner{ max-width:1180px; margin:0 auto; }
    #gnrw-{{ section.id }} .gnrw__head{ text-align:center; margin:0 0 34px; }
    #gnrw-{{ section.id }} .gnrw__title{ margin:0 0 14px; font-size:clamp(26px,3.4vw,40px); line-height:1.15; font-weight:600; }
    #gnrw-{{ section.id }} .gnrw__score{ display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap; }
    #gnrw-{{ section.id }} .gnrw__avg{ font-size:22px; font-weight:600; }
    #gnrw-{{ section.id }} .gnrw__total{ color:var(--gnrw-mute); font-size:15px; }
    #gnrw-{{ section.id }} .gnrw__sub{ margin:14px auto 0; max-width:620px; color:var(--gnrw-mute); font-size:15px; line-height:1.6; }

    #gnrw-{{ section.id }} .gnrw__stars{ position:relative; display:inline-block; white-space:nowrap; letter-spacing:2px; font-size:19px; line-height:1; }
    #gnrw-{{ section.id }} .gnrw__stars--sm{ font-size:15px; letter-spacing:1px; }
    #gnrw-{{ section.id }} .gnrw__bg{ color:var(--gnrw-empty); }
    #gnrw-{{ section.id }} .gnrw__fg{ position:absolute; left:0; top:0; overflow:hidden; white-space:nowrap; letter-spacing:inherit; width:var(--gnrw-pct,0%); color:var(--gnrw-star); }

    #gnrw-{{ section.id }} .gnrw__grid{ columns:var(--gnrw-cols,3); column-gap:18px; }
    #gnrw-{{ section.id }} .gnrw__card{
      break-inside:avoid; -webkit-column-break-inside:avoid; page-break-inside:avoid;
      display:inline-block; width:100%; margin:0 0 18px;
      background:var(--gnrw-card); border:1px solid var(--gnrw-line); border-radius:14px;
      padding:18px 18px 16px;
    }
    #gnrw-{{ section.id }} .gnrw__card.is-hidden{ display:none; }

    #gnrw-{{ section.id }} .gnrw__row{ display:flex; align-items:center; gap:10px; margin:0 0 10px; }
    #gnrw-{{ section.id }} .gnrw__ava{
      flex:0 0 auto; width:34px; height:34px; border-radius:50%;
      background:var(--gnrw-soft); border:1px solid var(--gnrw-line);
      display:flex; align-items:center; justify-content:center;
      font-size:14px; font-weight:600; text-transform:uppercase; color:var(--gnrw-mute);
    }
    #gnrw-{{ section.id }} .gnrw__who{ min-width:0; display:flex; flex-direction:column; gap:2px; }
    #gnrw-{{ section.id }} .gnrw__name{ font-size:14px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    #gnrw-{{ section.id }} .gnrw__vb{ font-size:11.5px; color:#2F7A55; letter-spacing:.02em; }
    #gnrw-{{ section.id }} .gnrw__date{ margin-left:auto; font-size:12px; color:var(--gnrw-mute); white-space:nowrap; }

    #gnrw-{{ section.id }} .gnrw__body{ margin:9px 0 0; font-size:14.5px; line-height:1.62; color:var(--gnrw-ink); }

    #gnrw-{{ section.id }} .gnrw__pics{ display:flex; gap:8px; margin:12px 0 0; }
    #gnrw-{{ section.id }} .gnrw__pic{ appearance:none; border:0; padding:0; background:none; cursor:zoom-in; border-radius:8px; overflow:hidden; line-height:0; }
    #gnrw-{{ section.id }} .gnrw__pic img{ width:76px; height:76px; object-fit:cover; display:block; border-radius:8px; }

    #gnrw-{{ section.id }} .gnrw__prod{
      display:flex; align-items:center; gap:10px; margin:14px 0 0; padding:9px 0 0;
      border-top:1px solid var(--gnrw-line); text-decoration:none; color:var(--gnrw-mute);
    }
    #gnrw-{{ section.id }} .gnrw__prod img{ width:42px; height:54px; object-fit:cover; border-radius:6px; flex:0 0 auto; }
    #gnrw-{{ section.id }} .gnrw__prod span{ font-size:12.5px; line-height:1.4; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    #gnrw-{{ section.id }} .gnrw__prod:hover span{ color:var(--gnrw-ink); text-decoration:underline; text-underline-offset:2px; }

    #gnrw-{{ section.id }} .gnrw__more{ text-align:center; margin:26px 0 0; }
    #gnrw-{{ section.id }} .gnrw__btn{
      appearance:none; cursor:pointer; font:inherit; font-size:14px; font-weight:600;
      background:var(--gnrw-ink); color:#fff; border:0; border-radius:999px; padding:13px 30px;
    }
    #gnrw-{{ section.id }} .gnrw__btn:hover{ opacity:.85; }
    #gnrw-{{ section.id }} .gnrw__foot{ text-align:center; margin:20px 0 0; font-size:14px; }
    #gnrw-{{ section.id }} .gnrw__foot a{ color:var(--gnrw-mute); text-underline-offset:3px; }

    #gnrw-{{ section.id }} .gnrw__lb{
      position:fixed; inset:0; z-index:9999; background:rgba(24,21,18,.86);
      display:flex; align-items:center; justify-content:center; padding:24px;
    }
    #gnrw-{{ section.id }} .gnrw__lb[hidden]{ display:none; }
    #gnrw-{{ section.id }} .gnrw__lb img{ max-width:min(92vw,900px); max-height:88vh; border-radius:10px; }
    #gnrw-{{ section.id }} .gnrw__lbx{
      position:absolute; top:16px; right:20px; appearance:none; border:0; background:none;
      color:#fff; font-size:38px; line-height:1; cursor:pointer;
    }

    @media (max-width:1024px){ #gnrw-{{ section.id }} .gnrw__grid{ columns:2; } }
    @media (max-width:640px){
      #gnrw-{{ section.id }}{ padding-left:16px; padding-right:16px; }
      #gnrw-{{ section.id }} .gnrw__grid{ columns:1; }
      #gnrw-{{ section.id }} .gnrw__body{ font-size:14px; }
    }
  </style>

  <script>
    (function () {
      var root = document.getElementById('gnrw-{{ section.id }}');
      if (!root || root.dataset.gnrwWired) return;
      root.dataset.gnrwWired = '1';

      var total = root.querySelector('[data-gnrw-total]');
      if (total) {
        var n = parseInt(total.getAttribute('data-gnrw-total'), 10);
        if (!isNaN(n)) {
          try { total.firstChild.nodeValue = n.toLocaleString(document.documentElement.lang || 'en') + ' '; }
          catch (e) {}
        }
      }

      var moreBtn = root.querySelector('[data-gnrw-more]');
      if (moreBtn) {
        moreBtn.addEventListener('click', function () {
          var hid = root.querySelectorAll('.gnrw__card.is-hidden');
          for (var i = 0; i < hid.length; i++) hid[i].classList.remove('is-hidden');
          if (moreBtn.parentNode) moreBtn.parentNode.removeChild(moreBtn);
        });
      }

      var lb = root.querySelector('[data-gnrw-lb]');
      var lbImg = root.querySelector('[data-gnrw-lbimg]');
      function closeLb() {
        if (!lb) return;
        lb.hidden = true;
        if (lbImg) lbImg.src = '';
        document.documentElement.style.overflow = '';
      }
      root.addEventListener('click', function (e) {
        if (!e.target.closest) return;
        var hit = e.target.closest('[data-gnrw-full]');
        if (hit && lb && lbImg) {
          lbImg.src = hit.getAttribute('data-gnrw-full');
          lb.hidden = false;
          document.documentElement.style.overflow = 'hidden';
          return;
        }
        if (e.target.closest('[data-gnrw-lbclose]')) closeLb();
      });
      if (lb) lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLb(); });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "GN Reviews Wall",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 1,000+ women"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub-heading",
      "default": "A selection of our highest-rated reviews. Every piece is hand-embroidered in our Madrid workshop."
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Word after the review count",
      "default": "store reviews"
    },
    { "type": "header", "content": "Which reviews show" },
    {
      "type": "select",
      "id": "min_rating",
      "label": "Minimum star rating",
      "options": [
        { "value": "3", "label": "3 stars and up" },
        { "value": "4", "label": "4 stars and up" },
        { "value": "5", "label": "5 stars only" }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "min_length",
      "label": "Minimum review length",
      "info": "Hides one-word and emoji-only reviews. Characters.",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 10
    },
    {
      "type": "range",
      "id": "max_reviews",
      "label": "Maximum reviews on the page",
      "min": 6,
      "max": 60,
      "step": 2,
      "default": 60
    },
    {
      "type": "range",
      "id": "first_batch",
      "label": "Reviews shown before Load more",
      "min": 6,
      "max": 60,
      "step": 3,
      "default": 12
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Load more button text",
      "default": "Load more reviews"
    },
    { "type": "header", "content": "Card details" },
    {
      "type": "checkbox",
      "id": "show_photos",
      "label": "Show customer photos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product",
      "label": "Show the product each review is for",
      "default": true
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified buyer label",
      "default": "Verified buyer"
    },
    {
      "type": "text",
      "id": "photo_label",
      "label": "Photo button label (accessibility)",
      "default": "Open customer photo"
    },
    { "type": "header", "content": "Link to every review" },
    {
      "type": "url",
      "id": "all_reviews_url",
      "label": "See all reviews link",
      "info": "Optional. Point this at a page that shows every review, unfiltered."
    },
    {
      "type": "text",
      "id": "all_reviews_label",
      "label": "See all reviews text",
      "default": "See every review, including the critical ones"
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [{ "name": "GN Reviews Wall" }]
}
{% endschema %}
