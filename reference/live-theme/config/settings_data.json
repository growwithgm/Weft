rms.forEach(function(form) {\n      \/\/ Check if phone field already exists\n      if (form.querySelector('input[type=\"tel\"]')) {\n        return;\n      }\n      \n      \/\/ Find the email input field\n      const emailInput = form.querySelector('input[type=\"email\"]');\n      \n      if (emailInput) {\n        \/\/ Create wrapper for phone field\n        const phoneWrapper = document.createElement('div');\n        phoneWrapper.className = 'phone-input-wrapper';\n        \n        \/\/ Create phone input field\n        const phoneInput = document.createElement('input');\n        phoneInput.type = 'tel';\n        phoneInput.name = 'phone';\n        phoneInput.placeholder = 'Phone number (optional)';\n        phoneInput.setAttribute('aria-label', 'Phone number');\n        \n        \/\/ Add phone field after email input\n        phoneWrapper.appendChild(phoneInput);\n        emailInput.parentNode.insertAfter(phoneWrapper, emailInput);\n        \n        \/\/ Wrap the form to apply custom styling\n        if (!form.classList.contains('newsletter-form-wrapper')) {\n          form.classList.add('newsletter-form-wrapper');\n        }\n        \n        \/\/ Handle form submission to include phone data\n        form.addEventListener('submit', function(e) {\n          const phoneValue = phoneInput.value.trim();\n          \n          \/\/ If phone is provided, add it to form data\n          if (phoneValue) {\n            \/\/ Create hidden input for phone if it doesn't exist\n            let hiddenPhone = form.querySelector('input[name=\"phone\"][type=\"hidden\"]');\n            if (!hiddenPhone) {\n              hiddenPhone = document.createElement('input');\n              hiddenPhone.type = 'hidden';\n              hiddenPhone.name = 'phone';\n              form.appendChild(hiddenPhone);\n            }\n            hiddenPhone.value = phoneValue;\n          }\n        });\n      }\n    });\n  });\n<\/script>","heading_type_scale":"1.3","sections":{"main-password-hea