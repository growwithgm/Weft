  "text": {
    "blocks": {
      "group": {
        "settings": {
          "color_scheme": {
            "info": "Leave as the section scheme or pick one for a panel."
          }
        }
      },
      "heading": {
        "settings": {
          "tag": {
            "info": "Automatic uses H1 for the first section of a page and H2 elsewhere."
          }
        }
      }
    },
    "sections": {
      "custom_liquid": {
        "settings": {
          "custom_liquid": {
            "info": "Add app snippets or other code. Code here isn't checked by the theme."
          }
        }
      },
      "header": {
        "blocks": {
          "mega_menu": {
            "settings": {
              "link_images": {
                "info": "Collection images, or the first product image when a collection has none."
              },
              "menu_item": {
                "info": "Title of the top-level menu item that opens this mega menu."
              }
            }
          }
        }
      },
      "location_sheet": {
        "settings": {
          "shown_to_wholesale_buyers_whose_company_has_two_": {
            "content": "Shown to wholesale buyers whose company has two or more locations."
          }
        }
      },
      "main_404": {
        "settings": {
          "show_wholesale_line": {
            "info": "Helps wholesale buyers following an old link to a trade-only product."
          }
        }
      }
    },
    "settings_schema": {
      "advanced": {
        "settings": {
          "attention_messages": {
            "info": "Shown in the browser tab title while visitors look at another tab."
          }
        }
      },
      "animations": {
        "settings": {
          "reveal_on_scroll": {
            "info": "Always off for visitors who ask for reduced motion."
          }
        }
      },
      "cart": {
        "settings": {
          "cart_free_shipping_rules": {
            "info": "One line per currency, for example \"EUR: 69\". The bar only shows for currencies you list."
          }
        }
      },
      "colors": {
        "settings": {
          "accents": {
            "info": "Status colors are always shown together with a text label."
          }
        }
      },
      "currency_format": {
        "settings": {
          "currency_code_enable": {
            "info": "Useful when you sell in several currencies with the same symbol."
          }
        }
      },
      "custom_code_and_tracking": {
        "settings": {
          "code_runs_on_every_page_marketing_code_waits_for": {
            "content": "Code runs on every page. Marketing code waits for consent through Shopify's customer privacy settings."
