{
  "sections": {
    "collection-banner": {
      "type": "collection-banner",
      "disabled": true,
      "settings": {}
    },
    "countdown-timer": {
      "type": "countdown-timer",
      "blocks": {
        "countdown-heading-1": {
          "type": "heading",
          "settings": {
            "heading": "Flash Sale now on!",
            "size": "h2",
            "tag": "h1"
          }
        },
        "countdown-text-2": {
          "type": "text",
          "settings": {
            "text": "<p>Sale ends in:</p>",
            "style": "large"
          }
        },
        "countdown-countdown-3": {
          "type": "product-countdown",
          "settings": {
            "end_date": "",
            "end_time": "",
            "end_text": "",
            "hide_on_end": false
          }
        }
      },
      "block_order": [
        "countdown-heading-1",
        "countdown-text-2",
        "countdown-countdown-3"
      ],
      "settings": {
        "height": "fixed",
        "fixed_height_desktop": 560,
        "fixed_height_mobile": 360,
        "color_scheme": "scheme-4",
        "tint_opacity": 0
      }
    },
    "collection-products": {
      "type": "main-collection",
      "settings": {
        "products_per_page": 16,
        "columns": 4,
        "show_layout_toggle": true,
        "enable_filtering": true,
        "filters_open_lg": false,
        "stick_on_scroll": true,
        "show_filter_counts": true,
        "max_filter_options": 6,
        "enable_sorting": true,
        "columns_mobile": "2",
        "columns_tablet": "3",
        "columns_wide": 4
      }
    },
    "promo-strip": {
      "type": "promo-strip",
      "blocks": {
        "promo-strip-heading": {
          "type": "heading",
          "settings": {
            "heading": "New Season Sale!",
            "size": "h3"
          }
        },
        "promo-strip-text": {
          "type": "text",
          "settings": {
            "style": "body"
          }
        },
        "promo-strip-discount": {
          "type": "discount-code",
          "settings": {
            "discount_code": "NEWSEASON10"
          }
        }
      },
      "block_order": [
        "promo-strip-heading",
        "promo-strip-text",
        "promo-strip-discount"
      ],
      "settings": {
        "height": "normal",
        "color_scheme": "scheme-6",
        "dividers": false
      }
    },
    "collection-list": {
      "type": "collection-list",
      "blocks": {
        "collection-list-collection-1": {
          "type": "_collection-tile",
          "settings": {}
        },
        "collection-list-collection-2": {
          "type": "_collection-tile",
          "settings": {}
        },
        "collection-list-collection-3": {
          "type": "_collection-tile",
          "settings": {}
        },
        "collection-list-collection-4": {
          "type": "_collection-tile",
          "settings": {}
        },
        "collection-list-collection-5": {
          "type": "_collection-tile",
          "settings": {}
        },
        "collection-list-collection-6": {
          "type": "_collection-tile",
          "settings": {}
        },
        "collection-list-collection-7": {
          "type": "_collection-tile",
          "settings": {}
        },
        "collection-list-collection-8": {
          "type": "_collection-tile",
          "settings": {}
        }
      },
      "block_order": [
        "collection-list-collection-1",
        "collection-list-collection-2",
        "collection-list-collection-3",
        "collection-list-collection-4",
        "collection-list-collection-5",
        "collection-list-collection-6",
        "collection-list-collection-7",
        "collection-list-collection-8"
      ],
      "settings": {
        "title": "Our collections",
        "heading_align": "start",
        "layout": "carousel",
        "use_product_image": true
      }
    }
