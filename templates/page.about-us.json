    "custom_liquid_DABea4": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>About IBban — Handmade Since 1982</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Tenor+Sans&family=Jost:wght@200;300;400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  :root {\n    --black:      #0a0a0a;\n    --dark:       #111111;\n    --dark-mid:   #1a1a1a;\n    --mid-dark:   #2a2a2a;\n    --mid:        #555555;\n    --light-mid:  #888888;\n    --silver:     #bbbbbb;\n    --off-white:  #e8e8e8;\n    --white:      #f5f5f5;\n    --pure-white: #ffffff;\n  }\n\n  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\n  html { scroll-behavior: smooth; }\n\n  body {\n    background: var(--pure-white);\n    color: var(--black);\n    font-family: 'Jost', sans-serif;\n    font-weight: 300;\n    overflow-x: hidden;\n  }\n\n  /* ── HERO ────────────────────────────────────── */\n  .hero {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    min-height: 90vh;\n  }\n\n  .hero-left {\n    background: var(--black);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 6rem 5rem;\n    position: relative;\n    overflow: hidden;\n  }\n  .hero-left::before {\n    content: '';\n    position: absolute; inset: 0;\n    background: radial-gradient(ellipse at 20% 80%, rgba(255,255,255,0.04) 0%, transparent 60%),\n                radial-gradient(ellipse at 80% 20%, rgba(255,255,255,0.03) 0%, transparent 50%);\n    pointer-events: none;\n  }\n  .hero-left-content { position: relative; z-index: 1; }\n\n  .brand-logo {\n    display: block;\n    width: 155px;\n    margin-bottom: 3rem;\n    filter: brightness(0) invert(1);\n    opacity: 0.9;\n  }\n\n  .hero-eyebrow {\n    font-family: 'Tenor Sans', sans-serif;\n    font-size: 0.66rem;\n    letter-spacing: 0.4em;\n    text-transform: uppercase;\n    color: var(--silver);\n    margin-bottom: 1.5rem;\n    display: flex;\n    align-items: center;\n    gap: 1rem;\n  }\n  .hero-eyebrow::before {\n    content: '';\n    width: 35px; height: 1px;\n    background: var(--silver);\n  }\n\n  .hero-title {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: clamp(3.2rem, 5.5vw, 6rem);\n    font-weight: 300;\n    line-height: 0.95;\n    color: var(--pure-white);\n    margin-bottom: 2rem;\n    letter-spacing: -0.01em;\n  }\n  .hero-title em {\n    font-style: italic;\n    color: var(--silver);\n    display: block;\n  }\n\n  .hero-desc {\n    font-size: 17px !important;\n    line-height: 1.95 !important;\n    color: rgba(255,255,255,0.45);\n    max-width: 400px;\n    margin-bottom: 3rem;\n  }\n\n  .hero-divider {\n    width: 50px; height: 1px;\n    background: rgba(255,255,255,0.15);\n    margin-bottom: 2.5rem;\n  }\n\n  .hero-meta { display: flex; gap: 3rem; }\n  .hero-meta-num {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 2.4rem; font-weight: 300;\n    color: var(--pure-white); line-height: 1;\n  }\n  .hero-meta-label {\n    font-family: 'Tenor Sans', sans-serif;\n    font-size: 11px !important; letter-spacing: 0.2em; text-transform: uppercase;\n    color: var(--light-mid); margin-top: 0.3rem;\n  }\n\n  .hero-year-bg {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 11rem; font-weight: 300;\n    color: rgba(255,255,255,0.025);\n    position: absolute; bottom: 1.5rem; right: 1rem;\n    line-height: 1; pointer-events: none; letter-spacing: -0.03em;\n  }\n\n  .hero-right {\n    position: relative; overflow: hidden;\n    background: var(--dark);\n  }\n  .hero-right img {\n    width: 100%; height: 100%;\n    object-fit: cover; object-position: top center;\n    filter: grayscale(100%) contrast(1.05);\n    transition: transform 8s ease, filter 0.6s ease;\n    display: block;\n  }\n  .hero-right:hover img { transform: scale(1.04); filter: grayscale(100%) contrast(1.12); }\n\n  .hero-right-label {\n    position: absolute; top: 2.5rem; right: 2.5rem;\n    writing-mode: vertical-rl; transform: rotate(180deg);\n    font-family: 'Tenor Sans', sans-serif;\n    font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase;\n    color: rgba(255,255,255,0.3);\n  }\n\n  .hero-right-bar {\n    position: absolute; bottom: 0; left: 0; right: 0;\n    padding: 2rem 2.5rem;\n    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 100%);\n  }\n  .hero-right-bar-text {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 18px !important; font-style: italic;\n    color: rgba(255,255,255,0.65); font-weight: 300;\n  }\n\n  /* ── MARQUEE ─────────────────────────────────── */\n  .marquee-wrap {\n    background: var(--black);\n    border-top: 1px solid rgba(255,255,255,0.06);\n    border-bottom: 1px solid rgba(255,255,255,0.06);\n    padding: 1rem 0; overflow: hidden;\n  }\n  .marquee-track {\n    display: flex;\n    animation: marquee 20s linear infinite;\n    white-space: nowrap;\n  }\n  .marquee-item {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 18px !important; font-style: italic;\n    color: rgba(255,255,255,0.4); letter-spacing: 0.08em;\n    padding: 0 3rem;\n    display: flex; align-items: center; gap: 3rem;\n  }\n  .marquee-item::after { content: '◆'; font-style: normal; font-size: 0.4rem; opacity: 0.3; }\n  @keyframes marquee {\n    from { transform: translateX(0); }\n    to   { transform: translateX(-50%); }\n  }\n\n  /* ── STORY ───────────────────────────────────── */\n  .story {\n    display: grid; grid-template-columns: 1fr 1fr;\n    min-height: 80vh;\n  }\n  .story-img-wrap {\n    position: relative; overflow: hidden;\n    background: var(--dark-mid);\n    min-height: 500px;\n  }\n  .story-img-bg {\n    width: 100%; height: 100%;\n    background: linear-gradient(160deg, #111 0%, #1e1e1e 50%, #0f0f0f 100%);\n    position: absolute; inset: 0;\n  }\n  .story-label {\n    position: absolute; bottom: 3rem; left: 3rem;\n    font-family: 'Tenor Sans', sans-serif;\n    font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase;\n    color: rgba(255,255,255,0.25);\n    writing-mode: vertical-rl; transform: rotate(180deg);\n  }\n  .story-content {\n    background: var(--pure-white);\n    padding: 7rem 5.5rem;\n    display: flex; flex-direction: column; justify-content: center;\n    position: relative; overflow: hidden;\n  }\n  .story-content::before {\n    content: '\"';\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 22rem; font-weight: 300;\n    color: rgba(0,0,0,0.03);\n    position: absolute; top: -3rem; left: 1.5rem;\n    line-height: 1; pointer-events: none;\n  }\n\n  .section-tag {\n    font-family: 'Tenor Sans', sans-serif;\n    font-size: 0.62rem; letter-spacing: 0.35em; text-transform: uppercase;\n    color: var(--mid); margin-bottom: 1.5rem;\n    display: flex; align-items: center; gap: 1rem;\n  }\n  .section-tag::after { content: ''; flex: 0 0 28px; height: 1px; background: var(--mid); }\n\n  .section-heading {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: clamp(2rem, 3.2vw, 3.3rem) !important; font-weight: 300;\n    line-height: 1.1; color: var(--black); margin-bottom: 2rem;\n  }\n  .section-heading em { font-style: italic; color: var(--mid); }\n\n  .section-body {\n    font-size: 17px !important; line-height: 2 !important;\n    color: var(--mid); max-width: 480px; margin-bottom: 1.8rem;\n  }\n\n  blockquote {\n    border-left: 1.5px solid var(--black);\n    padding: 0.8rem 0 0.8rem 1.8rem; margin: 2rem 0;\n  }\n  blockquote p {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 20px !important; font-style: italic; font-weight: 300;\n    line-height: 1.55; color: var(--black);\n  }\n\n  /* ── VALUES ──────────────────────────────────── */\n  .values { padding: 8rem 6rem; background: var(--black); }\n  .values-header { text-align: center; margin-bottom: 5rem; }\n  .values-header .section-tag { justify-content: center; color: var(--light-mid); }\n  .values-header .section-tag::after { display: none; }\n  .values-header .section-heading { font-size: clamp(2.2rem, 3.5vw, 3.8rem); color: var(--pure-white); }\n  .values-header .section-heading em { color: var(--silver); }\n\n  .values-grid {\n    display: grid; grid-template-columns: repeat(3, 1fr);\n    gap: 1.5px; background: rgba(255,255,255,0.06);\n  }\n  .value-card {\n    background: var(--black); padding: 3rem 2.5rem;\n    border: 1px solid rgba(255,255,255,0.06);\n    transition: background 0.4s, border-color 0.4s;\n    position: relative; overflow: hidden;\n  }\n  .value-card::after {\n    content: '';\n    position: absolute; bottom: 0; left: 0; right: 0; height: 2px;\n    background: var(--pure-white);\n    transform: scaleX(0); transition: transform 0.4s ease;\n  }\n  .value-card:hover { background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.12); }\n  .value-card:hover::after { transform: scaleX(1); }\n  .value-num {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 4.5rem; font-weight: 300;\n    color: rgba(255,255,255,0.06); line-height: 1; margin-bottom: 1.5rem;\n  }\n  .value-title {\n    font-family: 'Tenor Sans', sans-serif;\n    font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase;\n    color: var(--silver); margin-bottom: 1.2rem;\n  }\n  .value-text { font-size: 16px !important; line-height: 1.9 !important; color: rgba(255,255,255,0.4); }\n\n  /* ── FOUNDER ─────────────────────────────────── */\n  .founder {\n    display: grid; grid-template-columns: 1fr 1fr;\n    min-height: 85vh;\n  }\n  .founder-content {\n    background: var(--off-white);\n    padding: 7rem 5.5rem;\n    display: flex; flex-direction: column; justify-content: center;\n  }\n  .founder-img-wrap {\n    position: relative; overflow: hidden;\n    background: var(--dark);\n  }\n  .founder-img-wrap img {\n    width: 100%; height: 100%;\n    object-fit: cover; object-position: top center;\n    filter: grayscale(100%) contrast(1.08);\n    transition: transform 0.7s ease, filter 0.5s ease;\n    display: block;\n  }\n  .founder-img-wrap:hover img { transform: scale(1.04); filter: grayscale(90%) contrast(1.1); }\n  .founder-badge {\n    position: absolute; bottom: 3rem; right: 3rem;\n    width: 110px; height: 110px;\n    background: var(--black); border: 1px solid rgba(255,255,255,0.15);\n    border-radius: 50%;\n    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;\n  }\n  .founder-badge-year {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 1.7rem; font-weight: 300; color: var(--pure-white); line-height: 1;\n  }\n  .founder-badge-text {\n    font-family: 'Tenor Sans', sans-serif;\n    font-size: 0.52rem; letter-spacing: 0.15em; text-transform: uppercase;\n    color: var(--light-mid); margin-top: 0.2rem;\n  }\n  .founder-name {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 1.05rem; font-weight: 300; font-style: italic;\n    color: var(--black); margin-top: 2.5rem;\n  }\n  .founder-role {\n    font-family: 'Tenor Sans', sans-serif;\n    font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase;\n    color: var(--light-mid); margin-top: 0.4rem;\n  }\n\n  /* ── PILLARS ─────────────────────────────────── */\n  .pillars {\n    display: grid; grid-template-columns: repeat(4, 1fr);\n    border-top: 1px solid rgba(0,0,0,0.1);\n    border-bottom: 1px solid rgba(0,0,0,0.1);\n    background: var(--pure-white);\n  }\n  .pillar {\n    padding: 3.5rem 2.5rem; text-align: center;\n    border-right: 1px solid rgba(0,0,0,0.08);\n    transition: background 0.3s; position: relative;\n  }\n  .pillar:last-child { border-right: none; }\n  .pillar::after {\n    content: '';\n    position: absolute; top: 0; left: 50%; right: 50%; height: 2px;\n    background: var(--black);\n    transition: left 0.4s ease, right 0.4s ease;\n  }\n  .pillar:hover { background: var(--off-white); }\n  .pillar:hover::after { left: 0; right: 0; }\n  .pillar-num {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 2.5rem; font-weight: 300;\n    color: rgba(0,0,0,0.07); line-height: 1; margin-bottom: 1rem;\n  }\n  .pillar-title {\n    font-family: 'Tenor Sans', sans-serif;\n    font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase;\n    color: var(--black); margin-bottom: 0.8rem;\n  }\n  .pillar-text { font-size: 16px !important; line-height: 1.75 !important; color: var(--light-mid); }\n\n  /* ── BIG QUOTE ───────────────────────────────── */\n  .big-quote {\n    padding: 10rem 6rem;\n    background: var(--black); text-align: center;\n    position: relative; overflow: hidden;\n  }\n  .big-quote::before {\n    content: 'ibBan';\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 20vw; font-weight: 300; font-style: italic;\n    color: rgba(255,255,255,0.02);\n    position: absolute; top: 50%; left: 50%;\n    transform: translate(-50%, -50%);\n    white-space: nowrap; pointer-events: none; letter-spacing: -0.03em;\n  }\n  .big-quote-inner { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; }\n  .quote-logo {\n    display: block; width: 100px; margin: 0 auto 3rem;\n    filter: brightness(0) invert(1); opacity: 0.4;\n  }\n  .big-quote-text {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: clamp(1.7rem, 3.2vw, 3rem); font-weight: 300; font-style: italic;\n    line-height: 1.5; color: var(--pure-white); margin-bottom: 2.5rem;\n  }\n  .big-quote-attr {\n    font-family: 'Tenor Sans', sans-serif;\n    font-size: 0.65rem; letter-spacing: 0.3em; text-transform: uppercase;\n    color: var(--light-mid);\n    display: flex; align-items: center; justify-content: center; gap: 1.5rem;\n  }\n  .big-quote-attr::before, .big-quote-attr::after {\n    content: ''; width: 45px; height: 1px; background: rgba(255,255,255,0.15);\n  }\n\n  /* ── REVEAL ANIMATIONS ───────────────────────── */\n  .reveal {\n    opacity: 1; transform: translateY(0);\n    transition: opacity 0.85s cubic-bezier(0.16,1,0.3,1), transform 0.85s cubic-bezier(0.16,1,0.3,1);\n  }\n  .reveal.animate-on-scroll {\n    opacity: 0; transform: translateY(35px);\n  }\n  .reveal.animate-on-scroll.visible { opacity: 1; transform: translateY(0); }\n\n  .reveal-left {\n    opacity: 1; transform: translateX(0);\n    transition: opacity 0.9s cubic-bezier(0.16,1,0.3,1), transform 0.9s cubic-bezier(0.16,1,0.3,1);\n  }\n  .reveal-left.animate-on-scroll {\n    opacity: 0; transform: translateX(-35px);\n  }\n  .reveal-left.animate-on-scroll.visible { opacity: 1; transform: translateX(0); }\n\n  .reveal-right {\n    opacity: 1; transform: translateX(0);\n    transition: opacity 0.9s cubic-bezier(0.16,1,0.3,1), transform 0.9s cubic-bezier(0.16,1,0.3,1);\n  }\n  .reveal-right.animate-on-scroll {\n    opacity: 0; transform: translateX(35px);\n  }\n  .reveal-right.animate-on-scroll.visible { opacity: 1; transform: translateX(0); }\n\n  /* ── RESPONSIVE ──────────────────────────────── */\n  @media (max-width: 1024px) {\n    .hero, .story, .founder { grid-template-columns: 1fr; }\n    .hero-right { min-height: 60vh; order: -1; }\n    .hero-left { padding: 5rem 3rem; }\n    .story-img-wrap { min-height: 45vh; }\n    .story-content { padding: 4.5rem 3rem; }\n    .founder-img-wrap { min-height: 60vh; order: -1; }\n    .founder-content { padding: 4.5rem 3rem; }\n    .values { padding: 5rem 3rem; }\n    .values-grid { grid-template-columns: 1fr 1fr; }\n    .pillars { grid-template-columns: 1fr 1fr; }\n    .pillar { border-bottom: 1px solid rgba(0,0,0,0.08); }\n    .big-quote { padding: 7rem 3rem; }\n  }\n\n  @media (max-width: 640px) {\n    .hero-left { padding: 4rem 2rem; }\n    .values { padding: 4rem 1.5rem; }\n    .values-grid { grid-template-columns: 1fr; }\n    .pillars { grid-template-columns: 1fr; }\n    .big-quote { padding: 5rem 2rem; }\n    .story-content, .founder-content { padding: 3.5rem 1.8rem; }\n    .story-content::before { font-size: 13rem; }\n    .hero-meta { gap: 2rem; }\n    .brand-logo { width: 120px; }\n  }\n</style>\n</head>\n<body>\n\n<!-- ── HERO ─────────────────────────────────────────── -->\n<section class=\"hero\">\n  <div class=\"hero-left\">\n    <div class=\"hero-left-content reveal-left\">\n      <img\n        src=\"https://ibban-com.myshopify.com/cdn/shop/files/ibban_logo.png?v=1763981154&width=320\"\n        alt=\"ibBan Logo\"\n        class=\"brand-logo\"\n      >\n      <p class=\"hero-eyebrow\">Handmade Since 1982</p>\n      <h1 class=\"hero-title\">\n        The Art of<br>\n        <em>Being Her</em>\n      </h1>\n      <p class=\"hero-desc\">\n        A fashion legacy born from a 22-year-old's dream — to dress the woman who travels the world,\n        carries stories in her wardrobe, and refuses to choose between beauty and freedom.\n      </p>\n      <div class=\"hero-divider\"></div>\n      <div class=\"hero-meta\">\n        <div class=\"hero-meta-item\">\n          <div class=\"hero-meta-num\">40+</div>\n          <div class=\"hero-meta-label\">Years of Craft</div>\n        </div>\n        <div class=\"hero-meta-item\">\n          <div class=\"hero-meta-num\">100%</div>\n          <div class=\"hero-meta-label\">Handmade</div>\n        </div>\n        <div class=\"hero-meta-item\">\n          <div class=\"hero-meta-num\">∞</div>\n          <div class=\"hero-meta-label\">Wearable Art</div>\n        </div>\n      </div>\n    </div>\n    <div class=\"hero-year-bg\">1982</div>\n  </div>\n\n  <div class=\"hero-right\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/1_7ce33d36-b083-4626-9bfa-5caebd7703cc.jpg?v=1776265866\"\n      alt=\"ibBan Founder Mohammad Bawri\"\n    >\n    <span class=\"hero-right-label\">Mohammad Bawri · Founder</span>\n    <div class=\"hero-right-bar\">\n      <span class=\"hero-right-bar-text\">Founder &amp; Creative Director</span>\n    </div>\n  </div>\n</section>\n\n<!-- ── MARQUEE ────────────────────────────────────────── -->\n<div class=\"marquee-wrap\">\n  <div class=\"marquee-track\">\n    <span class=\"marquee-item\">Handmade in India</span>\n    <span class=\"marquee-item\">Artisan Craftsmanship</span>\n    <span class=\"marquee-item\">Global Bohème</span>\n    <span class=\"marquee-item\">Since 1982</span>\n    <span class=\"marquee-item\">Natural Materials</span>\n    <span class=\"marquee-item\">Timeless Elegance</span>\n    <span class=\"marquee-item\">Handmade in India</span>\n    <span class=\"marquee-item\">Artisan Craftsmanship</span>\n    <span class=\"marquee-item\">Global Bohème</span>\n    <span class=\"marquee-item\">Since 1982</span>\n    <span class=\"marquee-item\">Natural Materials</span>\n    <span class=\"marquee-item\">Timeless Elegance</span>\n  </div>\n</div>\n\n<!-- ── STORY ──────────────────────────────────────────── -->\n<section class=\"story\" id=\"story\">\n  <div class=\"story-img-wrap reveal-left\">\n    <div class=\"story-img-bg\"></div>\n    <span class=\"story-label\">Our Heritage · Est. 1982</span>\n  </div>\n  <div class=\"story-content reveal-right\">\n    <p class=\"section-tag\">Our Beginning</p>\n    <h2 class=\"section-heading\">A Dream Stitched<br><em>By Hand</em></h2>\n    <p class=\"section-body\">\n      IBban was founded in 1982 by Mohammad Bawri — a 22-year-old with a passion for fashion and\n      an unstoppable vision. Studying fashion design alongside political science, he set out to\n      build something the world had never quite seen: an Indian-born brand that would dress women\n      across every corner of the globe.\n    </p>\n    <blockquote>\n      <p>\"I want to create a wardrobe that looks like the best memories of a world traveler.\"</p>\n    </blockquote>\n    <p class=\"section-body\">\n      From the very beginning, the philosophy was clear — cultivate a personal aesthetic that sits\n      at the beautiful intersection of artistry and wearability. Natural materials. Timeless\n      silhouettes. Handcrafted with the care that only comes from loving what you make.\n    </p>\n  </div>\n</section>\n\n<!-- ── VALUES ─────────────────────────────────────────── -->\n<section class=\"values\">\n  <div class=\"values-header reveal\">\n    <p class=\"section-tag\">What We Stand For</p>\n    <h2 class=\"section-heading\">Crafted with <em>Purpose</em></h2>\n  </div>\n  <div class=\"values-grid\">\n    <div class=\"value-card reveal\">\n      <div class=\"value-num\">01</div>\n      <div class=\"value-title\">Artisan Craft</div>\n      <p class=\"value-text\">Every piece is born in our India atelier, shaped by hands that understand cloth as more than material — it is memory, culture, and care woven into form.</p>\n    </div>\n    <div class=\"value-card reveal\" style=\"transition-delay:0.15s\">\n      <div class=\"value-num\">02</div>\n      <div class=\"value-title\">Boho Elegance</div>\n      <p class=\"value-text\">Our aesthetic fuses global wanderlust with refined elegance. We draw from nature, art, travel, and the archives of the world's most soulful wardrobes.</p>\n    </div>\n    <div class=\"value-card reveal\" style=\"transition-delay:0.3s\">\n      <div class=\"value-num\">03</div>\n      <div class=\"value-title\">The IBban Woman</div>\n      <p class=\"value-text\">She loves freedom, dares greatly, works hard, and refuses to compromise on beauty. She is everything ibBan was made for — and she has always existed.</p>\n    </div>\n  </div>\n</section>\n\n<!-- ── FOUNDER ─────────────────────────────────────────── -->\n<section class=\"founder\">\n  <div class=\"founder-content reveal-left\">\n    <p class=\"section-tag\">The Founder</p>\n    <h2 class=\"section-heading\">Vision, Craft<br><em>&amp; Passion</em></h2>\n    <p class=\"section-body\">\n      At IBban, we are a family united by design. Mohammad oversees the India factory, the\n      collections, the marketing, and the image — every touchpoint of our brand is shaped by the\n      same hands that started it in 1982.\n    </p>\n    <p class=\"section-body\">\n      What he loves most about being an entrepreneur? That every day brings entirely different\n      challenges. Inspiration comes from the street, from books, from exhibitions — from everywhere\n      life has something beautiful to say.\n    </p>\n    <blockquote>\n      <p>\"IBban has grown in maturity but has never been more beautiful.\"</p>\n    </blockquote>\n    <p class=\"founder-name\">Mohammad Bawri</p>\n    <p class=\"founder-role\">Founder &amp; Creative Director · ibBan</p>\n  </div>\n\n  <div class=\"founder-img-wrap reveal-right\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0938/4525/8613/files/1_7ce33d36-b083-4626-9bfa-5caebd7703cc.jpg?v=1776265866\"\n      alt=\"Mohammad Bawri - ibBan Founder\"\n    >\n    <div class=\"founder-badge\">\n      <div class=\"founder-badge-year\">1982</div>\n      <div class=\"founder-badge-text\">Founded</div>\n    </div>\n  </div>\n</section>\n\n<!-- ── PILLARS ─────────────────────────────────────────── -->\n<div class=\"pillars\">\n  <div class=\"pillar reveal\">\n    <div class=\"pillar-num\">01</div>\n    <div class=\"pillar-title\">Quality Assured</div>\n    <p class=\"pillar-text\">High-quality fabrics and craftsmanship, every single time.</p>\n  </div>\n  <div class=\"pillar reveal\" style=\"transition-delay:0.1s\">\n    <div class=\"pillar-num\">02</div>\n    <div class=\"pillar-title\">Secure Payment</div>\n    <p class=\"pillar-text\">Safe, seamless, and worry-free checkout experience.</p>\n  </div>\n  <div class=\"pillar reveal\" style=\"transition-delay:0.2s\">\n    <div class=\"pillar-num\">03</div>\n    <div class=\"pillar-title\">Customer Service</div>\n    <p class=\"pillar-text\">Real people ready to help — reach us anytime.</p>\n  </div>\n  <div class=\"pillar reveal\" style=\"transition-delay:0.3s\">\n    <div class=\"pillar-num\">04</div>\n    <div class=\"pillar-title\">14 Days Returns</div>\n    <p class=\"pillar-text\">Hassle-free returns within 14 days of your delivery.</p>\n  </div>\n</div>\n\n<!-- ── BIG QUOTE ───────────────────────────────────────── -->\n<section class=\"big-quote\">\n  <div class=\"big-quote-inner\">\n    <img\n      src=\"https://ibban-com.myshopify.com/cdn/shop/files/ibban_logo.png?v=1763981154&width=320\"\n      alt=\"ibBan\" class=\"quote-logo reveal\"\n    >\n    <p class=\"big-quote-text reveal\">\n      \"The ibBan woman has never followed the fashion — she has always been it.\"\n    </p>\n    <p class=\"big-quote-attr reveal\" style=\"transition-delay:0.2s\">\n      ibBan · Handmade Since 1982\n    </p>\n  </div>\n</section>\n\n<script>\n  // Hero elements — always visible immediately\n  document.querySelectorAll('.hero .reveal-left, .hero .reveal-right, .hero .reveal')\n    .forEach(el => el.classList.add('visible'));\n\n  // Non-hero elements — animate on scroll\n  const scrollEls = document.querySelectorAll(\n    'section:not(.hero) .reveal, section:not(.hero) .reveal-left, section:not(.hero) .reveal-right, .values .reveal, .pillars .reveal, .big-quote .reveal'\n  );\n  scrollEls.forEach(el => el.classList.add('animate-on-scroll'));\n\n  const observer = new IntersectionObserver((entries) => {\n    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });\n  }, { threshold: 0.1 });\n  scrollEls.forEach(el => observer.observe(el));\n</script>\n</body>\n</html>",
        "spacing": "normal",
        "full_width": true
      }
    }
  },
