{
  "sections": {
    "hero": {
      "type": "image-banner",
      "blocks": {
        "heading": { "type": "heading", "settings": { "heading": "New season, made to last", "size": "h0", "tag": "h2" } },
        "text": { "type": "text", "settings": { "text": "<p>Discover the latest pieces from our collection.</p>", "style": "large" } },
        "button": { "type": "button", "settings": { "label": "Shop new in", "link": "shopify://collections/all", "style": "primary" } }
      },
      "block_order": ["heading", "text", "button"],
      "settings": { "height": "large", "overlay_position": "middle-start", "text_align": "start", "tint_opacity": 25 }
    },
    "marquee": {
      "type": "scrolling-banner",
      "blocks": {
        "t1": { "type": "_marquee-item", "settings": { "type": "text", "text": "New collection" } },
        "i1": { "type": "_marquee-item", "settings": { "type": "icon", "icon": "sparkle" } },
        "t2": { "type": "_marquee-item", "settings": { "type": "text", "text": "Made in small batches" } },
        "i2": { "type": "_marquee-item", "settings": { "type": "icon", "icon": "sparkle" } },
        "t3": { "type": "_marquee-item", "settings": { "type": "text", "text": "Free returns within 30 days" } },
        "i3": { "type": "_marquee-item", "settings": { "type": "icon", "icon": "sparkle" } }
      },
      "block_order": ["t1", "i1", "t2", "i2", "t3", "i3"],
      "settings": { "height": "compact", "color_scheme": "scheme-3" }
    },
    "new_in": {
      "type": "featured-collection",
      "settings": { "title": "New in", "collection": "all", "products_to_show": 8, "layout": "carousel", "columns": 4 }
    },
    "categories": {
      "type": "collection-list",
      "blocks": {
        "c1": { "type": "_collection-tile", "settings": {} },
        "c2": { "type": "_collection-tile", "settings": {} },
        "c3": { "type": "_collection-tile", "settings": {} },
        "c4": { "type": "_collection-tile", "settings": {} }
      },
      "block_order": ["c1", "c2", "c3", "c4"],
      "settings": { "title": "Shop by category", "columns": 4, "columns_mobile": "2" }
    },
    "story": {
      "type": "media-with-text",
      "blocks": {
        "eyebrow": { "type": "text", "settings": { "text": "<p>Our story</p>", "style": "subheading" } },
        "heading": { "type": "heading", "settings": { "heading": "Made to be worn for years", "size": "h2" } },
        "text": { "type": "text", "settings": { "text": "<p>Use this section to introduce your brand, how your products are made and what makes them different.</p>" } },
        "button": { "type": "button", "settings": { "label": "About us", "style": "secondary" } }
      },
      "block_order": ["eyebrow", "heading", "text", "button"],
      "settings": { "layout": "media-start", "media_width": 50 }
    },
    "bestsellers": {
      "type": "featured-collection",
      "settings": { "title": "Best sellers", "collection": "all", "products_to_show": 4, "layout": "grid", "columns": 4 }
    },
    "reviews": {
      "type": "testimonials",
      "blocks": {
        "r1": { "type": "_testimonial", "settings": {} },
        "r2": { "type": "_testimonial", "settings": {} },
        "r3": { "type": "_testimonial", "settings": {} }
      },
      "block_order": ["r1", "r2", "r3"],
      "settings": { "heading": "What our customers say" }
    },
    "trust": {
      "type": "icons-with-text",
      "blocks": {
        "i1": { "type": "_icon-item", "settings": { "icon": "truck", "heading": "Free delivery", "text": "<p>On orders over a set amount.</p>" } },
        "i2": { "type": "_icon-item", "settings": { "icon": "return", "heading": "Easy returns", "text": "<p>Change your mind within 30 days.</p>" } },
        "i3": { "type": "_icon-item", "settings": { "icon": "lock", "heading": "Secure payment", "text": "<p>Pay safely with the methods you trust.</p>" } },
        "i4": { "type": "_icon-item", "settings": { "icon": "chat", "heading": "Here to help", "text": "<p>Message us any time.</p>" } }
      },
      "block_order": ["i1", "i2", "i3", "i4"],
      "settings": { "columns": 4, "columns_mobile": "2", "density": "compact", "color_scheme": "scheme-2" }
    },
    "signup": {
      "type": "newsletter",
      "blocks": {
        "heading": { "type": "heading", "settings": { "heading": "Subscribe to our emails", "size": "h2" } },
        "text": { "type": "text", "settings": { "text": "<p>Be the first to know about new collections and exclusive offers.</p>" } },
        "form": { "type": "email-signup", "settings": {} }
      },
      "block_order": ["heading", "text", "form"],
      "settings": {}
    }
  },
  "order": ["hero", "marquee", "new_in", "categories", "story", "bestsellers", "reviews", "trust", "signup"]
}
